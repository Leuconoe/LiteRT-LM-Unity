+              probe_encode_inputs[input_index].TensorType();
+          if (!encode_tensor_type_or.HasValue()) {
+            continue;
+          }
+          const auto dims = encode_tensor_type_or.Value().Layout().Dimensions();
+          if (dims.size() == 3 && dims[2] == 3000 && dims[1] > 0) {
+            cache_entry->num_mels = static_cast<int>(dims[1]);
+            cache_entry->encode_feature_input = static_cast<int>(input_index);

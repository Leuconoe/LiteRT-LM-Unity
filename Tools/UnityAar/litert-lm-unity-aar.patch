+          }
+        }
+      }
+      auto probe_decode_outputs_or =
+          cache_entry->decoder_model->CreateOutputBuffers(
+              cache_entry->decode_index);
+      if (probe_decode_outputs_or.HasValue() &&
+          !probe_decode_outputs_or.Value().empty()) {
+        auto decode_tensor_type_or =
+            probe_decode_outputs_or.Value()[0].TensorType();
+        if (decode_tensor_type_or.HasValue()) {
+          const auto dims = decode_tensor_type_or.Value().Layout().Dimensions();

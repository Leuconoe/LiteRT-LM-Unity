diff --git a/tools/docker/build_android.ps1 b/tools/docker/build_android.ps1
new file mode 100644
index 0000000..4f10bd1
--- /dev/null
+++ b/tools/docker/build_android.ps1
@@ -0,0 +1,40 @@
+param(
+    [string]$ImageName = "litert-lm-android-builder",
+    [string]$ArtifactDir = ""
+)
+
+$ErrorActionPreference = "Stop"
+
+$RepoRoot = (Resolve-Path (Join-Path $PSScriptRoot "..\.." )).Path
+if ([string]::IsNullOrWhiteSpace($ArtifactDir)) {
+    $ArtifactDir = Join-Path $RepoRoot "artifacts\android"
+}
+
+$ContainerName = "litert-lm-android-build-" + [guid]::NewGuid().ToString("N")
+$BuildCommand = @(
+    "set -euo pipefail",
+    "bazel build --disk_cache=/root/.cache/bazel-android --config=android_arm64 //runtime/engine:litert_lm_main",
+    "cp bazel-bin/runtime/engine/litert_lm_main /tmp/litert_lm_main.android_arm64"
+) -join " && "
+
+Write-Host "[LiteRT-LM] Building Docker image '$ImageName'..."
+docker build -f "$RepoRoot/cmake/Containerfile" -t $ImageName "$RepoRoot"
+
+try {
+    Write-Host "[LiteRT-LM] Creating temporary build container '$ContainerName'..."
+    docker create --name $ContainerName $ImageName bash -lc $BuildCommand | Out-Null
+
+    Write-Host "[LiteRT-LM] Running Android Bazel build inside Docker..."
+    docker start -a $ContainerName
+
+    New-Item -ItemType Directory -Force -Path $ArtifactDir | Out-Null
+    $OutputPath = Join-Path $ArtifactDir "litert_lm_main.android_arm64"
+
+    Write-Host "[LiteRT-LM] Copying build artifact to '$OutputPath'..."
+    docker cp "${ContainerName}:/tmp/litert_lm_main.android_arm64" $OutputPath
+
+    Write-Host "[LiteRT-LM] Done. Android binary exported to '$OutputPath'."
+}
+finally {
+    docker rm -f $ContainerName | Out-Null 2>$null
+}
diff --git a/tools/docker/build_litertlm.ps1 b/tools/docker/build_litertlm.ps1
new file mode 100644
index 0000000..12f153b
--- /dev/null
+++ b/tools/docker/build_litertlm.ps1
@@ -0,0 +1,127 @@
+param(
+    [string]$ImageName = "litert-lm-android-builder",
+    [string]$OutputPath = "",
+    [string]$TokenizerFile = "schema/testdata/gemma3_tokenizer.spiece",
+    [string]$HfTokenizerJsonFile = "",
+    [string]$TfliteFile = "schema/testdata/attention.tflite",
+    [string]$LlmMetadata = "schema/testdata/llm_metadata.pb",
+    [string]$LlmMetadataText = "",
+    [string]$BinaryData = "",
+    [string]$SectionMetadata = "tokenizer:vocab_size=10000,algorithm=bpe;tflite:quantized=true,model_size=1234567;llm_metadata:model=gemma3",
+    [string]$CacheVolume = "litert-lm-bazel-cache",
+    [switch]$SkipImageBuild,
+    [switch]$PrintCommandOnly
+)
+
+$ErrorActionPreference = "Stop"
+
+$RepoRoot = (Resolve-Path (Join-Path $PSScriptRoot "..\.." )).Path
+if ([string]::IsNullOrWhiteSpace($OutputPath)) {
+    $OutputPath = Join-Path $RepoRoot "artifacts\litertlm\generated-test_tok_tfl_llm.litertlm"
+}
+
+function Convert-ToContainerPath {
+    param([string]$Path)
+
+    if ([string]::IsNullOrWhiteSpace($Path)) {
+        return ""
+    }
+
+    $resolvedPath = (Resolve-Path (Join-Path $RepoRoot $Path)).Path
+    $rootWithSeparator = $RepoRoot
+    if (!$rootWithSeparator.EndsWith([System.IO.Path]::DirectorySeparatorChar)) {
+        $rootWithSeparator += [System.IO.Path]::DirectorySeparatorChar
+    }
+
+    $rootUri = [System.Uri]::new($rootWithSeparator)
+    $fileUri = [System.Uri]::new($resolvedPath)
+    $relativePath = [System.Uri]::UnescapeDataString($rootUri.MakeRelativeUri($fileUri).ToString())
+    return "/host/" + ($relativePath -replace "\\", "/")
+}
+
+function Add-Flag {
+    param(
+        [System.Collections.Generic.List[string]]$TargetArgs,
+        [string]$Name,
+        [string]$Value
+    )
+
+    if (![string]::IsNullOrWhiteSpace($Value)) {
+        $TargetArgs.Add("--$Name='$Value'") | Out-Null
+    }
+}
+
+function Invoke-Native {
+    param(
+        [string]$Program,
+        [string[]]$Arguments
+    )
+
+    & $Program @Arguments
+    if ($LASTEXITCODE -ne 0) {
+        throw "Command failed with exit code $LASTEXITCODE`: $Program $($Arguments -join ' ')"
+    }
+}
+
+$outputDirectory = Split-Path -Parent $OutputPath
+if (![string]::IsNullOrWhiteSpace($outputDirectory)) {
+    New-Item -ItemType Directory -Force -Path $outputDirectory | Out-Null
+}
+
+$containerOutputPath = "/tmp/output.litertlm"
+$argsList = [System.Collections.Generic.List[string]]::new()
+Add-Flag $argsList "tokenizer_file" (Convert-ToContainerPath $TokenizerFile)
+Add-Flag $argsList "hf_tokenizer_json_file" (Convert-ToContainerPath $HfTokenizerJsonFile)
+Add-Flag $argsList "tflite_file" (Convert-ToContainerPath $TfliteFile)
+Add-Flag $argsList "llm_metadata" (Convert-ToContainerPath $LlmMetadata)
+Add-Flag $argsList "llm_metadata_text" (Convert-ToContainerPath $LlmMetadataText)
+Add-Flag $argsList "binary_data" (Convert-ToContainerPath $BinaryData)
+Add-Flag $argsList "section_metadata" $SectionMetadata
+$argsList.Add("--output_path='$containerOutputPath'") | Out-Null
+
+$containerName = "litert-lm-export-" + [guid]::NewGuid().ToString("N")
+$exporterArgs = [string]::Join(" ", $argsList.ToArray())
+$containerCommand = @(
+    "set -euo pipefail",
+    "cd /litert_lm",
+    "bazel run --disk_cache=/root/.cache/bazel-linux --config=linux_x86_64 //schema/cc:litertlm_export_main -- $exporterArgs",
+    "ls -lh '$containerOutputPath'"
+) -join " && "
+
+if ($PrintCommandOnly) {
+    Write-Host $containerCommand
+    return
+}
+
+if (!$SkipImageBuild) {
+    Write-Host "[LiteRT-LM] Building Docker image '$ImageName'..."
+    Invoke-Native "docker" @("build", "-f", "$RepoRoot/cmake/Containerfile", "-t", $ImageName, "$RepoRoot")
+}
+
+try {
+    Write-Host "[LiteRT-LM] Creating temporary exporter container '$ContainerName'..."
+    Invoke-Native "docker" @(
+        "create",
+        "--name",
+        $containerName,
+        "-v",
+        "${CacheVolume}:/root/.cache",
+        "-v",
+        "${RepoRoot}:/host",
+        $ImageName,
+        "bash",
+        "-lc",
+        $containerCommand) | Out-Null
+
+    Write-Host "[LiteRT-LM] Building .litertlm inside Docker..."
+    Invoke-Native "docker" @("start", "-a", $containerName)
+
+    Write-Host "[LiteRT-LM] Copying .litertlm to '$OutputPath'..."
+    Invoke-Native "docker" @("cp", "${containerName}:${containerOutputPath}", $OutputPath)
+
+    $outputItem = Get-Item $OutputPath
+    Write-Host "[LiteRT-LM] Done. Output: '$($outputItem.FullName)' ($($outputItem.Length) bytes)."
+}
+finally {
+    docker rm -f $containerName | Out-Null 2>$null
+}
diff --git a/tools/docker/build_unity_aar.ps1 b/tools/docker/build_unity_aar.ps1
new file mode 100644
index 0000000..9fc9d74
--- /dev/null
+++ b/tools/docker/build_unity_aar.ps1
@@ -0,0 +1,73 @@
+param(
+    [string]$ImageName = "litert-lm-android-builder",
+    [string]$ArtifactDir = "",
+    [string]$UnityPluginsDir = "",
+    [switch]$SkipImageBuild,
+    [string]$ReuseContainer = "",
+    [switch]$SyncWorktree,
+    [switch]$SyncOnly,
+    [switch]$PackageOnly,
+    [string]$ReuseAar = "",
+    [string]$BazelJobs = "",
+    [Parameter(ValueFromRemainingArguments = $true)]
+    [string[]]$ExtraArgs
+)
+
+$ErrorActionPreference = "Stop"
+
+$BashScript = Join-Path $PSScriptRoot "build_unity_aar.sh"
+if (!(Test-Path $BashScript)) {
+    throw "Missing bash build script: $BashScript"
+}
+
+$BashCandidates = @(
+    "C:\Program Files\Git\bin\bash.exe",
+    "C:\Program Files\Git\usr\bin\bash.exe"
+)
+$BashPath = $BashCandidates | Where-Object { Test-Path $_ } | Select-Object -First 1
+if ([string]::IsNullOrWhiteSpace($BashPath)) {
+    $Command = Get-Command bash -ErrorAction SilentlyContinue
+    if ($Command) {
+        $BashPath = $Command.Source
+    }
+}
+if ([string]::IsNullOrWhiteSpace($BashPath)) {
+    throw "bash was not found. Install Git for Windows or run tools/docker/build_unity_aar.sh from an existing bash shell."
+}
+
+$Arguments = @($BashScript, "--image-name", $ImageName)
+if (![string]::IsNullOrWhiteSpace($ArtifactDir)) {
+    $Arguments += @("--artifact-dir", $ArtifactDir)
+}
+if (![string]::IsNullOrWhiteSpace($UnityPluginsDir)) {
+    $Arguments += @("--unity-plugins-dir", $UnityPluginsDir)
+}
+if ($SkipImageBuild) {
+    $Arguments += "--skip-image-build"
+}
+if (![string]::IsNullOrWhiteSpace($ReuseContainer)) {
+    $Arguments += @("--reuse-container", $ReuseContainer)
+}
+if ($SyncWorktree) {
+    $Arguments += "--sync-worktree"
+}
+if ($SyncOnly) {
+    $Arguments += "--sync-only"
+}
+if ($PackageOnly) {
+    $Arguments += "--package-only"
+}
+if (![string]::IsNullOrWhiteSpace($ReuseAar)) {
+    $Arguments += @("--reuse-aar", $ReuseAar)
+}
+if (![string]::IsNullOrWhiteSpace($BazelJobs)) {
+    $Arguments += @("--bazel-jobs", $BazelJobs)
+}
+if ($ExtraArgs -and $ExtraArgs.Count -gt 0) {
+    $Arguments += $ExtraArgs
+}
+
+& $BashPath @Arguments
+if ($LASTEXITCODE -ne 0) {
+    throw "Bash Unity AAR build failed with exit code $LASTEXITCODE."
+}
diff --git a/tools/docker/build_unity_aar.sh b/tools/docker/build_unity_aar.sh
new file mode 100644
index 0000000..c8839f2
--- /dev/null
+++ b/tools/docker/build_unity_aar.sh
@@ -0,0 +1,535 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd -P)"
+
+IMAGE_NAME="litert-lm-android-builder"
+ARTIFACT_DIR="$REPO_ROOT/artifacts/unity-android"
+UNITY_PLUGINS_DIR="$REPO_ROOT/LiteRT-LM-Unity/Assets/Plugins/Android"
+REUSE_CONTAINER_NAME=""
+REUSE_AAR_PATH=""
+SKIP_IMAGE_BUILD=0
+SYNC_WORKTREE=0
+SYNC_ONLY=0
+PACKAGE_ONLY=0
+BAZEL_JOBS=""
+
+usage() {
+  cat <<'EOF'
+Usage: build_unity_aar.sh [options]
+
+Options:
+  --image-name NAME        Docker image name to build/use.
+  --artifact-dir DIR       Directory where litertlm-unity-bridge.aar is written.
+  --unity-plugins-dir DIR  Unity Android plugin directory to update.
+  --skip-image-build       Reuse an existing Docker image instead of rebuilding it.
+  --reuse-container NAME   Run the build in an existing warm container.
+  --sync-worktree          Sync AAR source inputs into --reuse-container first.
+  --sync-only              Only sync files, then exit. Requires --reuse-container.
+  --package-only           Skip Bazel build and repackage existing warm outputs.
+  --reuse-aar PATH         Fallback AAR to reuse classes/JNI from in --package-only mode.
+  --bazel-jobs N           Limit Bazel jobs for full builds.
+  -h, --help               Show this help.
+EOF
+}
+
+normalize_path() {
+  local path="$1"
+  if command -v cygpath >/dev/null 2>&1; then
+    case "$path" in
+      [A-Za-z]:/*|[A-Za-z]:\\*)
+        cygpath -u "$path"
+        return
+        ;;
+    esac
+  fi
+
+  case "$path" in
+    /*) printf '%s\n' "$path" ;;
+    *) printf '%s\n' "$PWD/$path" ;;
+  esac
+}
+
+absolute_dir() {
+  local path
+  path="$(normalize_path "$1")"
+  mkdir -p "$path"
+  (cd "$path" && pwd -P)
+}
+
+absolute_file() {
+  local path dir base
+  path="$(normalize_path "$1")"
+  dir="$(dirname "$path")"
+  base="$(basename "$path")"
+  (cd "$dir" && printf '%s/%s\n' "$(pwd -P)" "$base")
+}
+
+to_windows_path() {
+  local path="$1"
+  if command -v cygpath >/dev/null 2>&1; then
+    cygpath -w "$path"
+  else
+    printf '%s\n' "$path"
+  fi
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --image-name)
+      IMAGE_NAME="${2:?Missing value for --image-name}"
+      shift 2
+      ;;
+    --artifact-dir)
+      ARTIFACT_DIR="${2:?Missing value for --artifact-dir}"
+      shift 2
+      ;;
+    --unity-plugins-dir)
+      UNITY_PLUGINS_DIR="${2:?Missing value for --unity-plugins-dir}"
+      shift 2
+      ;;
+    --skip-image-build)
+      SKIP_IMAGE_BUILD=1
+      shift
+      ;;
+    --reuse-container)
+      REUSE_CONTAINER_NAME="${2:?Missing value for --reuse-container}"
+      SKIP_IMAGE_BUILD=1
+      shift 2
+      ;;
+    --sync-worktree)
+      SYNC_WORKTREE=1
+      shift
+      ;;
+    --sync-only)
+      SYNC_ONLY=1
+      SYNC_WORKTREE=1
+      shift
+      ;;
+    --package-only)
+      PACKAGE_ONLY=1
+      shift
+      ;;
+    --reuse-aar)
+      REUSE_AAR_PATH="${2:?Missing value for --reuse-aar}"
+      shift 2
+      ;;
+    --bazel-jobs)
+      BAZEL_JOBS="${2:?Missing value for --bazel-jobs}"
+      shift 2
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [[ "$PACKAGE_ONLY" -eq 1 && -z "$REUSE_CONTAINER_NAME" ]]; then
+  echo "--package-only requires --reuse-container so warm Bazel outputs can be reused." >&2
+  exit 2
+fi
+
+ARTIFACT_DIR="$(absolute_dir "$ARTIFACT_DIR")"
+UNITY_PLUGINS_DIR="$(absolute_dir "$UNITY_PLUGINS_DIR")"
+WORKSPACE_TEMP_ROOT="$(absolute_dir "$REPO_ROOT/temp/unity-android")"
+BAZEL_DISK_CACHE_DIR="$WORKSPACE_TEMP_ROOT/bazel-disk-cache"
+mkdir -p "$BAZEL_DISK_CACHE_DIR"
+
+AAR_PATH="$ARTIFACT_DIR/litertlm-unity-bridge.aar"
+CONTAINER_NAME="litert-lm-unity-aar-$(date +%Y%m%d%H%M%S)-$$"
+CONTAINER_STAGE_ROOT="/litert_lm/temp/unity-aar-stage"
+CONTAINER_AAR_PATH="/litert_lm/temp/litertlm-unity-bridge.aar"
+CONTAINER_REUSE_AAR_PATH="/litert_lm/temp/reuse-litertlm-unity-bridge.aar"
+CONTAINER_REUSE_AAR_ENV=""
+
+if [[ -n "$REUSE_AAR_PATH" ]]; then
+  REUSE_AAR_PATH="$(absolute_file "$REUSE_AAR_PATH")"
+  if [[ ! -s "$REUSE_AAR_PATH" ]]; then
+    echo "Fallback AAR does not exist or is empty: $REUSE_AAR_PATH" >&2
+    exit 2
+  fi
+fi
+
+cleanup() {
+  if [[ -z "$REUSE_CONTAINER_NAME" ]]; then
+    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
+  fi
+}
+trap cleanup EXIT
+
+select_reuse_aar_path() {
+  local candidate
+
+  if [[ -n "$REUSE_AAR_PATH" ]]; then
+    printf '%s\n' "$REUSE_AAR_PATH"
+    return 0
+  fi
+
+  for candidate in "$AAR_PATH" "$UNITY_PLUGINS_DIR/litertlm-unity-bridge.aar"; do
+    if [[ -s "$candidate" ]]; then
+      printf '%s\n' "$candidate"
+      return 0
+    fi
+  done
+
+  return 1
+}
+
+prepare_reuse_aar_in_container() {
+  local container_name="$1"
+  local fallback_aar fallback_aar_win
+
+  CONTAINER_REUSE_AAR_ENV=""
+  if [[ "$PACKAGE_ONLY" -ne 1 ]]; then
+    return
+  fi
+
+  if ! fallback_aar="$(select_reuse_aar_path)"; then
+    echo "[LiteRT-LM] No previous AAR found for package-only fallback."
+    return
+  fi
+
+  echo "[LiteRT-LM] Copying package-only fallback AAR into warm container: $fallback_aar"
+  fallback_aar_win="$(to_windows_path "$fallback_aar")"
+  MSYS_NO_PATHCONV=1 docker exec "$container_name" bash -lc "mkdir -p '$(dirname "$CONTAINER_REUSE_AAR_PATH")'"
+  MSYS_NO_PATHCONV=1 docker cp "$fallback_aar_win" "$container_name:$CONTAINER_REUSE_AAR_PATH"
+  CONTAINER_REUSE_AAR_ENV="$CONTAINER_REUSE_AAR_PATH"
+}
+
+sync_worktree_to_container() {
+  local container_name="$1"
+  local paths=(
+    ".bazelrc"
+    ".bazelversion"
+    "WORKSPACE"
+    "BUILD"
+    "BUILD.antlr4"
+    "BUILD.directx_shader_compiler"
+    "BUILD.llguidance"
+    "BUILD.miniaudio"
+    "BUILD.minizip"
+    "BUILD.minja"
+    "BUILD.nanobind_json"
+    "BUILD.sentencepiece"
+    "BUILD.stb"
+    "BUILD.tokenizers_cpp"
+    "Cargo.lock"
+    "Cargo.toml"
+    "cargo-bazel-lock.json"
+    "android_ndk_env.bzl"
+    "rust_cxx_bridge.bzl"
+    "version.bzl"
+    "build_config"
+    "c"
+    "cxxbridge_cmd"
+    "kotlin"
+    "prebuilt"
+    "runtime"
+    "rust"
+    "schema"
+    "src"
+    "unity"
+  )
+  local rel_path host_path host_path_win target_dir
+
+  echo "[LiteRT-LM] Syncing AAR source inputs into warm container '$container_name'..."
+  for rel_path in "${paths[@]}"; do
+    host_path="$REPO_ROOT/$rel_path"
+    if [[ ! -e "$host_path" ]]; then
+      continue
+    fi
+
+    target_dir="/litert_lm/$(dirname "$rel_path")"
+    host_path_win="$(to_windows_path "$host_path")"
+    MSYS_NO_PATHCONV=1 docker exec "$container_name" bash -lc \
+      "rm -rf '/litert_lm/$rel_path' && mkdir -p '$target_dir'"
+    MSYS_NO_PATHCONV=1 docker cp "$host_path_win" "$container_name:/litert_lm/$rel_path"
+  done
+}
+
+read -r -d '' CONTAINER_COMMAND <<'EOF' || true
+set -euo pipefail
+cd /litert_lm
+
+patch_litert_android_runtime_exports() {
+  local output_base source_litert_repo patched_litert_repo litert_defs litert_cc_build litert_cc_internal_build runtime_linux_lds
+
+  patched_litert_repo="/litert_lm/temp/litert-unity-unversioned"
+  litert_defs="$patched_litert_repo/litert/build_common/litert_build_defs.bzl"
+  litert_cc_build="$patched_litert_repo/litert/cc/BUILD"
+  litert_cc_internal_build="$patched_litert_repo/litert/cc/internal/BUILD"
+  runtime_linux_lds="$patched_litert_repo/litert/build_common/export_litert_runtime_only_linux.lds"
+  if [[ -f "$litert_defs" && -f "$litert_cc_build" && -f "$litert_cc_internal_build" && -f "$runtime_linux_lds" ]] &&
+      grep -q "LITERT_LM_UNITY_UNVERSIONED_DYNSYM_EXPORTS_DF1_GLOBAL" "$runtime_linux_lds" &&
+      grep -q "LITERT_LM_UNITY_DF1_GLOBAL_RUNTIME" "$litert_defs" &&
+      grep -q "LITERT_LM_UNITY_DYNAMIC_RUNTIME_MODEL_DEDUP" "$litert_cc_build" &&
+      grep -q "LITERT_LM_UNITY_DYNAMIC_RUNTIME_MODEL_DEDUP" "$litert_cc_internal_build" &&
+      ! grep -q '"@litert//litert/cc:litert_model",' "$litert_cc_build" &&
+      ! grep -q '"//litert/cc:litert_model",' "$litert_cc_internal_build"; then
+    printf '%s\n' "$patched_litert_repo"
+    return
+  fi
+
+  bazel query @litert//litert/c:litert_runtime_c_api_so >/dev/null
+  output_base="$(bazel info output_base)"
+  source_litert_repo="$output_base/external/litert"
+
+  if [[ ! -d "$source_litert_repo" ]]; then
+    echo "Could not find fetched LiteRT Bazel repository: $source_litert_repo" >&2
+    exit 1
+  fi
+
+  rm -rf "$patched_litert_repo"
+  mkdir -p "$(dirname "$patched_litert_repo")"
+  cp -a "$source_litert_repo" "$patched_litert_repo"
+
+  if [[ ! -f "$litert_defs" ]]; then
+    echo "Could not find LiteRT Bazel build definitions: $litert_defs" >&2
+    exit 1
+  fi
+  if [[ ! -f "$litert_cc_build" ]]; then
+    echo "Could not find LiteRT C++ BUILD file: $litert_cc_build" >&2
+    exit 1
+  fi
+  if [[ ! -f "$litert_cc_internal_build" ]]; then
+    echo "Could not find LiteRT internal C++ BUILD file: $litert_cc_internal_build" >&2
+    exit 1
+  fi
+  if [[ ! -f "$runtime_linux_lds" ]]; then
+    echo "Could not find LiteRT runtime export script: $runtime_linux_lds" >&2
+    exit 1
+  fi
+
+  perl -0pi -e '
+    s#"//litert:android": _EXPORT_LRT_COMMON_LINKOPTS_LINUX \+ _LRT_ANDROID_PAGE_SIZE_LINKOPTS \+ \[_EXPORT_LRT_RUNTIME_ONLY_LINKOPT_LINUX\]#"//litert:android": _EXPORT_LRT_COMMON_LINKOPTS_LINUX + _LRT_ANDROID_PAGE_SIZE_LINKOPTS + [_EXPORT_LRT_RUNTIME_ONLY_LINKOPT_LINUX] + ["-Wl,-z,global"]#g;
+  ' "$litert_defs"
+  sed -i '/def export_lrt_runtime_only_linkopt()/a\    # LITERT_LM_UNITY_DF1_GLOBAL_RUNTIME: Android sampler dlopen resolves LiteRt symbols from the linker global group.' "$litert_defs"
+  sed -i '/"@litert\/\/litert\/cc:litert_model",/d' "$litert_cc_build"
+  sed -i '/"\/\/litert\/cc:litert_model",/d' "$litert_cc_internal_build"
+  sed -i '1i# LITERT_LM_UNITY_DYNAMIC_RUNTIME_MODEL_DEDUP: litert_api_with_dynamic_runtime already links dynamic_runtime:litert_model; do not link the non-dynamic model implementation into Unity JNI.' "$litert_cc_build"
+  sed -i '1i# LITERT_LM_UNITY_DYNAMIC_RUNTIME_MODEL_DEDUP: Unity uses dynamic_runtime LiteRT model implementation for JNI builds.' "$litert_cc_internal_build"
+
+  cat > "$runtime_linux_lds" <<'LDS'
+/* LITERT_LM_UNITY_UNVERSIONED_DYNSYM_EXPORTS_DF1_GLOBAL
+ * Unity Android sampler plugins dlopen LiteRT sampler .so files after startup.
+ * They require LiteRt C API symbols to be present in libLiteRt.so's dynamic
+ * symbol table, but Android rejects the upstream VERS_1.0-versioned exports
+ * for those undefined sampler references. Keep the export script for dynsym
+ * visibility, use an anonymous version script so symbols stay unversioned,
+ * and pair this with -z global in litert_build_defs.bzl so Android places
+ * libLiteRt.so in the linker global group.
+ */
+{
+  global:
+    LiteRt*;
+  local:
+    *;
+};
+LDS
+
+  bazel shutdown >/dev/null 2>&1 || true
+  printf '%s\n' "$patched_litert_repo"
+}
+
+if [[ "${LITERTLM_PACKAGE_ONLY:-0}" != "1" ]]; then
+  PATCHED_LITERT_REPO="$(patch_litert_android_runtime_exports)"
+  BAZEL_LITERT_OVERRIDE=(--override_repository=litert="$PATCHED_LITERT_REPO")
+  BAZEL_JOB_ARGS=()
+  if [[ -n "${LITERTLM_BAZEL_JOBS:-}" ]]; then
+    BAZEL_JOB_ARGS=(--jobs="${LITERTLM_BAZEL_JOBS}")
+  fi
+
+  bazel build \
+    "${BAZEL_LITERT_OVERRIDE[@]}" \
+    "${BAZEL_JOB_ARGS[@]}" \
+    --disk_cache=/root/.cache/bazel-android \
+    --config=android_arm64 \
+    --define=litert_link_capi_so=true \
+    --define=resolve_symbols_in_exec=false \
+    //kotlin/java/com/google/ai/edge/litertlm:litertlm-unity-bridge-jar \
+    //kotlin/java/com/google/ai/edge/litertlm/jni:litertlm_loader \
+    //kotlin/java/com/google/ai/edge/litertlm/jni:litertlm_jni
+else
+  echo "[LiteRT-LM] Package-only mode: skipping Bazel build and Bazel query."
+fi
+
+STAGE_ROOT="/litert_lm/temp/unity-aar-stage"
+rm -rf "$STAGE_ROOT"
+mkdir -p "$STAGE_ROOT/jni/arm64-v8a"
+
+REUSE_AAR_EXTRACT_DIR=""
+if [[ -n "${LITERTLM_REUSE_AAR_PATH:-}" && -s "${LITERTLM_REUSE_AAR_PATH:-}" ]]; then
+  REUSE_AAR_EXTRACT_DIR="$STAGE_ROOT/reuse-aar"
+  mkdir -p "$REUSE_AAR_EXTRACT_DIR"
+  (cd "$REUSE_AAR_EXTRACT_DIR" && jar xf "$LITERTLM_REUSE_AAR_PATH")
+fi
+
+copy_stage_file() {
+  local source_path="$1"
+  local fallback_rel_path="$2"
+  local dest_path="$3"
+  local label="$4"
+
+  if [[ -s "$source_path" ]]; then
+    cp -L "$source_path" "$dest_path"
+    return
+  fi
+
+  if [[ -n "$REUSE_AAR_EXTRACT_DIR" && -s "$REUSE_AAR_EXTRACT_DIR/$fallback_rel_path" ]]; then
+    echo "[LiteRT-LM] Reusing $label from fallback AAR."
+    cp -L "$REUSE_AAR_EXTRACT_DIR/$fallback_rel_path" "$dest_path"
+    return
+  fi
+
+  echo "Required AAR input is missing: $label" >&2
+  echo "  Bazel output: $source_path" >&2
+  if [[ -n "$REUSE_AAR_EXTRACT_DIR" ]]; then
+    echo "  Fallback AAR path: $fallback_rel_path" >&2
+  fi
+  echo "Run one full warm build first, then retry --package-only." >&2
+  exit 1
+}
+
+copy_stage_file \
+  /litert_lm/bazel-bin/kotlin/java/com/google/ai/edge/litertlm/liblitertlm-unity-bridge-jar.jar \
+  classes.jar \
+  "$STAGE_ROOT/classes.jar" \
+  classes.jar
+copy_stage_file \
+  /litert_lm/bazel-out/arm64-v8a-opt/bin/external/litert/litert/c/libLiteRt.so \
+  jni/arm64-v8a/libLiteRt.so \
+  "$STAGE_ROOT/jni/arm64-v8a/libLiteRt.so" \
+  libLiteRt.so
+copy_stage_file \
+  /litert_lm/bazel-out/arm64-v8a-opt/bin/kotlin/java/com/google/ai/edge/litertlm/jni/liblitertlm_loader.so \
+  jni/arm64-v8a/liblitertlm_loader.so \
+  "$STAGE_ROOT/jni/arm64-v8a/liblitertlm_loader.so" \
+  liblitertlm_loader.so
+copy_stage_file \
+  /litert_lm/bazel-out/arm64-v8a-opt/bin/kotlin/java/com/google/ai/edge/litertlm/jni/liblitertlm_jni.so \
+  jni/arm64-v8a/liblitertlm_jni.so \
+  "$STAGE_ROOT/jni/arm64-v8a/liblitertlm_jni.so" \
+  liblitertlm_jni.so
+
+shopt -s nullglob
+PREBUILT_LIBS=(/litert_lm/prebuilt/android_arm64/*.so)
+if [[ "${#PREBUILT_LIBS[@]}" -gt 0 ]]; then
+  cp -L "${PREBUILT_LIBS[@]}" "$STAGE_ROOT/jni/arm64-v8a/"
+elif [[ -n "$REUSE_AAR_EXTRACT_DIR" ]]; then
+  cp -L "$REUSE_AAR_EXTRACT_DIR"/jni/arm64-v8a/libLiteRt* "$STAGE_ROOT/jni/arm64-v8a/" 2>/dev/null || true
+fi
+
+LITERT_CREATE_ENVIRONMENT_SYMBOLS="$(
+  readelf --wide --dyn-syms "$STAGE_ROOT/jni/arm64-v8a/libLiteRt.so" | grep 'LiteRtCreateEnvironment' || true
+)"
+if ! grep -Eq '[[:space:]]LiteRtCreateEnvironment([[:space:]]|$)' <<<"$LITERT_CREATE_ENVIRONMENT_SYMBOLS"; then
+  echo "libLiteRt.so does not export unversioned LiteRtCreateEnvironment in .dynsym." >&2
+  printf '%s\n' "$LITERT_CREATE_ENVIRONMENT_SYMBOLS" >&2
+  exit 1
+fi
+if grep -q 'LiteRtCreateEnvironment@@' <<<"$LITERT_CREATE_ENVIRONMENT_SYMBOLS"; then
+  echo "libLiteRt.so still exports versioned LiteRtCreateEnvironment in .dynsym." >&2
+  printf '%s\n' "$LITERT_CREATE_ENVIRONMENT_SYMBOLS" >&2
+  exit 1
+fi
+if ! readelf -d "$STAGE_ROOT/jni/arm64-v8a/libLiteRt.so" | grep -Eq 'FLAGS_1.*GLOBAL|Flags:.*GLOBAL'; then
+  echo "libLiteRt.so is missing DF_1_GLOBAL. Android sampler dlopen needs libLiteRt in the linker global group." >&2
+  readelf -d "$STAGE_ROOT/jni/arm64-v8a/libLiteRt.so" | grep -E 'FLAGS|GLOBAL' >&2 || true
+  exit 1
+fi
+
+cat > "$STAGE_ROOT/AndroidManifest.xml" <<'MANIFEST'
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.google.ai.edge.litertlm.unitybridge">
+    <uses-sdk android:minSdkVersion="22" />
+    <application>
+        <uses-native-library android:name="libvndksupport.so" android:required="false" />
+        <uses-native-library android:name="libOpenCL.so" android:required="false" />
+        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
+    </application>
+</manifest>
+MANIFEST
+
+(cd "$STAGE_ROOT" && jar cf "/litert_lm/temp/litertlm-unity-bridge.aar" classes.jar AndroidManifest.xml jni)
+test -s "/litert_lm/temp/litertlm-unity-bridge.aar"
+EOF
+
+REPO_ROOT_WIN="$(to_windows_path "$REPO_ROOT")"
+AAR_PATH_WIN="$(to_windows_path "$AAR_PATH")"
+BAZEL_DISK_CACHE_DIR_WIN="$(to_windows_path "$BAZEL_DISK_CACHE_DIR")"
+
+echo "[LiteRT-LM] Workspace temp: $WORKSPACE_TEMP_ROOT"
+MSYS_NO_PATHCONV=1 docker info >/dev/null
+
+if [[ "$SKIP_IMAGE_BUILD" -eq 0 ]]; then
+  echo "[LiteRT-LM] Building Docker image '$IMAGE_NAME'..."
+  MSYS_NO_PATHCONV=1 docker build -f "$REPO_ROOT_WIN/cmake/Containerfile" -t "$IMAGE_NAME" "$REPO_ROOT_WIN"
+else
+  echo "[LiteRT-LM] Skipping Docker image rebuild."
+fi
+
+if [[ -n "$REUSE_CONTAINER_NAME" ]]; then
+  CONTAINER_NAME="$REUSE_CONTAINER_NAME"
+  if ! MSYS_NO_PATHCONV=1 docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
+    echo "Warm container does not exist: $CONTAINER_NAME" >&2
+    exit 1
+  fi
+  if [[ "$(MSYS_NO_PATHCONV=1 docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" != "true" ]]; then
+    echo "[LiteRT-LM] Starting warm container '$CONTAINER_NAME'..."
+    MSYS_NO_PATHCONV=1 docker start "$CONTAINER_NAME" >/dev/null
+  fi
+  if [[ "$SYNC_WORKTREE" -eq 1 ]]; then
+    sync_worktree_to_container "$CONTAINER_NAME"
+  fi
+  if [[ "$SYNC_ONLY" -eq 1 ]]; then
+    echo "[LiteRT-LM] Sync-only mode complete."
+    exit 0
+  fi
+  prepare_reuse_aar_in_container "$CONTAINER_NAME"
+  echo "[LiteRT-LM] Building Unity AAR inputs in warm container '$CONTAINER_NAME'..."
+  MSYS_NO_PATHCONV=1 docker exec \
+    -e LITERTLM_PACKAGE_ONLY="$PACKAGE_ONLY" \
+    -e LITERTLM_REUSE_AAR_PATH="$CONTAINER_REUSE_AAR_ENV" \
+    -e LITERTLM_BAZEL_JOBS="$BAZEL_JOBS" \
+    "$CONTAINER_NAME" bash -lc "$CONTAINER_COMMAND"
+else
+  echo "[LiteRT-LM] Creating temporary AAR build container '$CONTAINER_NAME'..."
+  MSYS_NO_PATHCONV=1 docker create \
+    --name "$CONTAINER_NAME" \
+    --mount "type=bind,source=$BAZEL_DISK_CACHE_DIR_WIN,target=/root/.cache/bazel-android" \
+    -e LITERTLM_PACKAGE_ONLY="$PACKAGE_ONLY" \
+    -e LITERTLM_REUSE_AAR_PATH="" \
+    -e LITERTLM_BAZEL_JOBS="$BAZEL_JOBS" \
+    "$IMAGE_NAME" bash -lc "$CONTAINER_COMMAND" >/dev/null
+
+  echo "[LiteRT-LM] Building Unity AAR inputs inside Docker..."
+  MSYS_NO_PATHCONV=1 docker start -a "$CONTAINER_NAME"
+fi
+
+rm -f "$AAR_PATH"
+MSYS_NO_PATHCONV=1 docker cp "${CONTAINER_NAME}:${CONTAINER_AAR_PATH}" "$AAR_PATH_WIN"
+
+AAR_SIZE="$(wc -c < "$AAR_PATH" | tr -d '[:space:]')"
+if [[ -z "$AAR_SIZE" || "$AAR_SIZE" -lt 1000000 ]]; then
+  echo "Generated AAR is unexpectedly small: $AAR_PATH" >&2
+  exit 1
+fi
+
+LEGACY_ANDROIDLIB_PATH="$UNITY_PLUGINS_DIR/litertlm-unity-bridge.androidlib"
+if [[ -e "$LEGACY_ANDROIDLIB_PATH" ]]; then
+  echo "[LiteRT-LM] Removing stale Unity androidlib plugin '$LEGACY_ANDROIDLIB_PATH' to avoid duplicate Android namespaces."
+  rm -rf "$LEGACY_ANDROIDLIB_PATH"
+fi
+rm -f "$LEGACY_ANDROIDLIB_PATH.meta"
+
+cp -f "$AAR_PATH" "$UNITY_PLUGINS_DIR/litertlm-unity-bridge.aar"
+
+echo "[LiteRT-LM] Done. AAR exported to '$AAR_PATH'."
+echo "[LiteRT-LM] Copied into LiteRT-LM-Unity: '$UNITY_PLUGINS_DIR/litertlm-unity-bridge.aar'."
diff --git a/tools/docker/export_qwen25_gpu_candidate.ps1 b/tools/docker/export_qwen25_gpu_candidate.ps1
new file mode 100644
index 0000000..f549397
--- /dev/null
+++ b/tools/docker/export_qwen25_gpu_candidate.ps1
@@ -0,0 +1,101 @@
+param(
+    [string]$ImageName = "litert-lm-torch-nightly",
+    [string]$BaseImageName = "litert-lm-android-builder",
+    [string]$ModelId = "Qwen/Qwen2.5-0.5B-Instruct",
+    [string]$OutputDir = "artifacts/models/qwen2p5-0p5b-split-cache-q8",
+    [string]$PrefillLengths = "8,64,128",
+    [int]$CacheLength = 1280,
+    [string]$QuantizationRecipe = "dynamic_wi8_afp32",
+    [string]$HfCacheVolume = "litert-hf-cache",
+    [string]$PipCacheVolume = "litert-torch-pip-cache",
+    [switch]$SkipImageBuild
+)
+
+$ErrorActionPreference = "Stop"
+
+$RepoRoot = (Resolve-Path (Join-Path $PSScriptRoot "..\.." )).Path
+$ResolvedOutputDir = Join-Path $RepoRoot $OutputDir
+New-Item -ItemType Directory -Force -Path $ResolvedOutputDir | Out-Null
+
+function Invoke-Native {
+    param(
+        [string]$Program,
+        [string[]]$Arguments
+    )
+
+    & $Program @Arguments
+    if ($LASTEXITCODE -ne 0) {
+        throw "Command failed with exit code $LASTEXITCODE`: $Program $($Arguments -join ' ')"
+    }
+}
+
+function Test-DockerImage {
+    param([string]$Name)
+
+    docker image inspect $Name *> $null
+    return $LASTEXITCODE -eq 0
+}
+
+if (!$SkipImageBuild -and !(Test-DockerImage $ImageName)) {
+    Write-Host "[LiteRT-LM] Creating '$ImageName' with litert-torch-nightly..."
+    $containerName = "litert-torch-nightly-tool-" + [guid]::NewGuid().ToString("N")
+    try {
+        Invoke-Native "docker" @(
+            "run",
+            "--name", $containerName,
+            "-v", "${PipCacheVolume}:/root/.cache/pip",
+            $BaseImageName,
+            "bash",
+            "-lc",
+            "set -euo pipefail; python3 -m pip install --break-system-packages --ignore-installed --pre litert-torch-nightly huggingface_hub >/tmp/litert-torch-install.log 2>&1; litert-torch export_hf --help >/tmp/export_hf_help.txt 2>&1 || true"
+        )
+        Invoke-Native "docker" @("commit", $containerName, $ImageName)
+    }
+    finally {
+        docker rm -f $containerName *> $null
+    }
+}
+
+if (!(Test-DockerImage $ImageName)) {
+    throw "Docker image '$ImageName' was not found. Run without -SkipImageBuild or build it first."
+}
+
+$exportCommand = @(
+    "set -euo pipefail",
+    "mkdir -p '/host/$OutputDir'",
+    "cd /host",
+    "litert-torch export_hf '$ModelId' '/host/$OutputDir' --prefill_lengths=$PrefillLengths --cache_length=$CacheLength --quantization_recipe=$QuantizationRecipe --split_cache=True --bundle_litert_lm=False --keep_temporary_files=True 2>&1 | tee '/host/$OutputDir/export.log'"
+) -join "; "
+
+Write-Host "[LiteRT-LM] Exporting GPU candidate graph..."
+Invoke-Native "docker" @(
+    "run",
+    "--rm",
+    "-v", "${RepoRoot}:/host",
+    "-v", "${HfCacheVolume}:/root/.cache/huggingface",
+    $ImageName,
+    "bash",
+    "-lc",
+    $exportCommand
+)
+
+$tfliteFiles = @(
+    "model_quantized.tflite",
+    "embedder_quantized.tflite",
+    "auxiliary.tflite"
+)
+
+foreach ($file in $tfliteFiles) {
+    $path = Join-Path $ResolvedOutputDir $file
+    if (!(Test-Path $path)) {
+        throw "Expected export output was not found: $path"
+    }
+
+    $reportPath = Join-Path $ResolvedOutputDir ($file -replace "\.tflite$", ".gpu_preflight.json")
+    Write-Host "[LiteRT-LM] GPU preflight: $file"
+    python (Join-Path $RepoRoot "tools\inspect_tflite_graph.py") $path --blocker-limit 20 --json |
+        Set-Content -Encoding UTF8 $reportPath
+    python (Join-Path $RepoRoot "tools\inspect_tflite_graph.py") $path --blocker-limit 12
+}
+
+Write-Host "[LiteRT-LM] Done. Output: $ResolvedOutputDir"

+
+  auto response = context->conversation->SendMessage(
+      MakeTextMessageJson("user", JStringToStdString(env, text)));
+  if (!response.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to send message: " + response.status().ToString());
+    return nullptr;
+  }

+template <typename T>
+absl::StatusOr<std::vector<T>> ReadTensorBufferVector(
+    ::litert::TensorBuffer& buffer) {
+  LITERT_ASSIGN_OR_RETURN(auto tensor_type, buffer.TensorType());
+  LITERT_ASSIGN_OR_RETURN(auto elements, tensor_type.Layout().NumElements());
+  std::vector<T> data(elements);
+  LITERT_RETURN_IF_ERROR(buffer.Read<T>(absl::MakeSpan(data)));
+  return data;
+}

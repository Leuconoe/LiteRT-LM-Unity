+    if (!logits_or.ok()) {
+      result["error"] = std::string(logits_or.status().message());
+      return result;
+    }
+    auto logits = std::move(*logits_or);
+    const int logits_position = static_cast<int>(token_ids.size()) - 1;
+    const size_t offset =
+        static_cast<size_t>(logits_position) * kVocabSize;
+    int best_token = kEosToken;
+    float best_score = -std::numeric_limits<float>::infinity();
+    if (detect_language && token_ids.size() == 1) {
+      for (int i = kFirstLanguageToken; i <= kLastLanguageToken; ++i) {
+        const float score = logits[offset + i];
+        if (score > best_score) {
+          best_score = score;
+          best_token = i;
+        }
+      }
+    } else {
+      for (int i = 0; i < kVocabSize; ++i) {
+        if (IsSuppressedWhisperToken(i)) {
+          continue;
+        }
+        const float score = logits[offset + i];
+        if (score > best_score) {
+          best_score = score;
+          best_token = i;
+        }
+      }
+    }
+
+    ++decode_steps;
+    if (detect_language && token_ids.size() == 1) {
+      result["detectedLanguageToken"] = best_token;
+      token_ids.push_back(best_token);
+      token_ids.push_back(kTranscribeToken);
+      token_ids.push_back(kNoTimestampsToken);
+      UnityAsrLog("Whisper ASR auto language token=" +
+                  std::to_string(best_token));
+      continue;
+    }
+    if (best_token == kEosToken) {
+      UnityAsrLog("Whisper ASR decode reached EOS at step " +
+                  std::to_string(decode_steps));
+      break;
+    }
+    token_ids.push_back(best_token);
+  }
+
+  result["decodeSeconds"] = absl::ToDoubleSeconds(absl::Now() - decode_started);
+  result["decodeSteps"] = decode_steps;
+  result["tokenCount"] = token_ids.size();
+  result["tokenIds"] = token_ids;
+  result["transcriptCandidate"] =
+      DecodeWhisperTokens(tokenizer_json_path, token_ids, kVocabSize);
+  UnityAsrLog("Whisper ASR decode done: seconds=" +
+              std::to_string(result["decodeSeconds"].get<double>()) +
+              ", steps=" + std::to_string(decode_steps));
+  if (token_ids.size() <= 4 || result["transcriptCandidate"].get<std::string>().empty()) {
+    result["error"] = "No Whisper ASR text was decoded.";
+    return result;
+  }
+  result["success"] = true;
+  return result;
+}
+
+nlohmann::ordered_json RunQwen3AsrSmokeToJson(
+    const std::string& model_path, const std::string& audio_path,
+    const std::string& tokenizer_json_path, const std::string& backend,
+    const std::string& language) {
+  UnityAsrLog("Qwen3 ASR native start: backend=" + backend +
+              ", language=" + language);
+  nlohmann::ordered_json result;
+  result["modelPath"] = model_path;
+  result["audioPath"] = audio_path;
+  result["tokenizerJsonPath"] = tokenizer_json_path;
+  result["backendRequested"] = backend;
+  std::string normalized_language = language;
+  std::transform(normalized_language.begin(), normalized_language.end(),
+                 normalized_language.begin(),
+                 [](unsigned char c) { return std::tolower(c); });
+  if (normalized_language.empty()) {
+    normalized_language = "auto";
+  }
+  result["language"] = normalized_language;
+  if (normalized_language != "auto") {
+    result["languageNote"] =
+        "Qwen3 ASR always auto-detects the language; the requested language "
+        "hint is ignored.";
+  }
+  result["success"] = false;
+
+  std::string normalized_backend = backend;
+  std::transform(normalized_backend.begin(), normalized_backend.end(),
+                 normalized_backend.begin(),
+                 [](unsigned char c) { return std::toupper(c); });
+  if (normalized_backend.rfind("GPU", 0) == 0) {
+    result["error"] =
+        "Qwen3 ASR supports only the CPU backend for now. Requested backend: " +
+        backend + ".";
+    return result;
+  }
+
+  constexpr int kSampleRate = 16000;
+  constexpr int kChunkSamples = kSampleRate * 5;
+  constexpr int kHopLength = 160;
+  constexpr int kMaxFramesPerChunk = 500;
+  constexpr int kTextSeq = 64;
+  constexpr int kJointSeq = 134;  // 70 audio + 64 text positions.
+  constexpr int kVocabSize = 151936;
+  constexpr int kPadToken = 151643;    // <|endoftext|>
+  constexpr int kImEndToken = 151645;  // <|im_end|>
+  constexpr int kAsrTextToken = 151704;  // <asr_text>
+  // Min-length guard: suppress EOS for the first N generated tokens. Fixes
+  // the quantized-model failure mode where short clips decode to an
+  // immediate EOS (empty transcript); validated harmless on i8 offline.
+  constexpr int kMinDecodeStepsBeforeEos = 3;
+  // Chat template prefix:
+  // <|im_start|>system\n<|im_end|>\n<|im_start|>user\n
+  // <|audio_start|><|audio_end|><|im_end|>\n<|im_start|>assistant\n
+  const std::vector<int> prompt_prefix = {151644, 8948, 198, 151645, 198,
+                                          151644, 872, 198, 151669, 151670,
+                                          151645, 198, 151644, 77091, 198};
+
+  UnityAsrLog("Qwen3 ASR decoding audio to PCM.");
+  auto audio_bytes_or = ReadBinaryFile(audio_path);
+  if (!audio_bytes_or.ok()) {
+    result["error"] = std::string(audio_bytes_or.status().message());
+    return result;
+  }
+  std::vector<float> pcm;
+  auto audio_decode_status = litert::lm::AudioPreprocessorMiniAudio::DecodeAudio(
+      *audio_bytes_or, /*num_channels=*/1, /*sample_rate_hz=*/kSampleRate, pcm);
+  if (!audio_decode_status.ok()) {
+    result["error"] = std::string(audio_decode_status.message());
+    return result;
+  }
+  if (pcm.empty()) {
+    result["error"] = "Decoded audio is empty.";
+    return result;
+  }
+  PreprocessAsrPcm(pcm);
+  result["pcmSamples"] = static_cast<int>(pcm.size());
+  result["audioSeconds"] = pcm.size() / static_cast<double>(kSampleRate);
+  UnityAsrLog("Qwen3 ASR PCM ready: samples=" + std::to_string(pcm.size()));
+
+  UnityAsrLog("Qwen3 ASR loading tokenizer vocab.");
+  const std::vector<std::string> vocab =
+      LoadQwen3AsrVocab(tokenizer_json_path);
+  if (vocab.empty()) {
+    result["error"] =
+        "Failed to load Qwen3 ASR tokenizer vocab: " + tokenizer_json_path;
+    return result;
+  }
+
+  auto started = absl::Now();
+  struct Qwen3AsrCompiledModelCacheEntry {
+    std::string key;
+    std::unique_ptr<::litert::Environment> env;
+    std::unique_ptr<::litert::CompiledModel> model;
+    int encode_index = -1;
+    int decode_index = -1;
+    double initial_compile_seconds = 0.0;
+  };
+  static std::mutex qwen3_asr_cache_mutex;
+  static std::unique_ptr<Qwen3AsrCompiledModelCacheEntry> qwen3_asr_cache;
+
+  const std::string cache_key = model_path + "\n" + normalized_backend;
+  std::unique_lock<std::mutex> cache_lock(qwen3_asr_cache_mutex);
+  const bool cache_hit =
+      qwen3_asr_cache != nullptr && qwen3_asr_cache->key == cache_key;
+  if (cache_hit) {
+    UnityAsrLog("Qwen3 ASR compiled model cache hit.");
+  } else {
+    UnityAsrLog("Qwen3 ASR compiled model cache miss; compiling model.");
+    qwen3_asr_cache.reset();
+    auto cache_entry = std::make_unique<Qwen3AsrCompiledModelCacheEntry>();
+    cache_entry->key = cache_key;
+
+    auto env_or = ::litert::Environment::Create({});
+    if (!env_or.HasValue()) {
+      result["error"] = env_or.Error().Message();
+      return result;
+    }
+    cache_entry->env =
+        std::make_unique<::litert::Environment>(std::move(env_or.Value()));
+
+    auto options_or = ::litert::Options::Create();
+    if (!options_or.HasValue()) {
+      result["error"] = options_or.Error().Message();
+      return result;
+    }
+    auto options = std::move(options_or.Value());
+    auto cpu_options = options.GetCpuOptions();
+    if (cpu_options.HasValue()) {
+      cpu_options->SetNumThreads(4);
+    }
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kCpu);
+
+    auto compiled_model_or = ::litert::CompiledModel::Create(
+        *cache_entry->env, model_path, options);
+    if (!compiled_model_or.HasValue()) {
+      result["error"] = compiled_model_or.Error().Message();
+      return result;
+    }
+    cache_entry->model = std::make_unique<::litert::CompiledModel>(
+        std::move(compiled_model_or.Value()));
+
+    auto encode_index_or = cache_entry->model->GetSignatureIndex("encode");
+    if (!encode_index_or.HasValue()) {
+      result["error"] = encode_index_or.Error().Message();
+      return result;
+    }
+    auto decode_index_or = cache_entry->model->GetSignatureIndex("decode");
+    if (!decode_index_or.HasValue()) {
+      result["error"] = decode_index_or.Error().Message();
+      return result;
+    }
+    cache_entry->encode_index = encode_index_or.Value();
+    cache_entry->decode_index = decode_index_or.Value();
+    cache_entry->initial_compile_seconds =
+        absl::ToDoubleSeconds(absl::Now() - started);
+    UnityAsrLog("Qwen3 ASR compile done: seconds=" +
+                std::to_string(cache_entry->initial_compile_seconds));
+    qwen3_asr_cache = std::move(cache_entry);
+  }
+
+  auto& cached_models = *qwen3_asr_cache;
+  result["compiledModelCache"] = cache_hit ? "hit" : "miss";
+  result["backendUsed"] = "CPU";
+  result["compileSeconds"] =
+      cache_hit ? 0.0 : cached_models.initial_compile_seconds;
+  auto& compiled_model = *cached_models.model;
+  const int encode_index = cached_models.encode_index;
+  const int decode_index = cached_models.decode_index;
+
+  // Static additive causal mask over the joint 70 audio + 64 text sequence.
+  std::vector<float> causal_mask(kJointSeq * kJointSeq, 0.0f);
+  for (int row = 0; row < kJointSeq; ++row) {
+    for (int col = row + 1; col < kJointSeq; ++col) {
+      causal_mask[row * kJointSeq + col] = -1.0e9f;
+    }
+  }
+  std::vector<int32_t> decoder_tokens(kTextSeq, kPadToken);
+
+  const int chunk_count = static_cast<int>(
+      (pcm.size() + kChunkSamples - 1) / kChunkSamples);
+  result["chunkCount"] = chunk_count;
+  int total_valid_frames = 0;
+  double encode_seconds_total = 0.0;
+  double decode_seconds_total = 0.0;
+  int decode_steps_total = 0;
+  std::vector<int> token_ids;
+  std::string transcript;
+  std::string detected_language;
+  nlohmann::ordered_json chunk_results = nlohmann::ordered_json::array();
+
+  for (int chunk_index = 0; chunk_index < chunk_count; ++chunk_index) {
+    const int chunk_start = chunk_index * kChunkSamples;
+    const int chunk_samples =
+        std::min(kChunkSamples, static_cast<int>(pcm.size()) - chunk_start);
+    total_valid_frames +=
+        std::min(kMaxFramesPerChunk, 1 + chunk_samples / kHopLength);
+    UnityAsrLog("Qwen3 ASR chunk " + std::to_string(chunk_index + 1) + "/" +
+                std::to_string(chunk_count) +
+                ": samples=" + std::to_string(chunk_samples));
+    std::vector<float> features =
+        CreateQwen3AsrInputFeatures(pcm.data() + chunk_start, chunk_samples);
+
+    auto encode_started = absl::Now();
+    auto encode_inputs_or = compiled_model.CreateInputBuffers(encode_index);
+    if (!encode_inputs_or.HasValue()) {
+      result["error"] = encode_inputs_or.Error().Message();
+      return result;
+    }
+    auto encode_inputs = std::move(encode_inputs_or.Value());
+    auto encode_outputs_or = compiled_model.CreateOutputBuffers(encode_index);
+    if (!encode_outputs_or.HasValue()) {
+      result["error"] = encode_outputs_or.Error().Message();
+      return result;
+    }
+    auto encode_outputs = std::move(encode_outputs_or.Value());
+    auto encode_write_status =
+        encode_inputs[0].Write<float>(absl::MakeSpan(features));
+    if (!encode_write_status.HasValue()) {
+      result["error"] = encode_write_status.Error().Message();
+      return result;
+    }
+    auto encode_status =
+        compiled_model.Run(encode_index, encode_inputs, encode_outputs);
+    if (!encode_status.HasValue()) {
+      result["error"] = encode_status.Error().Message();
+      return result;
+    }
+    auto encoder_output_or = ReadTensorBufferVector<float>(encode_outputs[0]);
+    if (!encoder_output_or.ok()) {
+      result["error"] = std::string(encoder_output_or.status().message());
+      return result;
+    }
+    auto encoder_output = std::move(*encoder_output_or);
+    const double chunk_encode_seconds =
+        absl::ToDoubleSeconds(absl::Now() - encode_started);
+    encode_seconds_total += chunk_encode_seconds;
+    if (chunk_index == 0) {
+      result["encoderOutputValues"] = encoder_output.size();
+    }
+    UnityAsrLog("Qwen3 ASR chunk encode done: seconds=" +
+                std::to_string(chunk_encode_seconds) +
+                ", values=" + std::to_string(encoder_output.size()));
+
+    std::vector<int> tokens(prompt_prefix.begin(), prompt_prefix.end());
+    int chunk_steps = 0;
+    auto decode_started = absl::Now();
+    while (tokens.size() < static_cast<size_t>(kTextSeq)) {
+      UnityAsrLog("Qwen3 ASR chunk " + std::to_string(chunk_index + 1) +
+                  " decode step " + std::to_string(chunk_steps + 1) +
+                  ", prefixTokens=" + std::to_string(tokens.size()));
+      std::fill(decoder_tokens.begin(), decoder_tokens.end(), kPadToken);
+      for (size_t i = 0; i < tokens.size(); ++i) {
+        decoder_tokens[i] = tokens[i];
+      }
+
+      auto decode_inputs_or = compiled_model.CreateInputBuffers(decode_index);
+      if (!decode_inputs_or.HasValue()) {
+        result["error"] = decode_inputs_or.Error().Message();
+        return result;
+      }
+      auto decode_inputs = std::move(decode_inputs_or.Value());
+      auto decode_outputs_or =
+          compiled_model.CreateOutputBuffers(decode_index);
+      if (!decode_outputs_or.HasValue()) {
+        result["error"] = decode_outputs_or.Error().Message();
+        return result;
+      }
+      auto decode_outputs = std::move(decode_outputs_or.Value());
+
+      auto write_status =
+          decode_inputs[0].Write<float>(absl::MakeSpan(encoder_output));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status =
+          decode_inputs[1].Write<int32_t>(absl::MakeSpan(decoder_tokens));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status = decode_inputs[2].Write<float>(absl::MakeSpan(causal_mask));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      auto decode_status =
+          compiled_model.Run(decode_index, decode_inputs, decode_outputs);
+      if (!decode_status.HasValue()) {
+        result["error"] = decode_status.Error().Message();
+        return result;
+      }
+      auto logits_or = ReadTensorBufferVector<float>(decode_outputs[0]);
+      if (!logits_or.ok()) {
+        result["error"] = std::string(logits_or.status().message());
+        return result;
+      }
+      auto logits = std::move(*logits_or);
+      const int logits_position = static_cast<int>(tokens.size()) - 1;
+      const size_t offset = static_cast<size_t>(logits_position) * kVocabSize;
+      const bool suppress_eos = chunk_steps < kMinDecodeStepsBeforeEos;
+      int best_token = kPadToken;
+      float best_score = -std::numeric_limits<float>::infinity();
+      for (int i = 0; i < kVocabSize; ++i) {
+        if (suppress_eos && (i == kPadToken || i == kImEndToken)) {
+          continue;
+        }
+        const float score = logits[offset + i];
+        if (score > best_score) {
+          best_score = score;
+          best_token = i;
+        }
+      }
+      ++chunk_steps;
+      if (best_token == kPadToken || best_token == kImEndToken) {
+        UnityAsrLog("Qwen3 ASR chunk decode reached EOS (" +
+                    std::to_string(best_token) + ") at step " +
+                    std::to_string(chunk_steps));
+        break;
+      }
+      tokens.push_back(best_token);
+    }
+    decode_seconds_total += absl::ToDoubleSeconds(absl::Now() - decode_started);
+    decode_steps_total += chunk_steps;
+
+    const std::vector<int> generated(tokens.begin() + prompt_prefix.size(),
+                                     tokens.end());
+    token_ids.insert(token_ids.end(), generated.begin(), generated.end());
+
+    // Split the generated ids at <asr_text>:
+    // "language {X}<asr_text>{transcript}".
+    std::vector<int> language_ids;
+    std::vector<int> text_ids;
+    bool seen_asr_text = false;
+    for (int token_id : generated) {
+      if (token_id == kAsrTextToken) {
+        seen_asr_text = true;
+        continue;
+      }
+      if (seen_asr_text) {
+        text_ids.push_back(token_id);
+      } else {
+        language_ids.push_back(token_id);
+      }
+    }
+    std::string chunk_language;
+    std::string chunk_text;
+    if (seen_asr_text) {
+      chunk_language = DecodeQwen3AsrTokens(vocab, language_ids);
+      const std::string language_prefix = "language ";
+      if (chunk_language.rfind(language_prefix, 0) == 0) {
+        chunk_language = chunk_language.substr(language_prefix.size());
+      }
+      chunk_text = DecodeQwen3AsrTokens(vocab, text_ids);
+    } else {
+      chunk_text = DecodeQwen3AsrTokens(vocab, language_ids);
+    }
+    while (!chunk_text.empty() && chunk_text.front() == ' ') {
+      chunk_text.erase(chunk_text.begin());
+    }
+    if (detected_language.empty()) {
+      detected_language = chunk_language;
+    }
+    if (!chunk_text.empty()) {
+      if (!transcript.empty()) {
+        transcript += " ";
+      }
+      transcript += chunk_text;
+    }
+
+    nlohmann::ordered_json chunk_json;
+    chunk_json["index"] = chunk_index;
+    chunk_json["decodeSteps"] = chunk_steps;
+    chunk_json["detectedLanguage"] = chunk_language;
+    chunk_json["transcript"] = chunk_text;
+    chunk_results.push_back(chunk_json);
+    UnityAsrLog("Qwen3 ASR chunk " + std::to_string(chunk_index + 1) +
+                " done: steps=" + std::to_string(chunk_steps) +
+                ", language=" + chunk_language);
+  }
+
+  result["validFeatureFrames"] = total_valid_frames;
+  result["encodeSeconds"] = encode_seconds_total;
+  result["decodeSeconds"] = decode_seconds_total;
+  result["decodeSteps"] = decode_steps_total;
+  result["tokenCount"] = token_ids.size();
+  result["tokenIds"] = token_ids;
+  result["detectedLanguage"] = detected_language;
+  result["chunks"] = chunk_results;
+  result["transcriptCandidate"] = transcript;
+  UnityAsrLog("Qwen3 ASR decode done: seconds=" +
+              std::to_string(decode_seconds_total) +
+              ", steps=" + std::to_string(decode_steps_total));
+  if (transcript.empty()) {
+    result["error"] = "No Qwen3 ASR text was decoded.";
+    return result;
+  }
+  result["success"] = true;
+  return result;
+}
+
+nlohmann::ordered_json MakeTextMessageJson(const std::string& role,
+                                          const std::string& text) {
+  return nlohmann::ordered_json{
+      {"role", role},
+      {"content",
+       nlohmann::ordered_json::array(
+           {nlohmann::ordered_json{{"type", "text"}, {"text", text}}})}};
+}
+
+std::string ExtractTextFromMessageJson(const Message& message) {
+  if (!message.contains("content") || !message["content"].is_array()) {
+    return message.dump();
+  }
+
+  std::string result;
+  for (const auto& item : message["content"]) {
+    if (item.contains("type") && item["type"] == "text" &&
+        item.contains("text") && item["text"].is_string()) {
+      result += item["text"].get<std::string>();
+    }
+  }
+  return result.empty() ? message.dump() : result;
+}
+
+void PromoteUnityJniLibrarySymbols(const std::string& native_library_dir) {
+#if defined(__ANDROID__)
+  if (native_library_dir.empty()) {
+    return;
+  }
+
+  const std::string litert_library_path = native_library_dir + "/libLiteRt.so";
+  void* litert_handle =
+      dlopen(litert_library_path.c_str(), RTLD_NOW | RTLD_GLOBAL);
+  if (litert_handle == nullptr) {
+    ABSL_LOG(WARNING) << "Failed to promote libLiteRt.so symbols: "
+                      << dlerror();
+  } else {
+    ABSL_LOG(INFO) << "Promoted libLiteRt.so symbols for LiteRT sampler "
+                      "shared libraries: "
+                   << litert_library_path;
+  }
+
+  const std::string jni_library_path =
+      native_library_dir + "/liblitertlm_jni.so";
+  void* handle = dlopen(jni_library_path.c_str(), RTLD_NOW | RTLD_GLOBAL);
+  if (handle == nullptr) {
+    ABSL_LOG(WARNING) << "Failed to promote liblitertlm_jni.so symbols: "
+                      << dlerror();
+    return;
+  }
+
+  ABSL_LOG(INFO) << "Promoted liblitertlm_jni.so symbols for LiteRT sampler "
+                    "shared libraries: "
+                 << jni_library_path;
+#else
+  (void)native_library_dir;
+#endif
+}
+
+absl::StatusOr<std::unique_ptr<Engine>> CreateUnityBridgeEngine(
+    const std::string& model_path, const std::string& backend_name,
+    const std::string& cache_dir, const std::string& native_library_dir,
+    int max_num_tokens, int max_num_images, int cpu_threads,
+    bool enable_speculative_decoding,
+    const std::string& vision_backend_name = "",
+    const std::string& audio_backend_name = "") {
+  auto model_assets = ModelAssets::Create(model_path);
+  if (!model_assets.ok()) {
+    return model_assets.status();
+  }
+
+  auto backend_enum = litert::lm::GetBackendFromString(backend_name);
+  if (!backend_enum.ok()) {
+    return backend_enum.status();
+  }
+
+  std::optional<litert::lm::Backend> vision_backend = std::nullopt;
+  if (!vision_backend_name.empty()) {
+    auto vision_backend_enum =
+        litert::lm::GetBackendFromString(vision_backend_name);
+    if (!vision_backend_enum.ok()) {
+      return vision_backend_enum.status();
+    }
+    vision_backend = *vision_backend_enum;
+  }
+
+  std::optional<litert::lm::Backend> audio_backend = std::nullopt;
+  if (!audio_backend_name.empty()) {
+    auto audio_backend_enum =
+        litert::lm::GetBackendFromString(audio_backend_name);
+    if (!audio_backend_enum.ok()) {
+      return audio_backend_enum.status();
+    }
+    audio_backend = *audio_backend_enum;
+  }
+
+  auto settings = EngineSettings::CreateDefault(
+      *model_assets, *backend_enum, vision_backend, audio_backend);
+  if (!settings.ok()) {
+    return settings.status();
+  }
+
+  if (!cache_dir.empty()) {
+    settings->GetMutableMainExecutorSettings().SetCacheDir(cache_dir);
+  }
+  if (!native_library_dir.empty()) {
+    PromoteUnityJniLibrarySymbols(native_library_dir);
+    settings->GetMutableMainExecutorSettings().SetLitertDispatchLibDir(
+        native_library_dir);
+  }
+  if (max_num_tokens > 0) {
+    settings->GetMutableMainExecutorSettings().SetMaxNumTokens(max_num_tokens);
+  }
+  if (max_num_images > 0) {
+    settings->GetMutableMainExecutorSettings().SetMaxNumImages(max_num_images);
+  }
+  if (cpu_threads > 0) {
+    auto cpu_config = settings->GetMutableMainExecutorSettings()
+                          .MutableBackendConfig<litert::lm::CpuConfig>();
+    if (cpu_config.ok()) {
+      auto config = *cpu_config;
+      config.number_of_threads = cpu_threads;
+      settings->GetMutableMainExecutorSettings().SetBackendConfig(config);
+    }
+  }
+  if (*backend_enum == litert::lm::Backend::GPU ||
+      enable_speculative_decoding) {
+    auto advanced_settings =
+        settings->GetMainExecutorSettings().GetAdvancedSettings().value_or(
+            litert::lm::AdvancedSettings());
+    if (*backend_enum == litert::lm::Backend::GPU) {
+      advanced_settings.allow_partial_gpu_delegation = true;
+    }
+    if (enable_speculative_decoding) {
+      advanced_settings.enable_speculative_decoding = true;
+    }
+    settings->GetMutableMainExecutorSettings().SetAdvancedSettings(
+        advanced_settings);
+  }
+
+  return EngineFactory::CreateDefault(std::move(*settings));
+}
+
+absl::StatusOr<std::unique_ptr<Conversation>> CreateUnityBridgeConversation(
+    Engine* engine, const std::string& system_instruction) {
+  auto session_config = SessionConfig::CreateDefault();
+  if (engine->GetEngineSettings().GetAudioExecutorSettings().has_value()) {
+    session_config.SetAudioModalityEnabled(true);
+  }
+  if (engine->GetEngineSettings().GetVisionExecutorSettings().has_value()) {
+    session_config.SetVisionModalityEnabled(true);
+  }
+
+  JsonPreface json_preface;
+  json_preface.messages = nlohmann::ordered_json::array();
+  if (!system_instruction.empty()) {
+    json_preface.messages.push_back(
+        MakeTextMessageJson("system", system_instruction));
+  }
+
+  auto conversation_config = ConversationConfig::Builder()
+                                 .SetSessionConfig(session_config)
+                                 .SetPreface(json_preface)
+                                 .Build(*engine);
+  if (!conversation_config.ok()) {
+    return conversation_config.status();
+  }
+
+  return Conversation::Create(*engine, *conversation_config);
+}

+
+  auto engine = CreateUnityBridgeEngine(
+      model_path_str, JStringToStdString(env, backend),
+      JStringToStdString(env, cache_dir),
+      JStringToStdString(env, native_library_dir), max_num_tokens,
+      max_num_images, cpu_threads,
+      enable_speculative_decoding == JNI_TRUE);
+  if (!engine.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to create engine: " + engine.status().ToString());
+    return 0;

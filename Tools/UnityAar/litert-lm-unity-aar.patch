+  }
+
+  /**
+   * vadMode: "off" | "energy" (default) | "ai". "ai" runs the Silero VAD
+   * tflite at sileroModelPath and falls back to "energy" (with a vadError
+   * field in the result JSON) when the model is missing or fails to load.
+   */
+  public String runWhisperAsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language,
+      String vadMode,
+      String sileroModelPath) {
+    return nativeRunWhisperAsrSmoke(
+        modelPath,
+        audioPath,
+        tokenizerJsonPath,
+        backend,
+        language,
+        vadMode == null ? "energy" : vadMode,
+        sileroModelPath == null ? "" : sileroModelPath);
+  }
+
+  public String runQwen3AsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language) {
+    return runQwen3AsrSmoke(
+        modelPath, audioPath, tokenizerJsonPath, backend, language, "energy", "");
+  }
+
+  public String runQwen3AsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language,
+      String vadMode,
+      String sileroModelPath) {
+    return nativeRunQwen3AsrSmoke(
+        modelPath,
+        audioPath,
+        tokenizerJsonPath,
+        backend,
+        language,
+        vadMode == null ? "energy" : vadMode,
+        sileroModelPath == null ? "" : sileroModelPath);
+  }
+
+  @Override
+  public void close() {
+    if (handle != 0) {
+      nativeClose(handle);
+      handle = 0;
+    }
+  }
+
+  private static int parseSeverity(String severity) {
+    if (severity == null) {
+      return 0;
+    }
+    String normalized = severity.trim().toUpperCase();
+    if (normalized.equals("INFO")) {
+      return 0;
+    }
+    if (normalized.equals("WARNING") || normalized.equals("WARN")) {
+      return 1;
+    }
+    if (normalized.equals("ERROR")) {
+      return 2;
+    }
+    if (normalized.equals("FATAL")) {
+      return 3;
+    }
+    return 0;
+  }

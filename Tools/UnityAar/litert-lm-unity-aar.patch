+// Short-utterance ASR audio preprocessing, shared by the Whisper and Qwen3
+// feature builders. Offline validation (docs/benchmarks/
+// short-utterance-asr-research.md, "Implemented" section):
+// - Energy-gate VAD trim removes low-level noise tails that greedy decode
+//   turns into garbage tokens, while keeping a short lead-in and ~0.3 s of
+//   audio after the last speech frame so speech is not butted directly
+//   against the digital-zero padding.
+// - Boost-only RMS loudness normalization lifts quiet captures toward
+//   -20 dBFS RMS (peak clamped at -1 dBFS). Louder audio is left untouched
+//   (gain is never < 1), which measured strictly no regressions offline.
+constexpr float kAsrTargetRms = 0.1f;        // -20 dBFS RMS target.
+constexpr float kAsrPeakLimit = 0.8912509f;  // -1 dBFS peak clamp.
+constexpr int kAsrVadWindowSamples = 480;    // 30 ms at 16 kHz.
+constexpr float kAsrVadRelativeThreshold = 0.1f;  // -20 dB below peak window.
+constexpr float kAsrVadAbsoluteThreshold = 1.0e-4f;
+constexpr int kAsrVadHeadSamples = 1600;   // 0.1 s lead-in kept before speech.
+constexpr int kAsrVadTailSamples = 4800;   // 0.3 s tail kept after speech.
+
+float ComputePcmRms(const float* pcm, size_t sample_count) {
+  if (sample_count == 0) {
+    return 0.0f;
+  }
+  double sum_squares = 0.0;
+  for (size_t i = 0; i < sample_count; ++i) {
+    sum_squares += static_cast<double>(pcm[i]) * pcm[i];
+  }
+  return static_cast<float>(std::sqrt(sum_squares / sample_count));
+}
+
+// Drops leading/trailing sub-threshold 30 ms windows (energy gate relative
+// to the loudest window), keeping kAsrVadHeadSamples before the first and
+// kAsrVadTailSamples after the last speech window.
+void TrimPcmWithEnergyGate(std::vector<float>& pcm) {
+  const int window_count = static_cast<int>(pcm.size()) / kAsrVadWindowSamples;
+  if (window_count == 0) {
+    return;
+  }
+  std::vector<float> window_rms(window_count, 0.0f);
+  float peak_rms = 0.0f;
+  for (int w = 0; w < window_count; ++w) {
+    window_rms[w] =
+        ComputePcmRms(pcm.data() + w * kAsrVadWindowSamples,
+                      kAsrVadWindowSamples);
+    peak_rms = std::max(peak_rms, window_rms[w]);
+  }
+  if (peak_rms < 1e-6f) {
+    return;
+  }
+  const float threshold = std::max(peak_rms * kAsrVadRelativeThreshold,
+                                   kAsrVadAbsoluteThreshold);
+  int first_active = -1;
+  int last_active = -1;
+  for (int w = 0; w < window_count; ++w) {
+    if (window_rms[w] >= threshold) {
+      if (first_active < 0) {
+        first_active = w;
+      }
+      last_active = w;
+    }
+  }
+  if (first_active < 0) {
+    return;
+  }
+  const int start = std::max(
+      0, first_active * kAsrVadWindowSamples - kAsrVadHeadSamples);
+  const int end = std::min(
+      static_cast<int>(pcm.size()),
+      (last_active + 1) * kAsrVadWindowSamples + kAsrVadTailSamples);
+  if (start == 0 && end == static_cast<int>(pcm.size())) {
+    return;
+  }
+  pcm.assign(pcm.begin() + start, pcm.begin() + end);
+}
+
+// Boost-only RMS normalization toward kAsrTargetRms; the gain is clamped so
+// the peak stays below kAsrPeakLimit and never attenuates (gain >= 1).
+void NormalizePcmLoudness(std::vector<float>& pcm) {
+  const float rms = ComputePcmRms(pcm.data(), pcm.size());
+  if (rms < 1e-6f) {
+    return;
+  }
+  float gain = kAsrTargetRms / rms;
+  float peak = 0.0f;
+  for (const float sample : pcm) {
+    peak = std::max(peak, std::abs(sample));
+  }
+  if (peak * gain > kAsrPeakLimit) {
+    gain = kAsrPeakLimit / peak;
+  }
+  if (gain <= 1.0f) {
+    return;
+  }
+  for (float& sample : pcm) {
+    sample *= gain;
+  }
+}
+
+// Applies the shared trim + loudness preprocessing after audio decode.
+void PreprocessAsrPcm(std::vector<float>& pcm) {
+  TrimPcmWithEnergyGate(pcm);
+  NormalizePcmLoudness(pcm);
+}
+
+double HzToSlaneyMel(double hz) {
+  constexpr double kMinLogHz = 1000.0;
+  constexpr double kMinLogMel = 15.0;
+  constexpr double kLogStep = 0.06875177742094912;  // log(6.4) / 27
+  if (hz < kMinLogHz) {
+    return hz / (200.0 / 3.0);
+  }
+  return kMinLogMel + std::log(hz / kMinLogHz) / kLogStep;
+}
+
+double SlaneyMelToHz(double mel) {
+  constexpr double kMinLogHz = 1000.0;
+  constexpr double kMinLogMel = 15.0;
+  constexpr double kLogStep = 0.06875177742094912;  // log(6.4) / 27
+  if (mel < kMinLogMel) {
+    return mel * (200.0 / 3.0);
+  }
+  return kMinLogHz * std::exp(kLogStep * (mel - kMinLogMel));
+}
+
+std::vector<float> CreateSlaneyMelFilterbank(int sample_rate, int n_fft,
+                                             int n_mels) {
+  const int fft_bins = n_fft / 2 + 1;
+  std::vector<double> mel_points(n_mels + 2);
+  const double mel_min = HzToSlaneyMel(0.0);
+  const double mel_max = HzToSlaneyMel(sample_rate / 2.0);
+  for (int i = 0; i < n_mels + 2; ++i) {
+    const double mel =
+        mel_min + (mel_max - mel_min) * i / static_cast<double>(n_mels + 1);
+    mel_points[i] = SlaneyMelToHz(mel);
+  }
+
+  std::vector<float> weights(n_mels * fft_bins, 0.0f);
+  for (int mel = 0; mel < n_mels; ++mel) {
+    const double lower = mel_points[mel];
+    const double center = mel_points[mel + 1];
+    const double upper = mel_points[mel + 2];
+    const double enorm = 2.0 / (upper - lower);
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      const double freq =
+          (sample_rate / 2.0) * bin / static_cast<double>(fft_bins - 1);
+      const double left = (freq - lower) / (center - lower);
+      const double right = (upper - freq) / (upper - center);
+      const double value = std::max(0.0, std::min(left, right)) * enorm;
+      weights[mel * fft_bins + bin] = static_cast<float>(value);
+    }
+  }
+  return weights;
+}
+
+absl::StatusOr<std::vector<float>> CreateParakeetInputFeatures(
+    const std::string& audio_path, int* pcm_sample_count, int* valid_frames) {
+  ASSIGN_OR_RETURN(const std::string audio_bytes, ReadBinaryFile(audio_path));
+  std::vector<float> pcm;
+  RETURN_IF_ERROR(litert::lm::AudioPreprocessorMiniAudio::DecodeAudio(
+      audio_bytes, /*num_channels=*/1, /*sample_rate_hz=*/16000, pcm));
+  *pcm_sample_count = static_cast<int>(pcm.size());
+
+  constexpr int kSampleRate = 16000;
+  constexpr int kNumMels = 128;
+  constexpr int kMaxFrames = 500;
+  constexpr int kNfft = 512;
+  constexpr int kWinLength = 400;
+  constexpr int kHopLength = 160;
+  constexpr float kPreemphasis = 0.97f;
+  constexpr float kLogZeroGuard = 5.960464477539063e-8f;  // 2^-24
+  const int fft_bins = kNfft / 2 + 1;
+
+  if (pcm.empty()) {
+    return absl::InvalidArgumentError("Decoded audio is empty.");
+  }
+  for (int i = static_cast<int>(pcm.size()) - 1; i >= 1; --i) {
+    pcm[i] = pcm[i] - kPreemphasis * pcm[i - 1];
+  }
+
+  std::vector<float> padded(pcm.size() + kNfft, 0.0f);
+  std::copy(pcm.begin(), pcm.end(), padded.begin() + kNfft / 2);
+  const int frame_count =
+      std::min(kMaxFrames, 1 + static_cast<int>(pcm.size()) / kHopLength);
+  *valid_frames = frame_count;
+
+  std::vector<float> mel_features(frame_count * kNumMels, 0.0f);
+  const std::vector<float> window = HannWindow(kWinLength);
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+
+  for (int t = 0; t < frame_count; ++t) {
+    std::fill(frame.begin(), frame.end(), 0.0f);
+    const int source_start = t * kHopLength;
+    const int window_offset = (kNfft - kWinLength) / 2;
+    for (int i = 0; i < kWinLength; ++i) {
+      frame[window_offset + i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      mel_features[t * kNumMels + mel] =
+          std::log(static_cast<float>(value) + kLogZeroGuard);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  for (int mel = 0; mel < kNumMels; ++mel) {
+    double sum = 0.0;
+    for (int t = 0; t < frame_count; ++t) {
+      sum += mel_features[t * kNumMels + mel];
+    }
+    const double mean = sum / frame_count;
+    double variance = 0.0;
+    for (int t = 0; t < frame_count; ++t) {
+      const double diff = mel_features[t * kNumMels + mel] - mean;
+      variance += diff * diff;
+    }
+    const double stddev =
+        std::sqrt(variance / std::max(1, frame_count - 1)) + 1e-5;
+    for (int t = 0; t < frame_count; ++t) {
+      mel_features[t * kNumMels + mel] =
+          static_cast<float>((mel_features[t * kNumMels + mel] - mean) /
+                             stddev);
+    }
+  }
+
+  std::vector<float> model_input(kNumMels * kMaxFrames, 0.0f);
+  for (int t = 0; t < frame_count; ++t) {
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      model_input[mel * kMaxFrames + t] = mel_features[t * kNumMels + mel];
+    }
+  }
+  return model_input;
+}
+
+// Builds the Whisper log-mel input features. `num_mels` selects the model
+// family: 80 mel bins (tiny/base/small/medium, large-v1/v2) or 128 mel bins
+// (large-v3, large-v3-turbo). Everything else (n_fft 400, hop 160, Slaney
+// filterbank, Whisper max-referenced log normalization) is identical.
+absl::StatusOr<std::vector<float>> CreateWhisperInputFeatures(
+    const std::string& audio_path, int num_mels, int* pcm_sample_count,
+    int* valid_frames) {
+  ASSIGN_OR_RETURN(const std::string audio_bytes, ReadBinaryFile(audio_path));
+  std::vector<float> pcm;
+  RETURN_IF_ERROR(litert::lm::AudioPreprocessorMiniAudio::DecodeAudio(
+      audio_bytes, /*num_channels=*/1, /*sample_rate_hz=*/16000, pcm));
+  if (!pcm.empty()) {
+    PreprocessAsrPcm(pcm);
+  }
+  *pcm_sample_count = static_cast<int>(pcm.size());
+
+  constexpr int kSampleRate = 16000;
+  const int kNumMels = num_mels;
+  constexpr int kMaxSamples = 16000 * 30;
+  constexpr int kMaxFrames = 3000;
+  constexpr int kNfft = 400;
+  constexpr int kHopLength = 160;
+  constexpr float kLogZeroGuard = 1.0e-10f;
+  const int fft_bins = kNfft / 2 + 1;
+
+  if (pcm.empty()) {
+    return absl::InvalidArgumentError("Decoded audio is empty.");
+  }
+
+  if (static_cast<int>(pcm.size()) > kMaxSamples) {
+    pcm.resize(kMaxSamples);
+  }
+  *valid_frames =
+      std::min(kMaxFrames, 1 + static_cast<int>(pcm.size()) / kHopLength);
+
+  std::vector<float> padded(kMaxSamples + kNfft, 0.0f);
+  std::copy(pcm.begin(), pcm.end(), padded.begin() + kNfft / 2);
+  const std::vector<float> window = HannWindow(kNfft);
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+  std::vector<float> log_mels(kNumMels * kMaxFrames, 0.0f);
+  float max_log_mel = -std::numeric_limits<float>::infinity();
+
+  for (int t = 0; t < kMaxFrames; ++t) {
+    const int source_start = t * kHopLength;
+    for (int i = 0; i < kNfft; ++i) {
+      frame[i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      const float log_value =
+          std::log10(std::max(static_cast<float>(value), kLogZeroGuard));
+      log_mels[mel * kMaxFrames + t] = log_value;
+      max_log_mel = std::max(max_log_mel, log_value);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  const float log_floor = max_log_mel - 8.0f;
+  for (float& value : log_mels) {
+    value = (std::max(value, log_floor) + 4.0f) / 4.0f;
+  }
+  return log_mels;
+}
+
+// Builds the [128 x 500] Whisper-style log-mel features for one 5-second
+// PCM chunk of the Qwen3 ASR model. Layout matches the encode signature
+// input [1, 128, 500]: log_mels[mel * 500 + frame].
+std::vector<float> CreateQwen3AsrInputFeatures(const float* pcm,
+                                               int sample_count) {
+  constexpr int kSampleRate = 16000;
+  constexpr int kNumMels = 128;
+  constexpr int kChunkSamples = kSampleRate * 5;
+  constexpr int kMaxFrames = 500;
+  constexpr int kNfft = 400;
+  constexpr int kHopLength = 160;
+  constexpr float kLogZeroGuard = 1.0e-10f;
+  const int fft_bins = kNfft / 2 + 1;
+  const int reflect_pad = kNfft / 2;
+
+  std::vector<float> chunk(kChunkSamples, 0.0f);
+  const int copy_count = std::min(sample_count, kChunkSamples);
+  if (copy_count > 0) {
+    std::copy(pcm, pcm + copy_count, chunk.begin());
+  }
+
+  // Center the STFT frames with reflect padding, matching numpy's
+  // np.pad(chunk, (kNfft / 2, kNfft / 2), mode="reflect").
+  std::vector<float> padded(kChunkSamples + kNfft, 0.0f);
+  std::copy(chunk.begin(), chunk.end(), padded.begin() + reflect_pad);
+  for (int i = 0; i < reflect_pad; ++i) {
+    padded[reflect_pad - 1 - i] = chunk[i + 1];
+    padded[reflect_pad + kChunkSamples + i] = chunk[kChunkSamples - 2 - i];
+  }
+
+  // Periodic Hann window, matching np.hanning(kNfft + 1)[:-1].
+  std::vector<float> window(kNfft, 0.0f);
+  for (int i = 0; i < kNfft; ++i) {
+    window[i] = 0.5f - 0.5f * std::cos(2.0f * static_cast<float>(M_PI) * i /
+                                       static_cast<float>(kNfft));
+  }
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+  std::vector<float> log_mels(kNumMels * kMaxFrames, 0.0f);
+  float max_log_mel = -std::numeric_limits<float>::infinity();
+
+  for (int t = 0; t < kMaxFrames; ++t) {
+    const int source_start = t * kHopLength;
+    for (int i = 0; i < kNfft; ++i) {
+      frame[i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      const float log_value =
+          std::log10(std::max(static_cast<float>(value), kLogZeroGuard));
+      log_mels[mel * kMaxFrames + t] = log_value;
+      max_log_mel = std::max(max_log_mel, log_value);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  const float log_floor = max_log_mel - 8.0f;
+  for (float& value : log_mels) {
+    value = (std::max(value, log_floor) + 4.0f) / 4.0f;
+  }
+  return log_mels;
+}

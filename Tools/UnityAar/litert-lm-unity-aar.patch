+// Dual-mode VAD ASR audio preprocessing, shared by the Whisper and Qwen3
+// feature builders (task #24; offline validation in docs/benchmarks/
+// short-utterance-asr-research.md, "Dual-mode VAD" section):
+// - "off":    no preprocessing (pre-take3 behavior).
+// - "energy": adaptive energy VAD v2 — noise-floor-tracking threshold with
+//   hysteresis (separate speech-on/off levels), ~200 ms hangover and ~100 ms
+//   onset pre-roll — followed by boost-only RMS loudness normalization whose
+//   gain is computed over speech-only samples. Default; supersedes the
+//   take3 fixed relative-to-peak gate (v1) with strictly-no-regression and
+//   one long-clip improvement offline.
+// - "ai":     Silero VAD v5 (bundled tflite, ~1.2 MB, 16 kHz streaming:
+//   64-sample context + 512-sample chunk, recurrent state [2,1,128], one
+//   speech probability per 32 ms chunk) -> segments -> same trim + norm.
+//   Requires sileroModelPath; falls back to "energy" (with vadError in the
+//   result JSON) when the model is missing or fails to compile.
+constexpr float kAsrTargetRms = 0.1f;        // -20 dBFS RMS target.
+constexpr float kAsrPeakLimit = 0.8912509f;  // -1 dBFS peak clamp.
+constexpr int kAsrSampleRate = 16000;
+constexpr int kAsrVadWindowSamples = 480;    // 30 ms at 16 kHz.
+constexpr int kAsrVadHeadSamples = 1600;   // 0.1 s lead-in kept before speech.
+constexpr int kAsrVadTailSamples = 4800;   // 0.3 s tail kept after speech.
+// Energy v2 tunables (validated offline on the 10-clip set, 2026-07-25).
+constexpr float kAsrVadFloorPercentile = 0.20f;  // noise floor estimate.
+constexpr float kAsrVadOnOverFloor = 2.8184f;    // +9 dB above noise floor.
+constexpr float kAsrVadHysteresis = 0.5011872f;  // off = on - 6 dB.
+constexpr float kAsrVadPeakRelative = 0.0316228f;  // never above peak - 30 dB.
+constexpr float kAsrVadAbsoluteThreshold = 1.0e-4f;
+constexpr int kAsrVadHangoverWindows = 7;  // ~210 ms below off-level to close.
+constexpr int kAsrVadPrerollWindows = 3;   // ~90 ms speech-onset pre-roll.
+// Silero tunables (upstream get_speech_timestamps defaults; min speech
+// shortened for sub-second command clips).
+constexpr int kSileroChunkSamples = 512;    // one probability per 32 ms.
+constexpr int kSileroContextSamples = 64;
+constexpr int kSileroStateValues = 2 * 1 * 128;
+constexpr float kSileroThreshold = 0.5f;
+constexpr float kSileroNegThreshold = 0.35f;
+constexpr int kSileroMinSilenceChunks = 3;   // ~100 ms.
+constexpr int kSileroMinSpeechChunks = 3;    // ~100 ms.
+// Silero cuts speech onset tighter than the energy gate; whisper needs more
+// lead-in context (offline: 0.1 s head regressed "볼륨, 업" -> "볼륨? 어" on
+// base-30s-i8, >= 0.15 s fixed it).
+constexpr int kSileroHeadSamples = 3200;     // 0.2 s.
+
+float ComputePcmRms(const float* pcm, size_t sample_count) {
+  if (sample_count == 0) {
+    return 0.0f;
+  }
+  double sum_squares = 0.0;
+  for (size_t i = 0; i < sample_count; ++i) {
+    sum_squares += static_cast<double>(pcm[i]) * pcm[i];
+  }
+  return static_cast<float>(std::sqrt(sum_squares / sample_count));
+}
+
+// Per-run VAD report surfaced in the smoke-result JSON.
+struct AsrVadReport {
+  std::string mode_requested = "energy";
+  std::string mode_used = "energy";
+  // Speech segments in seconds on the decoded (pre-trim) PCM timeline.
+  std::vector<std::array<double, 2>> segments;
+  double trimmed_seconds = 0.0;
+  double gain = 1.0;
+  double speech_rms = 0.0;
+  std::string error;  // non-fatal (e.g. silero load failure -> energy).
+};
+
+// Adaptive energy VAD (v2). Returns speech segments as [start, end) sample
+// ranges (window-aligned, pre-roll/hangover included).
+std::vector<std::pair<int, int>> EnergyVadSegments(
+    const std::vector<float>& pcm) {
+  std::vector<std::pair<int, int>> segments;
+  const int window_count = static_cast<int>(pcm.size()) / kAsrVadWindowSamples;
+  if (window_count == 0) {
+    return segments;
+  }
+  std::vector<float> window_rms(window_count, 0.0f);
+  float peak_rms = 0.0f;
+  for (int w = 0; w < window_count; ++w) {
+    window_rms[w] = ComputePcmRms(pcm.data() + w * kAsrVadWindowSamples,
+                                  kAsrVadWindowSamples);
+    peak_rms = std::max(peak_rms, window_rms[w]);
+  }
+  if (peak_rms < 1e-6f) {
+    return segments;
+  }
+  // Noise floor: linear-interpolated percentile of the window RMS values
+  // (matches numpy.percentile used by the offline prototype).
+  std::vector<float> sorted_rms = window_rms;
+  std::sort(sorted_rms.begin(), sorted_rms.end());
+  const double rank = kAsrVadFloorPercentile * (window_count - 1);
+  const int rank_low = static_cast<int>(rank);
+  const int rank_high = std::min(rank_low + 1, window_count - 1);
+  const double rank_frac = rank - rank_low;
+  const float noise_floor = static_cast<float>(
+      sorted_rms[rank_low] * (1.0 - rank_frac) +
+      sorted_rms[rank_high] * rank_frac);
+  const float threshold_on =
+      std::max({noise_floor * kAsrVadOnOverFloor,
+                peak_rms * kAsrVadPeakRelative, kAsrVadAbsoluteThreshold});
+  const float threshold_off = threshold_on * kAsrVadHysteresis;
+
+  bool in_speech = false;
+  int segment_start = 0;
+  int silence_run = 0;
+  for (int w = 0; w < window_count; ++w) {
+    if (!in_speech) {
+      if (window_rms[w] >= threshold_on) {
+        in_speech = true;
+        segment_start = std::max(0, w - kAsrVadPrerollWindows);
+        silence_run = 0;
+      }
+    } else {
+      if (window_rms[w] < threshold_off) {
+        ++silence_run;
+        if (silence_run >= kAsrVadHangoverWindows) {
+          segments.emplace_back(segment_start * kAsrVadWindowSamples,
+                                (w + 1) * kAsrVadWindowSamples);
+          in_speech = false;
+        }
+      } else {
+        silence_run = 0;
+      }
+    }
+  }
+  if (in_speech) {
+    segments.emplace_back(segment_start * kAsrVadWindowSamples,
+                          window_count * kAsrVadWindowSamples);
+  }
+  return segments;
+}
+
+// Runs the bundled Silero VAD tflite over the PCM, one speech probability
+// per 512-sample chunk. The compiled model is cached by path (CPU backend;
+// the model is ~1.2 MB and compiles in milliseconds).
+absl::StatusOr<std::vector<float>> RunSileroVadProbabilities(
+    const std::string& silero_model_path, const std::vector<float>& pcm) {
+  struct SileroVadCacheEntry {
+    std::string key;
+    std::unique_ptr<::litert::Environment> env;
+    std::unique_ptr<::litert::CompiledModel> model;
+    int signature_index = 0;
+    int audio_input = 0;
+    int state_input = 1;
+    int prob_output = 0;
+    int state_output = 1;
+  };
+  static std::mutex silero_cache_mutex;
+  static std::unique_ptr<SileroVadCacheEntry> silero_cache;
+
+  std::unique_lock<std::mutex> cache_lock(silero_cache_mutex);
+  if (silero_cache == nullptr || silero_cache->key != silero_model_path) {
+    silero_cache = nullptr;
+    auto cache_entry = std::make_unique<SileroVadCacheEntry>();
+    cache_entry->key = silero_model_path;
+
+    auto env_or = ::litert::Environment::Create({});
+    if (!env_or.HasValue()) {
+      return absl::InternalError(env_or.Error().Message());
+    }
+    cache_entry->env =
+        std::make_unique<::litert::Environment>(std::move(env_or.Value()));
+    auto options_or = ::litert::Options::Create();
+    if (!options_or.HasValue()) {
+      return absl::InternalError(options_or.Error().Message());
+    }
+    auto options = std::move(options_or.Value());
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kCpu);
+    auto compiled_model_or = ::litert::CompiledModel::Create(
+        *cache_entry->env, silero_model_path, options);
+    if (!compiled_model_or.HasValue()) {
+      return absl::InternalError(compiled_model_or.Error().Message());
+    }
+    cache_entry->model = std::make_unique<::litert::CompiledModel>(
+        std::move(compiled_model_or.Value()));
+    auto signature_index_or =
+        cache_entry->model->GetSignatureIndex("serving_default");
+    cache_entry->signature_index =
+        signature_index_or.HasValue() ? signature_index_or.Value() : 0;
+
+    // Resolve the audio/state bindings by tensor shape ([1, 576] audio,
+    // [2, 1, 128] state; [1, 1] probability) instead of assuming order.
+    auto probe_inputs_or =
+        cache_entry->model->CreateInputBuffers(cache_entry->signature_index);
+    if (probe_inputs_or.HasValue()) {
+      for (size_t i = 0; i < probe_inputs_or.Value().size(); ++i) {
+        auto tensor_type_or = probe_inputs_or.Value()[i].TensorType();
+        if (!tensor_type_or.HasValue()) {
+          continue;
+        }
+        const auto dims = tensor_type_or.Value().Layout().Dimensions();
+        if (dims.size() == 2 && dims[0] == 1) {
+          cache_entry->audio_input = static_cast<int>(i);
+        } else if (dims.size() == 3 && dims[0] == 2) {
+          cache_entry->state_input = static_cast<int>(i);
+        }
+      }
+    }
+    auto probe_outputs_or =
+        cache_entry->model->CreateOutputBuffers(cache_entry->signature_index);
+    if (probe_outputs_or.HasValue()) {
+      for (size_t i = 0; i < probe_outputs_or.Value().size(); ++i) {
+        auto tensor_type_or = probe_outputs_or.Value()[i].TensorType();
+        if (!tensor_type_or.HasValue()) {
+          continue;
+        }
+        const auto dims = tensor_type_or.Value().Layout().Dimensions();
+        if (dims.size() == 3 && dims[0] == 2) {
+          cache_entry->state_output = static_cast<int>(i);
+        } else {
+          cache_entry->prob_output = static_cast<int>(i);
+        }
+      }
+    }
+    UnityAsrLog("Silero VAD compiled: path=" + silero_model_path +
+                ", audioInput=" + std::to_string(cache_entry->audio_input) +
+                ", stateInput=" + std::to_string(cache_entry->state_input) +
+                ", probOutput=" + std::to_string(cache_entry->prob_output) +
+                ", stateOutput=" + std::to_string(cache_entry->state_output));
+    silero_cache = std::move(cache_entry);
+  }
+  auto& cached = *silero_cache;
+
+  auto inputs_or = cached.model->CreateInputBuffers(cached.signature_index);
+  if (!inputs_or.HasValue()) {
+    return absl::InternalError(inputs_or.Error().Message());
+  }
+  auto inputs = std::move(inputs_or.Value());
+  auto outputs_or = cached.model->CreateOutputBuffers(cached.signature_index);
+  if (!outputs_or.HasValue()) {
+    return absl::InternalError(outputs_or.Error().Message());
+  }
+  auto outputs = std::move(outputs_or.Value());
+
+  const int chunk_count = static_cast<int>(
+      (pcm.size() + kSileroChunkSamples - 1) / kSileroChunkSamples);
+  std::vector<float> probabilities(chunk_count, 0.0f);
+  std::vector<float> state(kSileroStateValues, 0.0f);
+  std::vector<float> frame(kSileroContextSamples + kSileroChunkSamples, 0.0f);
+  for (int c = 0; c < chunk_count; ++c) {
+    // 64 samples of left context followed by the current 512-sample chunk
+    // (zero-padded at the clip tail).
+    std::fill(frame.begin(), frame.end(), 0.0f);
+    const int chunk_start = c * kSileroChunkSamples;
+    const int context_start = chunk_start - kSileroContextSamples;
+    for (int i = 0; i < kSileroContextSamples + kSileroChunkSamples; ++i) {
+      const int source = context_start + i;
+      if (source >= 0 && source < static_cast<int>(pcm.size())) {
+        frame[i] = pcm[source];
+      }
+    }
+    auto write_status =
+        inputs[cached.audio_input].Write<float>(absl::MakeSpan(frame));
+    if (!write_status.HasValue()) {
+      return absl::InternalError(write_status.Error().Message());
+    }
+    write_status =
+        inputs[cached.state_input].Write<float>(absl::MakeSpan(state));
+    if (!write_status.HasValue()) {
+      return absl::InternalError(write_status.Error().Message());
+    }
+    auto run_status =
+        cached.model->Run(cached.signature_index, inputs, outputs);
+    if (!run_status.HasValue()) {
+      return absl::InternalError(run_status.Error().Message());
+    }
+    float probability = 0.0f;
+    auto read_status = outputs[cached.prob_output].Read<float>(
+        absl::MakeSpan(&probability, 1));
+    if (!read_status.HasValue()) {
+      return absl::InternalError(read_status.Error().Message());
+    }
+    read_status =
+        outputs[cached.state_output].Read<float>(absl::MakeSpan(state));
+    if (!read_status.HasValue()) {
+      return absl::InternalError(read_status.Error().Message());
+    }
+    probabilities[c] = probability;
+  }
+  return probabilities;
+}
+
+// Converts Silero chunk probabilities into [start, end) sample segments with
+// threshold hysteresis and minimum speech/silence durations.
+std::vector<std::pair<int, int>> SileroSegmentsFromProbabilities(
+    const std::vector<float>& probabilities, int pcm_size) {
+  std::vector<std::pair<int, int>> segments;
+  const int chunk_count = static_cast<int>(probabilities.size());
+  bool in_speech = false;
+  int segment_start = 0;
+  int silence_run = 0;
+  auto emit = [&](int first_chunk, int last_chunk) {
+    if (last_chunk - first_chunk + 1 >= kSileroMinSpeechChunks) {
+      segments.emplace_back(
+          first_chunk * kSileroChunkSamples,
+          std::min(pcm_size, (last_chunk + 1) * kSileroChunkSamples));
+    }
+  };
+  for (int c = 0; c < chunk_count; ++c) {
+    if (!in_speech) {
+      if (probabilities[c] >= kSileroThreshold) {
+        in_speech = true;
+        segment_start = c;
+        silence_run = 0;
+      }
+    } else {
+      if (probabilities[c] < kSileroNegThreshold) {
+        ++silence_run;
+        if (silence_run > kSileroMinSilenceChunks) {
+          emit(segment_start, c - silence_run);
+          in_speech = false;
+        }
+      } else {
+        silence_run = 0;
+      }
+    }
+  }
+  if (in_speech) {
+    emit(segment_start, chunk_count - 1 - silence_run);
+  }
+  return segments;
+}
+
+// Shared tail of both VAD modes: trim to [first segment - head, last segment
+// + tail], then boost-only RMS normalization toward kAsrTargetRms with the
+// gain computed over speech-only samples (silence no longer dilutes the
+// reference) and clamped so the peak stays below kAsrPeakLimit.
+void TrimAndNormalizePcm(std::vector<float>& pcm,
+                         const std::vector<std::pair<int, int>>& segments,
+                         int head_samples, AsrVadReport& report) {
+  float reference_rms;
+  int start = 0;
+  int end = static_cast<int>(pcm.size());
+  if (segments.empty()) {
+    reference_rms = ComputePcmRms(pcm.data(), pcm.size());
+  } else {
+    double sum_squares = 0.0;
+    size_t speech_samples = 0;
+    for (const auto& segment : segments) {
+      report.segments.push_back(
+          {segment.first / static_cast<double>(kAsrSampleRate),
+           segment.second / static_cast<double>(kAsrSampleRate)});
+      for (int i = segment.first; i < segment.second; ++i) {
+        sum_squares += static_cast<double>(pcm[i]) * pcm[i];
+      }
+      speech_samples += segment.second - segment.first;
+    }
+    reference_rms = speech_samples == 0
+                        ? 0.0f
+                        : static_cast<float>(
+                              std::sqrt(sum_squares / speech_samples));
+    start = std::max(0, segments.front().first - head_samples);
+    end = std::min(static_cast<int>(pcm.size()),
+                   segments.back().second + kAsrVadTailSamples);
+  }
+  report.speech_rms = reference_rms;
+  report.trimmed_seconds =
+      (static_cast<int>(pcm.size()) - (end - start)) /
+      static_cast<double>(kAsrSampleRate);
+  if (start != 0 || end != static_cast<int>(pcm.size())) {
+    pcm.assign(pcm.begin() + start, pcm.begin() + end);
+  }
+  if (reference_rms < 1e-6f) {
+    return;
+  }
+  float gain = kAsrTargetRms / reference_rms;
+  float peak = 0.0f;
+  for (const float sample : pcm) {
+    peak = std::max(peak, std::abs(sample));
+  }
+  if (peak * gain > kAsrPeakLimit) {
+    gain = kAsrPeakLimit / peak;
+  }
+  if (gain <= 1.0f) {
+    return;
+  }
+  report.gain = gain;
+  for (float& sample : pcm) {
+    sample *= gain;
+  }
+}
+
+// Applies the selected VAD mode + loudness preprocessing after audio decode.
+// vad_mode: "off" | "energy" (default) | "ai". "ai" requires
+// silero_model_path and falls back to "energy" (recording the failure in
+// report.error) when the model cannot be loaded.
+void PreprocessAsrPcm(std::vector<float>& pcm, const std::string& vad_mode,
+                      const std::string& silero_model_path,
+                      AsrVadReport& report) {
+  std::string normalized_mode = vad_mode.empty() ? "energy" : vad_mode;
+  std::transform(normalized_mode.begin(), normalized_mode.end(),
+                 normalized_mode.begin(),
+                 [](unsigned char c) { return std::tolower(c); });
+  report.mode_requested = normalized_mode;
+  if (normalized_mode == "off") {
+    report.mode_used = "off";
+    return;
+  }
+  if (normalized_mode == "ai") {
+    if (silero_model_path.empty()) {
+      report.error = "vadMode=ai requires sileroModelPath; fell back to energy.";
+    } else {
+      auto probabilities_or = RunSileroVadProbabilities(silero_model_path, pcm);
+      if (!probabilities_or.ok()) {
+        report.error = "Silero VAD failed (" +
+                       std::string(probabilities_or.status().message()) +
+                       "); fell back to energy.";
+      } else {
+        report.mode_used = "ai";
+        const auto segments = SileroSegmentsFromProbabilities(
+            *probabilities_or, static_cast<int>(pcm.size()));
+        TrimAndNormalizePcm(pcm, segments, kSileroHeadSamples, report);
+        return;
+      }
+    }
+    UnityAsrLog("ASR VAD: " + report.error);
+  }
+  report.mode_used = "energy";
+  const auto segments = EnergyVadSegments(pcm);
+  TrimAndNormalizePcm(pcm, segments, kAsrVadHeadSamples, report);
+}
+
+// Serializes the VAD report into the smoke-result JSON.
+void AppendVadReport(nlohmann::ordered_json& result,
+                     const AsrVadReport& report) {
+  result["vadMode"] = report.mode_requested;
+  result["vadModeUsed"] = report.mode_used;
+  nlohmann::ordered_json segments = nlohmann::ordered_json::array();
+  for (const auto& segment : report.segments) {
+    segments.push_back({segment[0], segment[1]});
+  }
+  result["speechSegments"] = std::move(segments);
+  result["trimmedSeconds"] = report.trimmed_seconds;
+  result["vadGain"] = report.gain;
+  result["speechRms"] = report.speech_rms;
+  if (!report.error.empty()) {
+    result["vadError"] = report.error;
+  }
+}
+
+double HzToSlaneyMel(double hz) {
+  constexpr double kMinLogHz = 1000.0;
+  constexpr double kMinLogMel = 15.0;
+  constexpr double kLogStep = 0.06875177742094912;  // log(6.4) / 27
+  if (hz < kMinLogHz) {
+    return hz / (200.0 / 3.0);
+  }
+  return kMinLogMel + std::log(hz / kMinLogHz) / kLogStep;
+}
+
+double SlaneyMelToHz(double mel) {
+  constexpr double kMinLogHz = 1000.0;
+  constexpr double kMinLogMel = 15.0;
+  constexpr double kLogStep = 0.06875177742094912;  // log(6.4) / 27
+  if (mel < kMinLogMel) {
+    return mel * (200.0 / 3.0);
+  }
+  return kMinLogHz * std::exp(kLogStep * (mel - kMinLogMel));
+}
+
+std::vector<float> CreateSlaneyMelFilterbank(int sample_rate, int n_fft,
+                                             int n_mels) {
+  const int fft_bins = n_fft / 2 + 1;
+  std::vector<double> mel_points(n_mels + 2);
+  const double mel_min = HzToSlaneyMel(0.0);
+  const double mel_max = HzToSlaneyMel(sample_rate / 2.0);
+  for (int i = 0; i < n_mels + 2; ++i) {
+    const double mel =
+        mel_min + (mel_max - mel_min) * i / static_cast<double>(n_mels + 1);
+    mel_points[i] = SlaneyMelToHz(mel);
+  }
+
+  std::vector<float> weights(n_mels * fft_bins, 0.0f);
+  for (int mel = 0; mel < n_mels; ++mel) {
+    const double lower = mel_points[mel];
+    const double center = mel_points[mel + 1];
+    const double upper = mel_points[mel + 2];
+    const double enorm = 2.0 / (upper - lower);
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      const double freq =
+          (sample_rate / 2.0) * bin / static_cast<double>(fft_bins - 1);
+      const double left = (freq - lower) / (center - lower);
+      const double right = (upper - freq) / (upper - center);
+      const double value = std::max(0.0, std::min(left, right)) * enorm;
+      weights[mel * fft_bins + bin] = static_cast<float>(value);
+    }
+  }
+  return weights;
+}
+
+absl::StatusOr<std::vector<float>> CreateParakeetInputFeatures(
+    const std::string& audio_path, int* pcm_sample_count, int* valid_frames) {
+  ASSIGN_OR_RETURN(const std::string audio_bytes, ReadBinaryFile(audio_path));
+  std::vector<float> pcm;
+  RETURN_IF_ERROR(litert::lm::AudioPreprocessorMiniAudio::DecodeAudio(
+      audio_bytes, /*num_channels=*/1, /*sample_rate_hz=*/16000, pcm));
+  *pcm_sample_count = static_cast<int>(pcm.size());
+
+  constexpr int kSampleRate = 16000;
+  constexpr int kNumMels = 128;
+  constexpr int kMaxFrames = 500;
+  constexpr int kNfft = 512;
+  constexpr int kWinLength = 400;
+  constexpr int kHopLength = 160;
+  constexpr float kPreemphasis = 0.97f;
+  constexpr float kLogZeroGuard = 5.960464477539063e-8f;  // 2^-24
+  const int fft_bins = kNfft / 2 + 1;
+
+  if (pcm.empty()) {
+    return absl::InvalidArgumentError("Decoded audio is empty.");
+  }
+  for (int i = static_cast<int>(pcm.size()) - 1; i >= 1; --i) {
+    pcm[i] = pcm[i] - kPreemphasis * pcm[i - 1];
+  }
+
+  std::vector<float> padded(pcm.size() + kNfft, 0.0f);
+  std::copy(pcm.begin(), pcm.end(), padded.begin() + kNfft / 2);
+  const int frame_count =
+      std::min(kMaxFrames, 1 + static_cast<int>(pcm.size()) / kHopLength);
+  *valid_frames = frame_count;
+
+  std::vector<float> mel_features(frame_count * kNumMels, 0.0f);
+  const std::vector<float> window = HannWindow(kWinLength);
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+
+  for (int t = 0; t < frame_count; ++t) {
+    std::fill(frame.begin(), frame.end(), 0.0f);
+    const int source_start = t * kHopLength;
+    const int window_offset = (kNfft - kWinLength) / 2;
+    for (int i = 0; i < kWinLength; ++i) {
+      frame[window_offset + i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      mel_features[t * kNumMels + mel] =
+          std::log(static_cast<float>(value) + kLogZeroGuard);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  for (int mel = 0; mel < kNumMels; ++mel) {
+    double sum = 0.0;
+    for (int t = 0; t < frame_count; ++t) {
+      sum += mel_features[t * kNumMels + mel];
+    }
+    const double mean = sum / frame_count;
+    double variance = 0.0;
+    for (int t = 0; t < frame_count; ++t) {
+      const double diff = mel_features[t * kNumMels + mel] - mean;
+      variance += diff * diff;
+    }
+    const double stddev =
+        std::sqrt(variance / std::max(1, frame_count - 1)) + 1e-5;
+    for (int t = 0; t < frame_count; ++t) {
+      mel_features[t * kNumMels + mel] =
+          static_cast<float>((mel_features[t * kNumMels + mel] - mean) /
+                             stddev);
+    }
+  }
+
+  std::vector<float> model_input(kNumMels * kMaxFrames, 0.0f);
+  for (int t = 0; t < frame_count; ++t) {
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      model_input[mel * kMaxFrames + t] = mel_features[t * kNumMels + mel];
+    }
+  }
+  return model_input;
+}
+
+// Builds the Whisper log-mel input features. `num_mels` selects the model
+// family: 80 mel bins (tiny/base/small/medium, large-v1/v2) or 128 mel bins
+// (large-v3, large-v3-turbo). `num_frames` is the encoder window detected
+// from the encode signature ([1, n_mels, n_frames]): 3000 for the stock
+// 30 s window, 500/1000 for 5 s/10 s short-window ACFT exports. Audio
+// longer than the window is truncated (matching the desktop bench_acft.py
+// behavior); shorter audio is zero-padded. Everything else (n_fft 400,
+// hop 160, Slaney filterbank, Whisper max-referenced log normalization)
+// is identical.
+absl::StatusOr<std::vector<float>> CreateWhisperInputFeatures(
+    const std::string& audio_path, int num_mels, int num_frames,
+    const std::string& vad_mode, const std::string& silero_model_path,
+    int* pcm_sample_count, int* valid_frames, AsrVadReport* vad_report) {
+  ASSIGN_OR_RETURN(const std::string audio_bytes, ReadBinaryFile(audio_path));
+  std::vector<float> pcm;
+  RETURN_IF_ERROR(litert::lm::AudioPreprocessorMiniAudio::DecodeAudio(
+      audio_bytes, /*num_channels=*/1, /*sample_rate_hz=*/16000, pcm));
+  if (!pcm.empty()) {
+    PreprocessAsrPcm(pcm, vad_mode, silero_model_path, *vad_report);
+  }
+  *pcm_sample_count = static_cast<int>(pcm.size());
+
+  constexpr int kSampleRate = 16000;
+  const int kNumMels = num_mels;
+  constexpr int kNfft = 400;
+  constexpr int kHopLength = 160;
+  // The PCM window follows the detected frame budget (hop 160 @ 16 kHz):
+  // 3000 frames -> 480000 samples (30 s), 500 frames -> 80000 samples (5 s).
+  const int kMaxFrames = num_frames;
+  const int kMaxSamples = kMaxFrames * kHopLength;
+  constexpr float kLogZeroGuard = 1.0e-10f;
+  const int fft_bins = kNfft / 2 + 1;
+
+  if (pcm.empty()) {
+    return absl::InvalidArgumentError("Decoded audio is empty.");
+  }
+
+  if (static_cast<int>(pcm.size()) > kMaxSamples) {
+    pcm.resize(kMaxSamples);
+  }
+  *valid_frames =
+      std::min(kMaxFrames, 1 + static_cast<int>(pcm.size()) / kHopLength);
+
+  std::vector<float> padded(kMaxSamples + kNfft, 0.0f);
+  std::copy(pcm.begin(), pcm.end(), padded.begin() + kNfft / 2);
+  const std::vector<float> window = HannWindow(kNfft);
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+  std::vector<float> log_mels(kNumMels * kMaxFrames, 0.0f);
+  float max_log_mel = -std::numeric_limits<float>::infinity();
+
+  for (int t = 0; t < kMaxFrames; ++t) {
+    const int source_start = t * kHopLength;
+    for (int i = 0; i < kNfft; ++i) {
+      frame[i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      const float log_value =
+          std::log10(std::max(static_cast<float>(value), kLogZeroGuard));
+      log_mels[mel * kMaxFrames + t] = log_value;
+      max_log_mel = std::max(max_log_mel, log_value);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  const float log_floor = max_log_mel - 8.0f;
+  for (float& value : log_mels) {
+    value = (std::max(value, log_floor) + 4.0f) / 4.0f;
+  }
+  return log_mels;
+}
+
+// Builds the [128 x 500] Whisper-style log-mel features for one 5-second
+// PCM chunk of the Qwen3 ASR model. Layout matches the encode signature
+// input [1, 128, 500]: log_mels[mel * 500 + frame].
+std::vector<float> CreateQwen3AsrInputFeatures(const float* pcm,
+                                               int sample_count) {
+  constexpr int kSampleRate = 16000;
+  constexpr int kNumMels = 128;
+  constexpr int kChunkSamples = kSampleRate * 5;
+  constexpr int kMaxFrames = 500;
+  constexpr int kNfft = 400;
+  constexpr int kHopLength = 160;
+  constexpr float kLogZeroGuard = 1.0e-10f;
+  const int fft_bins = kNfft / 2 + 1;
+  const int reflect_pad = kNfft / 2;
+
+  std::vector<float> chunk(kChunkSamples, 0.0f);
+  const int copy_count = std::min(sample_count, kChunkSamples);
+  if (copy_count > 0) {
+    std::copy(pcm, pcm + copy_count, chunk.begin());
+  }
+
+  // Center the STFT frames with reflect padding, matching numpy's
+  // np.pad(chunk, (kNfft / 2, kNfft / 2), mode="reflect").
+  std::vector<float> padded(kChunkSamples + kNfft, 0.0f);
+  std::copy(chunk.begin(), chunk.end(), padded.begin() + reflect_pad);
+  for (int i = 0; i < reflect_pad; ++i) {
+    padded[reflect_pad - 1 - i] = chunk[i + 1];
+    padded[reflect_pad + kChunkSamples + i] = chunk[kChunkSamples - 2 - i];
+  }
+
+  // Periodic Hann window, matching np.hanning(kNfft + 1)[:-1].
+  std::vector<float> window(kNfft, 0.0f);
+  for (int i = 0; i < kNfft; ++i) {
+    window[i] = 0.5f - 0.5f * std::cos(2.0f * static_cast<float>(M_PI) * i /
+                                       static_cast<float>(kNfft));
+  }
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+  std::vector<float> log_mels(kNumMels * kMaxFrames, 0.0f);
+  float max_log_mel = -std::numeric_limits<float>::infinity();
+
+  for (int t = 0; t < kMaxFrames; ++t) {
+    const int source_start = t * kHopLength;
+    for (int i = 0; i < kNfft; ++i) {
+      frame[i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      const float log_value =
+          std::log10(std::max(static_cast<float>(value), kLogZeroGuard));
+      log_mels[mel * kMaxFrames + t] = log_value;
+      max_log_mel = std::max(max_log_mel, log_value);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  const float log_floor = max_log_mel - 8.0f;
+  for (float& value : log_mels) {
+    value = (std::max(value, log_floor) + 4.0f) / 4.0f;
+  }
+  return log_mels;
+}

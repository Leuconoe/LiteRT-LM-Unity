+// ODML pipeline to execute or benchmark LLM graph on device.
+//
+// The pipeline does the following
+// 1) Read the corresponding parameters, weight and model file paths.
+// 2) Construct a graph model with the setting.
+// 3) Execute model inference and generate the output.
+
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <variant>
+
+#include "absl/base/log_severity.h"  // from @com_google_absl
+#include "absl/flags/flag.h"  // from @com_google_absl
+#include "absl/flags/parse.h"  // from @com_google_absl
+#include "absl/functional/any_invocable.h"  // from @com_google_absl
+#include "absl/log/absl_check.h"  // from @com_google_absl
+#include "absl/log/absl_log.h"  // from @com_google_absl
+#include "absl/log/globals.h"  // from @com_google_absl
+#include "absl/status/status.h"  // from @com_google_absl
+#include "absl/status/statusor.h"  // from @com_google_absl
+#include "absl/strings/string_view.h"  // from @com_google_absl
+#include "absl/time/time.h"  // from @com_google_absl
+#include "nlohmann/json.hpp"  // from @nlohmann_json
+#include "litert/cc/internal/scoped_file.h"  // from @litert
+#include "runtime/conversation/conversation.h"
+#include "runtime/conversation/io_types.h"
+#include "runtime/engine/engine.h"
+#include "runtime/engine/engine_factory.h"
+#include "runtime/engine/engine_settings.h"
+#include "runtime/engine/io_types.h"
+#include "runtime/executor/executor_settings_base.h"
+#include "runtime/util/status_macros.h"
+
+ABSL_FLAG(std::string, backend, "gpu",
+          "Executor backend to use for LLM execution (cpu, gpu, etc.)");
+ABSL_FLAG(std::string, model_path, "", "Model path to use for LLM execution.");
+ABSL_FLAG(std::string, input_prompt, "",
+          "Input prompt to use for testing LLM execution.");
+ABSL_FLAG(std::string, input_prompt_file, "", "File path to the input prompt.");
+ABSL_FLAG(std::string, system_message, "",
+          "Optional system message to use for conversation preface.");
+ABSL_FLAG(std::string, system_message_file, "",
+          "Optional file path containing the system message.");
+ABSL_FLAG(std::string, tools_json, "",
+          "Optional JSON array describing tools for function calling.");
+ABSL_FLAG(std::string, tools_json_file, "",
+          "Optional file path containing a JSON array of tools.");
+ABSL_FLAG(std::string, messages_json_file, "",
+          "Optional file path containing previous messages as a JSON array.");
+ABSL_FLAG(bool, enable_constrained_decoding, false,
+          "Enable constrained decoding for tool/function call output.");
+ABSL_FLAG(bool, output_message_json, false,
+          "Print the full assistant message JSON instead of content text only.");
+
+namespace {
+
+using ::litert::lm::Backend;
+using ::litert::lm::Conversation;
+using ::litert::lm::ConversationConfig;
+using ::litert::lm::EngineSettings;
+using ::litert::lm::InputData;
+using ::litert::lm::Message;
+using ::litert::lm::ModelAssets;
+using ::nlohmann::ordered_json;
+
+absl::AnyInvocable<void(absl::StatusOr<Message>)> CreateMessageCallback(
+    bool output_message_json) {
+  return [output_message_json](absl::StatusOr<Message> message) {
+    if (!message.ok()) {
+      std::cout << "Error: " << message.status() << std::endl;
+      return;
+    }
+    if (message->is_null()) {
+      std::cout << std::endl << std::flush;
+      return;
+    }
+    if (output_message_json) {
+      std::cout << message->dump() << std::flush;
+      return;
+    }
+    for (const auto& content : (*message)["content"]) {
+      std::cout << content["text"].get<std::string>();
+    }
+    std::cout << std::flush;
+  };
+}
+
+absl::StatusOr<std::string> ReadTextFile(absl::string_view file_path) {
+  std::ifstream file{std::string(file_path)};
+  if (!file.is_open()) {
+    return absl::InvalidArgumentError(
+        std::string("Could not open file: ") + std::string(file_path));
+  }
+
+  std::stringstream buffer;
+  buffer << file.rdbuf();
+  return buffer.str();
+}
+
+absl::StatusOr<std::string> GetFlagTextOrFile(absl::string_view direct_value,
+                                              absl::string_view file_path,
+                                              absl::string_view flag_name) {
+  if (!direct_value.empty() && !file_path.empty()) {
+    return absl::InvalidArgumentError(
+        std::string("Only one of --") + std::string(flag_name) + " and --" +
+        std::string(flag_name) + "_file can be specified.");
+  }
+
+  if (!direct_value.empty()) {
+    return std::string(direct_value);
+  }
+
+  if (!file_path.empty()) {
+    return ReadTextFile(file_path);
+  }
+
+  return std::string();
+}
+
+// Gets the input prompt from the command line flag or file.
+std::string GetInputPrompt() {
+  const std::string input_prompt = absl::GetFlag(FLAGS_input_prompt);
+  const std::string input_prompt_file = absl::GetFlag(FLAGS_input_prompt_file);
+  if (!input_prompt.empty() && !input_prompt_file.empty()) {
+    ABSL_LOG(FATAL) << "Only one of --input_prompt and --input_prompt_file can "
+                       "be specified.";
+  }
+  if (!input_prompt.empty()) {
+    return input_prompt;
+  }
+  if (!input_prompt_file.empty()) {
+    std::ifstream file(input_prompt_file);
+    if (!file.is_open()) {
+      std::cerr << "Error: Could not open file " << input_prompt_file
+                << std::endl;
+      return "";
+    }
+    std::stringstream buffer;
+    buffer << file.rdbuf();
+    return buffer.str();
+  }
+  // If no input prompt is provided, use the default prompt.
+  return "What is the tallest building in the world?";
+}
+
+absl::StatusOr<std::optional<ordered_json>> ParseOptionalJson(
+    absl::string_view value, absl::string_view name) {
+  if (value.empty()) {
+    return std::nullopt;
+  }
+
+  auto parsed = ordered_json::parse(value, nullptr, false);
+  if (parsed.is_discarded()) {
+    return absl::InvalidArgumentError(
+        std::string("Failed to parse JSON for ") + std::string(name) + ".");
+  }
+
+  return parsed;
+}
+
+absl::Status MainHelper(int argc, char** argv) {
+  absl::ParseCommandLine(argc, argv);
+  // Overrides the default for FLAGS_minloglevel to error.
+  absl::SetMinLogLevel(absl::LogSeverityAtLeast::kError);
+  absl::SetStderrThreshold(absl::LogSeverityAtLeast::kFatal);
+
+  const std::string model_path = absl::GetFlag(FLAGS_model_path);
+  if (model_path.empty()) {
+    return absl::InvalidArgumentError("Model path is empty.");
+  }
+  ASSIGN_OR_RETURN(ModelAssets model_assets,  // NOLINT
+                   ModelAssets::Create(model_path));
+  auto backend_str = absl::GetFlag(FLAGS_backend);
+  ASSIGN_OR_RETURN(Backend backend,
+                   litert::lm::GetBackendFromString(backend_str));
+  ASSIGN_OR_RETURN(
+      EngineSettings engine_settings,
+      EngineSettings::CreateDefault(std::move(model_assets), backend));
+  // Enable benchmark by default.
+  engine_settings.GetMutableBenchmarkParams() =
+      litert::lm::proto::BenchmarkParams();
+
+  // Create the engine.
+  ASSIGN_OR_RETURN(auto engine, litert::lm::EngineFactory::CreateDefault(
+                                    std::move(engine_settings)));
+
+  // Create the conversation.
+  std::unique_ptr<Conversation> conversation;
+  auto session_config = litert::lm::SessionConfig::CreateDefault();
+  litert::lm::JsonPreface json_preface;
+  ASSIGN_OR_RETURN(
+      const std::string system_message,
+      GetFlagTextOrFile(absl::GetFlag(FLAGS_system_message),
+                        absl::GetFlag(FLAGS_system_message_file),
+                        "system_message"));
+  ASSIGN_OR_RETURN(const std::string tools_json,
+                   GetFlagTextOrFile(absl::GetFlag(FLAGS_tools_json),
+                                     absl::GetFlag(FLAGS_tools_json_file),
+                                     "tools_json"));
+  std::string messages_json;
+  const std::string messages_json_file =
+      absl::GetFlag(FLAGS_messages_json_file);
+  if (!messages_json_file.empty()) {
+    ASSIGN_OR_RETURN(messages_json, ReadTextFile(messages_json_file));
+  }
+  if (!system_message.empty()) {
+    ordered_json system_message_json;
+    system_message_json["role"] = "system";
+    system_message_json["content"] = system_message;
+    json_preface.messages = ordered_json::array({system_message_json});
+  }
+
+  ASSIGN_OR_RETURN(auto parsed_messages,
+                   ParseOptionalJson(messages_json, "messages_json_file"));
+  if (parsed_messages.has_value()) {
+    if (!parsed_messages->is_array()) {
+      return absl::InvalidArgumentError(
+          "messages_json_file must contain a JSON array.");
+    }
+
+    if (json_preface.messages.is_array()) {
+      json_preface.messages.insert(json_preface.messages.end(),
+                                   parsed_messages->begin(),
+                                   parsed_messages->end());
+    } else {
+      json_preface.messages = std::move(parsed_messages.value());
+    }
+  }
+
+  ASSIGN_OR_RETURN(auto parsed_tools,
+                   ParseOptionalJson(tools_json, "tools_json"));
+  if (parsed_tools.has_value()) {
+    if (!parsed_tools->is_array()) {
+      return absl::InvalidArgumentError("tools_json must be a JSON array.");
+    }
+
+    json_preface.tools = std::move(parsed_tools.value());
+  }
+
+  ASSIGN_OR_RETURN(
+      auto conversation_config,
+      ConversationConfig::Builder()
+          .SetSessionConfig(session_config)
+          .SetPreface(json_preface)
+          .SetEnableConstrainedDecoding(
+              absl::GetFlag(FLAGS_enable_constrained_decoding))
+          .Build(*engine));
+  ASSIGN_OR_RETURN(conversation,
+                   Conversation::Create(*engine, conversation_config));
+
+  // Prepare the message to send.
+  ordered_json content_list = ordered_json::array();
+  const std::string input_prompt = GetInputPrompt();
+  std::cout << "input_prompt: " << input_prompt << std::endl;
+  content_list.push_back({{"type", "text"}, {"text", input_prompt}});
+
+  // Send the message and wait for the response, asynchronously log the
+  // response.
+  RETURN_IF_ERROR(conversation->SendMessageAsync(
+      ordered_json::object({{"role", "user"}, {"content", content_list}}),
+      CreateMessageCallback(absl::GetFlag(FLAGS_output_message_json))));
+  RETURN_IF_ERROR(engine->WaitUntilDone(absl::Minutes(10)));
+
+  // Print the benchmark info.
+  auto benchmark_info = conversation->GetBenchmarkInfo();
+  std::cout << std::endl << *benchmark_info << std::endl;
+  return absl::OkStatus();
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  ABSL_CHECK_OK(MainHelper(argc, argv));
+  return 0;
+}

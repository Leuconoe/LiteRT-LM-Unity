+LITERTLM_JNIEXPORT jstring JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeSendMessageWithMedia(
+    JNIEnv* env, jclass thiz, jlong bridge_pointer, jstring text,
+    jbyteArray image_bytes, jstring image_path, jstring audio_path,
+    jstring extra_context_json) {
+  auto* context = reinterpret_cast<UnityBridgeContext*>(bridge_pointer);
+  if (context == nullptr || context->conversation == nullptr) {
+    ThrowLiteRtLmJniException(env, "Unity bridge is not initialized.");
+    return nullptr;
+  }
+
+  nlohmann::ordered_json content = nlohmann::ordered_json::array();
+  const std::string text_str = JStringToStdString(env, text);
+  if (!text_str.empty()) {
+    content.push_back(
+        nlohmann::ordered_json{{"type", "text"}, {"text", text_str}});
+  }
+
+  const std::string image_path_str = JStringToStdString(env, image_path);
+  if (image_bytes != nullptr && env->GetArrayLength(image_bytes) > 0) {
+    const jsize image_length = env->GetArrayLength(image_bytes);
+    jbyte* image_data = env->GetByteArrayElements(image_bytes, nullptr);
+    if (image_data == nullptr) {
+      ThrowLiteRtLmJniException(env, "Failed to read imageBytes.");
+      return nullptr;
+    }
+    std::string image_blob(reinterpret_cast<const char*>(image_data),
+                           static_cast<size_t>(image_length));
+    env->ReleaseByteArrayElements(image_bytes, image_data, JNI_ABORT);
+    content.push_back(nlohmann::ordered_json{
+        {"type", "image"}, {"blob", absl::Base64Escape(image_blob)}});
+  } else if (!image_path_str.empty()) {
+    content.push_back(
+        nlohmann::ordered_json{{"type", "image"}, {"path", image_path_str}});
+  }
+
+  const std::string audio_path_str = JStringToStdString(env, audio_path);
+  if (!audio_path_str.empty()) {
+    content.push_back(
+        nlohmann::ordered_json{{"type", "audio"}, {"path", audio_path_str}});
+  }
+
+  if (content.empty()) {
+    ThrowLiteRtLmJniException(
+        env, "At least one of text, imageBytes, imagePath or audioPath is "
+             "required.");
+    return nullptr;
+  }
+
+  // extra_context_json is reserved for future use; it is accepted for API
+  // stability but not forwarded to the conversation yet.
+  (void)extra_context_json;
+
+  nlohmann::ordered_json message =
+      nlohmann::ordered_json{{"role", "user"}, {"content", content}};
+  auto response = context->conversation->SendMessage(message);
+  if (!response.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to send message: " + response.status().ToString());
+    return nullptr;
+  }
+
+  return NewStringStandardUTF(env, ExtractTextFromMessageJson(*response));
+}

+LITERTLM_JNIEXPORT jstring JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeRunBenchmark(
+    JNIEnv* env, jclass thiz, jstring model_path, jstring backend,
+    jstring cache_dir, jstring native_library_dir, jint prefill_tokens,
+    jint decode_tokens, jboolean enable_speculative_decoding) {
+  const std::string model_path_str = JStringToStdString(env, model_path);
+  if (model_path_str.empty()) {
+    ThrowLiteRtLmJniException(env, "modelPath is required.");
+    return nullptr;
+  }
+
+  struct stat buffer;
+  if (stat(model_path_str.c_str(), &buffer) != 0) {
+    ThrowLiteRtLmJniException(env, "Model file not found: " + model_path_str);
+    return nullptr;
+  }
+
+  auto model_assets = ModelAssets::Create(model_path_str);
+  if (!model_assets.ok()) {
+    ThrowLiteRtLmJniException(env, "Failed to create model assets: " +
+                                       model_assets.status().ToString());
+    return nullptr;
+  }
+
+  auto backend_enum =
+      litert::lm::GetBackendFromString(JStringToStdString(env, backend));
+  if (!backend_enum.ok()) {
+    ThrowLiteRtLmJniException(env, backend_enum.status().ToString());
+    return nullptr;
+  }
+
+  auto settings = EngineSettings::CreateDefault(
+      *model_assets, *backend_enum,
+      /*vision_backend=*/std::nullopt,
+      /*audio_backend=*/std::nullopt);
+  if (!settings.ok()) {
+    ThrowLiteRtLmJniException(env, "Failed to create engine settings: " +
+                                       settings.status().ToString());
+    return nullptr;
+  }
+
+  const std::string cache_dir_str = JStringToStdString(env, cache_dir);
+  if (!cache_dir_str.empty()) {
+    settings->GetMutableMainExecutorSettings().SetCacheDir(cache_dir_str);
+  }
+  const std::string native_library_dir_str =
+      JStringToStdString(env, native_library_dir);
+  if (!native_library_dir_str.empty()) {
+    PromoteUnityJniLibrarySymbols(native_library_dir_str);
+    settings->GetMutableMainExecutorSettings().SetLitertDispatchLibDir(
+        native_library_dir_str);
+  }
+  if (*backend_enum == litert::lm::Backend::GPU ||
+      enable_speculative_decoding == JNI_TRUE) {
+    auto advanced_settings =
+        settings->GetMainExecutorSettings().GetAdvancedSettings().value_or(
+            litert::lm::AdvancedSettings());
+    if (*backend_enum == litert::lm::Backend::GPU) {
+      advanced_settings.allow_partial_gpu_delegation = true;
+    }
+    if (enable_speculative_decoding == JNI_TRUE) {
+      advanced_settings.enable_speculative_decoding = true;
+    }
+    settings->GetMutableMainExecutorSettings().SetAdvancedSettings(
+        advanced_settings);
+  }
+
+  const int benchmark_min_tokens = prefill_tokens + decode_tokens;
+  settings->GetMutableMainExecutorSettings().SetMaxNumTokens(
+      benchmark_min_tokens > 1024 ? benchmark_min_tokens : 1024);
+
+  auto& benchmark_params = settings->GetMutableBenchmarkParams();
+  benchmark_params.set_num_prefill_tokens(prefill_tokens);
+  benchmark_params.set_num_decode_tokens(decode_tokens);
+
+  auto engine = EngineFactory::CreateDefault(std::move(*settings));
+  if (!engine.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to create engine: " + engine.status().ToString());
+    return nullptr;
+  }
+
+  auto conversation = CreateUnityBridgeConversation(engine->get(), "");
+  if (!conversation.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to create benchmark conversation: " +
+                 conversation.status().ToString());
+    return nullptr;
+  }
+
+  auto response = (*conversation)->SendMessage(
+      MakeTextMessageJson("user", "Engine ignore this message in this mode."));
+  if (!response.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to run benchmark message: " + response.status().ToString());
+    return nullptr;
+  }
+
+  auto benchmark_info = (*conversation)->GetBenchmarkInfo();
+  if (!benchmark_info.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to get benchmark info: " +
+                 benchmark_info.status().ToString());
+    return nullptr;
+  }
+
+  return NewStringStandardUTF(env, FormatBenchmarkInfo(*benchmark_info));
+}

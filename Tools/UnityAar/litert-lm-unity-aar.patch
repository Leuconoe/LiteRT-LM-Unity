+        std::string("Only one of --") + std::string(flag_name) + " and --" +
+        std::string(flag_name) + "_file can be specified.");
+  }
+
+  if (!direct_value.empty()) {
+    return std::string(direct_value);
+  }
+
+  if (!file_path.empty()) {
+    return ReadTextFile(file_path);
+  }
+
+  return std::string();

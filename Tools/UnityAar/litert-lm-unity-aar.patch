+                  ", audioInput=" + std::to_string(binding.audio_input) +
+                  ", tokenInput=" + std::to_string(binding.token_input) +
+                  ", maskInput=" + std::to_string(binding.mask_input) +
+                  ", targetLength=" + std::to_string(binding.target_length));

+    public final double timeToFirstTokenInSecond;
+    public final int lastPrefillTokenCount;
+    public final int lastDecodeTokenCount;
+    public final double lastPrefillTokensPerSecond;
+    public final double lastDecodeTokensPerSecond;
+
+    public BenchmarkInfo(
+            double initTimeInSecond,
+            double timeToFirstTokenInSecond,
+            int lastPrefillTokenCount,
+            int lastDecodeTokenCount,
+            double lastPrefillTokensPerSecond,
+            double lastDecodeTokensPerSecond) {
+        this.initTimeInSecond = initTimeInSecond;
+        this.timeToFirstTokenInSecond = timeToFirstTokenInSecond;
+        this.lastPrefillTokenCount = lastPrefillTokenCount;
+        this.lastDecodeTokenCount = lastDecodeTokenCount;
+        this.lastPrefillTokensPerSecond = lastPrefillTokensPerSecond;
+        this.lastDecodeTokensPerSecond = lastDecodeTokensPerSecond;
+    }
+

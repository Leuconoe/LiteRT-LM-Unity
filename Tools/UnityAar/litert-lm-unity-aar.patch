+
+  private static native void nativeSetMinLogSeverity(int severity);
+
+  private static native String nativeRunBenchmark(
+      String modelPath,
+      String backend,
+      String cacheDir,
+      String nativeLibraryDir,
+      int prefillTokens,
+      int decodeTokens,
+      boolean enableSpeculativeDecoding);
+
+  private static native String nativeInspectLiteRtModel(String modelPath);
+
+  private static native String nativeRunParakeetAsrSmoke(
+      String modelPath, String audioPath, String tokenizerJsonPath, String backend);
+
+  private static native String nativeRunWhisperAsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language,
+      String vadMode,
+      String sileroModelPath);
+
+  private static native String nativeRunQwen3AsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language,
+      String vadMode,
+      String sileroModelPath);
+}

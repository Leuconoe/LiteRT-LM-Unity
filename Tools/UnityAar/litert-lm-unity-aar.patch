+template <typename T>
+absl::StatusOr<std::vector<T>> ReadTensorBufferVector(
+    ::litert::TensorBuffer& buffer) {
+  LITERT_ASSIGN_OR_RETURN(auto tensor_type, buffer.TensorType());
+  LITERT_ASSIGN_OR_RETURN(auto elements, tensor_type.Layout().NumElements());
+  std::vector<T> data(elements);
+  LITERT_RETURN_IF_ERROR(buffer.Read<T>(absl::MakeSpan(data)));
+  return data;
+}
+
+std::string DecodeParakeetTokens(const std::string& tokenizer_json_path,
+                                 const std::vector<int>& token_ids) {
+  auto tokenizer_data = ReadBinaryFile(tokenizer_json_path);
+  if (!tokenizer_data.ok()) {
+    return "";
+  }
+  auto tokenizer_json = nlohmann::json::parse(*tokenizer_data, nullptr, false);
+  if (tokenizer_json.is_discarded() || !tokenizer_json.contains("model") ||
+      !tokenizer_json["model"].contains("vocab")) {
+    return "";
+  }
+
+  std::vector<std::string> vocab(8193);
+  for (const auto& item : tokenizer_json["model"]["vocab"].items()) {
+    if (item.value().is_number_integer()) {
+      const int id = item.value().get<int>();
+      if (id >= 0 && id < static_cast<int>(vocab.size())) {
+        vocab[id] = item.key();
+      }
+    }
+  }
+
+  std::string text;
+  for (int token_id : token_ids) {
+    if (token_id < 0 || token_id >= static_cast<int>(vocab.size())) {
+      continue;
+    }
+    const std::string& token = vocab[token_id];
+    if (token.empty() || token[0] == '<') {
+      continue;
+    }
+    if (token == "▁") {
+      text += " ";
+    } else if (token.rfind("▁", 0) == 0) {
+      text += " ";
+      text += token.substr(std::string("▁").size());
+    } else {
+      text += token;
+    }
+  }
+  while (!text.empty() && text.front() == ' ') {
+    text.erase(text.begin());
+  }
+  return text;
+}
+
+std::vector<int> Gpt2ByteValues() {
+  std::vector<int> values;
+  for (int i = static_cast<int>('!'); i <= static_cast<int>('~'); ++i) {
+    values.push_back(i);
+  }
+  for (int i = 0xA1; i <= 0xAC; ++i) {
+    values.push_back(i);
+  }
+  for (int i = 0xAE; i <= 0xFF; ++i) {
+    values.push_back(i);
+  }
+  for (int i = 0; i < 256; ++i) {
+    if (std::find(values.begin(), values.end(), i) == values.end()) {
+      values.push_back(i);
+    }
+  }
+  return values;
+}
+
+std::unordered_map<uint32_t, uint8_t> CreateGpt2ByteDecoder() {
+  std::unordered_map<uint32_t, uint8_t> decoder;
+  const std::vector<int> bytes = Gpt2ByteValues();
+  int extra = 0;
+  for (int byte_value : bytes) {
+    uint32_t codepoint = 0;
+    if ((byte_value >= static_cast<int>('!') &&
+         byte_value <= static_cast<int>('~')) ||
+        (byte_value >= 0xA1 && byte_value <= 0xAC) ||
+        (byte_value >= 0xAE && byte_value <= 0xFF)) {
+      codepoint = static_cast<uint32_t>(byte_value);
+    } else {
+      codepoint = static_cast<uint32_t>(256 + extra);
+      ++extra;
+    }
+    decoder[codepoint] = static_cast<uint8_t>(byte_value);
+  }
+  return decoder;
+}
+
+bool ReadUtf8Codepoint(const std::string& text, size_t* index,
+                       uint32_t* codepoint, std::string* original_bytes) {
+  if (*index >= text.size()) {
+    return false;
+  }
+  const unsigned char first = static_cast<unsigned char>(text[*index]);
+  size_t length = 1;
+  uint32_t value = first;
+  if ((first & 0x80) == 0) {
+    length = 1;
+    value = first;
+  } else if ((first & 0xE0) == 0xC0) {
+    length = 2;
+    value = first & 0x1F;
+  } else if ((first & 0xF0) == 0xE0) {
+    length = 3;
+    value = first & 0x0F;
+  } else if ((first & 0xF8) == 0xF0) {
+    length = 4;
+    value = first & 0x07;
+  } else {
+    return false;
+  }
+  if (*index + length > text.size()) {
+    return false;
+  }
+  for (size_t i = 1; i < length; ++i) {
+    const unsigned char current =
+        static_cast<unsigned char>(text[*index + i]);
+    if ((current & 0xC0) != 0x80) {
+      return false;
+    }
+    value = (value << 6) | (current & 0x3F);
+  }
+  *codepoint = value;
+  *original_bytes = text.substr(*index, length);
+  *index += length;
+  return true;
+}
+
+std::string DecodeWhisperTokens(const std::string& tokenizer_json_path,
+                                const std::vector<int>& token_ids,
+                                int vocab_size) {
+  auto tokenizer_data = ReadBinaryFile(tokenizer_json_path);
+  if (!tokenizer_data.ok()) {
+    return "";
+  }
+  auto tokenizer_json = nlohmann::json::parse(*tokenizer_data, nullptr, false);
+  if (tokenizer_json.is_discarded() || !tokenizer_json.contains("model") ||
+      !tokenizer_json["model"].contains("vocab")) {
+    return "";
+  }
+
+  std::vector<std::string> vocab(vocab_size > 0 ? vocab_size : 51865);
+  for (const auto& item : tokenizer_json["model"]["vocab"].items()) {
+    if (item.value().is_number_integer()) {
+      const int id = item.value().get<int>();
+      if (id >= 0 && id < static_cast<int>(vocab.size())) {
+        vocab[id] = item.key();
+      }
+    }
+  }
+
+  if (tokenizer_json.contains("added_tokens") &&
+      tokenizer_json["added_tokens"].is_array()) {
+    for (const auto& item : tokenizer_json["added_tokens"]) {
+      if (item.contains("id") && item["id"].is_number_integer() &&
+          item.contains("content") && item["content"].is_string()) {
+        const int id = item["id"].get<int>();
+        if (id >= 0 && id < static_cast<int>(vocab.size())) {
+          vocab[id] = item["content"].get<std::string>();
+        }
+      }
+    }
+  }
+
+  const auto byte_decoder = CreateGpt2ByteDecoder();
+  std::string decoded_bytes;
+  for (int token_id : token_ids) {
+    if (token_id < 0 || token_id >= static_cast<int>(vocab.size())) {
+      continue;
+    }
+    const std::string& token = vocab[token_id];
+    if (token.empty() || token[0] == '<') {
+      continue;
+    }
+    size_t index = 0;
+    while (index < token.size()) {
+      uint32_t codepoint = 0;
+      std::string original;
+      if (!ReadUtf8Codepoint(token, &index, &codepoint, &original)) {
+        break;
+      }
+      const auto byte = byte_decoder.find(codepoint);
+      if (byte != byte_decoder.end()) {
+        decoded_bytes.push_back(static_cast<char>(byte->second));
+      } else {
+        decoded_bytes += original;
+      }
+    }
+  }
+  return decoded_bytes;
+}
+
+bool IsSuppressedWhisperToken(int token_id) {
+  if (token_id == 50257) {
+    return false;
+  }
+  return token_id >= 50258;
+}
+
+// Loads the Qwen3 ASR HF tokenizer.json vocab (151936 entries, GPT-2
+// byte-level like Whisper). Returns an empty vector on failure.
+std::vector<std::string> LoadQwen3AsrVocab(
+    const std::string& tokenizer_json_path) {
+  auto tokenizer_data = ReadBinaryFile(tokenizer_json_path);
+  if (!tokenizer_data.ok()) {
+    return {};
+  }
+  auto tokenizer_json = nlohmann::json::parse(*tokenizer_data, nullptr, false);
+  if (tokenizer_json.is_discarded() || !tokenizer_json.contains("model") ||
+      !tokenizer_json["model"].contains("vocab")) {
+    return {};
+  }
+
+  std::vector<std::string> vocab(151936);
+  for (const auto& item : tokenizer_json["model"]["vocab"].items()) {
+    if (item.value().is_number_integer()) {
+      const int id = item.value().get<int>();
+      if (id >= 0 && id < static_cast<int>(vocab.size())) {
+        vocab[id] = item.key();
+      }
+    }
+  }
+
+  if (tokenizer_json.contains("added_tokens") &&
+      tokenizer_json["added_tokens"].is_array()) {
+    for (const auto& item : tokenizer_json["added_tokens"]) {
+      if (item.contains("id") && item["id"].is_number_integer() &&
+          item.contains("content") && item["content"].is_string()) {
+        const int id = item["id"].get<int>();
+        if (id >= 0 && id < static_cast<int>(vocab.size())) {
+          vocab[id] = item["content"].get<std::string>();
+        }
+      }
+    }
+  }
+  return vocab;
+}
+
+std::string DecodeQwen3AsrTokens(const std::vector<std::string>& vocab,
+                                 const std::vector<int>& token_ids) {
+  constexpr int kFirstSpecialToken = 151643;  // <|endoftext|> and above.
+  const auto byte_decoder = CreateGpt2ByteDecoder();
+  std::string decoded_bytes;
+  for (int token_id : token_ids) {
+    if (token_id < 0 || token_id >= static_cast<int>(vocab.size()) ||
+        token_id >= kFirstSpecialToken) {
+      continue;
+    }
+    const std::string& token = vocab[token_id];
+    if (token.empty() || token[0] == '<') {
+      continue;
+    }
+    size_t index = 0;
+    while (index < token.size()) {
+      uint32_t codepoint = 0;
+      std::string original;
+      if (!ReadUtf8Codepoint(token, &index, &codepoint, &original)) {
+        break;
+      }
+      const auto byte = byte_decoder.find(codepoint);
+      if (byte != byte_decoder.end()) {
+        decoded_bytes.push_back(static_cast<char>(byte->second));
+      } else {
+        decoded_bytes += original;
+      }
+    }
+  }
+  return decoded_bytes;
+}
+
+nlohmann::ordered_json RunParakeetAsrSmokeToJson(
+    const std::string& model_path, const std::string& audio_path,
+    const std::string& tokenizer_json_path, const std::string& backend) {
+  nlohmann::ordered_json result;
+  result["modelPath"] = model_path;
+  result["audioPath"] = audio_path;
+  result["tokenizerJsonPath"] = tokenizer_json_path;
+  result["backendRequested"] = backend;
+  result["success"] = false;
+
+  int pcm_sample_count = 0;
+  int valid_feature_frames = 0;
+  auto feature_result = CreateParakeetInputFeatures(
+      audio_path, &pcm_sample_count, &valid_feature_frames);
+  if (!feature_result.ok()) {
+    result["error"] = std::string(feature_result.status().message());
+    return result;
+  }
+  result["pcmSamples"] = pcm_sample_count;
+  result["audioSeconds"] = pcm_sample_count / 16000.0;
+  result["validFeatureFrames"] = valid_feature_frames;
+
+  auto started = absl::Now();
+  auto env_or = ::litert::Environment::Create({});
+  if (!env_or.HasValue()) {
+    result["error"] = env_or.Error().Message();
+    return result;
+  }
+  auto env = std::move(env_or.Value());
+  auto options_or = ::litert::Options::Create();
+  if (!options_or.HasValue()) {
+    result["error"] = options_or.Error().Message();
+    return result;
+  }
+  auto options = std::move(options_or.Value());
+  auto cpu_options = options.GetCpuOptions();
+  if (cpu_options.HasValue()) {
+    cpu_options->SetNumThreads(4);
+  }
+  std::string normalized_backend = backend;
+  std::transform(normalized_backend.begin(), normalized_backend.end(),
+                 normalized_backend.begin(),
+                 [](unsigned char c) { return std::toupper(c); });
+  const bool use_gpu = normalized_backend.rfind("GPU", 0) == 0;
+  if (use_gpu) {
+    auto gpu_options = options.GetGpuOptions();
+    if (!gpu_options.HasValue()) {
+      result["error"] = gpu_options.Error().Message();
+      return result;
+    }
+    const bool use_fp16 = normalized_backend.find("FP16") != std::string::npos;
+    const bool use_texture_weights =
+        normalized_backend.find("NO_TEXTURE") == std::string::npos;
+    const bool convert_weights_on_gpu =
+        normalized_backend.find("NO_CONVERT") == std::string::npos;
+    const bool relaxed_delegation =
+        normalized_backend.find("RELAXED") != std::string::npos;
+
+    gpu_options->SetPrecision(use_fp16 ? ::litert::GpuOptions::Precision::kFp16
+                                       : ::litert::GpuOptions::Precision::kFp32);
+    gpu_options->EnableConstantTensorSharing(true);
+#if !defined(__APPLE__)
+    gpu_options->SetPreferTextureWeights(use_texture_weights);
+#endif
+    gpu_options->SetMadviseOriginalSharedTensors(true);
+    gpu_options->SetConvertWeightsOnGpu(convert_weights_on_gpu);
+    if (!relaxed_delegation) {
+      gpu_options->SetHintFullyDelegatedToSingleDelegate(true);
+    }
+    gpu_options->EnableInfiniteFloatCapping(true);
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kGpu);
+    result["backendUsed"] = normalized_backend;
+    result["gpuPrecision"] = use_fp16 ? "fp16" : "fp32";
+    result["gpuPreferTextureWeights"] = use_texture_weights;
+    result["gpuConvertWeightsOnGpu"] = convert_weights_on_gpu;
+    result["gpuRelaxedDelegation"] = relaxed_delegation;
+  } else {
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kCpu);
+    result["backendUsed"] = "CPU";
+  }
+
+  auto compiled_model_or =
+      ::litert::CompiledModel::Create(env, model_path, options);
+  if (!compiled_model_or.HasValue()) {
+    result["error"] = compiled_model_or.Error().Message();
+    return result;
+  }
+  auto compiled_model = std::move(compiled_model_or.Value());
+  result["compileSeconds"] = absl::ToDoubleSeconds(absl::Now() - started);
+
+  auto& encode_model = compiled_model;
+  auto& decode_model = compiled_model;
+
+  auto encode_index_or = encode_model.GetSignatureIndex("encode");
+  if (!encode_index_or.HasValue()) {
+    result["error"] = encode_index_or.Error().Message();
+    return result;
+  }
+  auto decode_index_or = decode_model.GetSignatureIndex("decode");
+  if (!decode_index_or.HasValue()) {
+    result["error"] = decode_index_or.Error().Message();
+    return result;
+  }
+  const int encode_index = encode_index_or.Value();
+  const int decode_index = decode_index_or.Value();
+
+  auto encode_started = absl::Now();
+  auto encode_inputs_or = compiled_model.CreateInputBuffers(encode_index);
+  if (!encode_inputs_or.HasValue()) {
+    result["error"] = encode_inputs_or.Error().Message();
+    return result;
+  }
+  auto encode_inputs = std::move(encode_inputs_or.Value());
+  auto encode_outputs_or = compiled_model.CreateOutputBuffers(encode_index);
+  if (!encode_outputs_or.HasValue()) {
+    result["error"] = encode_outputs_or.Error().Message();
+    return result;
+  }
+  auto encode_outputs = std::move(encode_outputs_or.Value());
+  auto encode_write_status =
+      encode_inputs[0].Write<float>(absl::MakeSpan(*feature_result));
+  if (!encode_write_status.HasValue()) {
+    result["error"] = encode_write_status.Error().Message();
+    return result;
+  }
+  auto encode_status =
+      compiled_model.Run(encode_index, encode_inputs, encode_outputs);
+  if (!encode_status.HasValue()) {
+    result["error"] = encode_status.Error().Message();
+    return result;
+  }
+  auto encoder_output_or = ReadTensorBufferVector<float>(encode_outputs[0]);
+  if (!encoder_output_or.ok()) {
+    result["error"] = std::string(encoder_output_or.status().message());
+    return result;
+  }
+  auto encoder_output = std::move(*encoder_output_or);
+  result["encodeSeconds"] = absl::ToDoubleSeconds(absl::Now() - encode_started);
+  result["encoderOutputValues"] = encoder_output.size();
+
+  constexpr int kEncodedFrames = 63;
+  constexpr int kTargetLength = 64;
+  constexpr int kVocabSize = 8193;
+  constexpr int kBlankToken = 8192;
+  constexpr int kOutputClasses = 8198;
+  constexpr int kStateValues = 2 * 1 * 640;
+  const int durations[5] = {0, 1, 2, 3, 4};
+
+  std::vector<int32_t> target(kTargetLength, kBlankToken);
+  std::vector<float> state_1(kStateValues, 0.0f);
+  std::vector<float> state_2(kStateValues, 0.0f);
+  std::vector<int> token_ids;
+  int time_index = 0;
+  int decode_steps = 0;
+  auto decode_started = absl::Now();
+
+  while (time_index < kEncodedFrames &&
+         token_ids.size() < static_cast<size_t>(kTargetLength)) {
+    int symbols_added = 0;
+    int last_skip = 1;
+    bool need_loop = true;
+    while (need_loop && symbols_added < 10 &&
+           token_ids.size() < static_cast<size_t>(kTargetLength)) {
+      auto decode_inputs_or = compiled_model.CreateInputBuffers(decode_index);
+      if (!decode_inputs_or.HasValue()) {
+        result["error"] = decode_inputs_or.Error().Message();
+        return result;
+      }
+      auto decode_inputs = std::move(decode_inputs_or.Value());
+      auto decode_outputs_or = compiled_model.CreateOutputBuffers(decode_index);
+      if (!decode_outputs_or.HasValue()) {
+        result["error"] = decode_outputs_or.Error().Message();
+        return result;
+      }
+      auto decode_outputs = std::move(decode_outputs_or.Value());
+      target[0] = token_ids.empty() ? kBlankToken : token_ids.back();
+      auto write_status =
+          decode_inputs[0].Write<float>(absl::MakeSpan(encoder_output));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status = decode_inputs[1].Write<int32_t>(absl::MakeSpan(target));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status = decode_inputs[2].Write<float>(absl::MakeSpan(state_1));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status = decode_inputs[3].Write<float>(absl::MakeSpan(state_2));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      auto decode_status =
+          compiled_model.Run(decode_index, decode_inputs, decode_outputs);
+      if (!decode_status.HasValue()) {
+        result["error"] = decode_status.Error().Message();
+        return result;
+      }
+      auto logits_or = ReadTensorBufferVector<float>(decode_outputs[0]);
+      if (!logits_or.ok()) {
+        result["error"] = std::string(logits_or.status().message());
+        return result;
+      }
+      auto logits = std::move(*logits_or);
+      auto state_1_or = ReadTensorBufferVector<float>(decode_outputs[1]);
+      if (!state_1_or.ok()) {
+        result["error"] = std::string(state_1_or.status().message());
+        return result;
+      }
+      state_1 = std::move(*state_1_or);
+      auto state_2_or = ReadTensorBufferVector<float>(decode_outputs[2]);
+      if (!state_2_or.ok()) {
+        result["error"] = std::string(state_2_or.status().message());
+        return result;
+      }
+      state_2 = std::move(*state_2_or);
+
+      const size_t offset =
+          (static_cast<size_t>(time_index) * kTargetLength) * kOutputClasses;
+      int best_token = 0;
+      float best_token_score = logits[offset];
+      for (int i = 1; i < kVocabSize; ++i) {
+        if (logits[offset + i] > best_token_score) {
+          best_token_score = logits[offset + i];
+          best_token = i;
+        }
+      }
+      int best_duration = 0;
+      float best_duration_score = logits[offset + kVocabSize];
+      for (int i = 1; i < 5; ++i) {
+        if (logits[offset + kVocabSize + i] > best_duration_score) {
+          best_duration_score = logits[offset + kVocabSize + i];
+          best_duration = i;
+        }
+      }
+      const int skip = durations[best_duration];
+      last_skip = skip;
+      if (best_token != kBlankToken) {
+        token_ids.push_back(best_token);
+      }
+      ++symbols_added;
+      ++decode_steps;
+      time_index += skip;
+      need_loop = skip == 0;
+    }
+    if (last_skip == 0) {
+      ++time_index;
+    }
+    if (symbols_added == 10) {
+      ++time_index;
+    }
+  }
+
+  result["decodeSeconds"] = absl::ToDoubleSeconds(absl::Now() - decode_started);
+  result["decodeSteps"] = decode_steps;
+  result["tokenCount"] = token_ids.size();
+  result["tokenIds"] = token_ids;
+  result["transcriptCandidate"] =
+      DecodeParakeetTokens(tokenizer_json_path, token_ids);
+  if (token_ids.empty()) {
+    result["error"] = "No ASR tokens were decoded.";
+    return result;
+  }
+  result["success"] = true;
+  return result;
+}
+
+// Which decode-signature input receives the encoder output (audio embeds),
+// the token ids and the causal mask. Whisper tflite exports do NOT order
+// these inputs consistently — tiny/base export (audio, tokens, mask) while
+// large-v3-turbo exports (mask, tokens, audio) — so positional binding feeds
+// the 1500x1280 encoder output into the 128x128 mask buffer
+// ("TensorBuffer host memory buffer size is smaller than the given data
+// size, 65536 vs 7680000").
+struct WhisperDecodeBinding {
+  int audio_input = 0;
+  int token_input = 1;
+  int mask_input = 2;
+  int target_length = 128;
+  std::string strategy = "positional";
+};
+
+// Resolves the decode input binding from the model's "decode" signature.
+// Strategy order:
+// 1. "name": signature input names contain mask/token/audio-embed keywords.
+// 2. "shape": int32/int64 tensor -> tokens; of the float32 tensors, the one
+//    with more elements -> audio embeds (e.g. 1500x1280), the smaller one
+//    -> causal mask (e.g. 128x128).
+// 3. "positional": legacy order (audio, tokens, mask) as a last resort.
+WhisperDecodeBinding ResolveWhisperDecodeBinding(LiteRtEnvironment env,
+                                                 const std::string& model_path) {
+  WhisperDecodeBinding binding;
+  LiteRtModel model = nullptr;
+  if (LiteRtCreateModelFromFile(env, model_path.c_str(), &model) !=
+          kLiteRtStatusOk ||
+      model == nullptr) {
+    UnityAsrLog("Whisper ASR decode binding: model load failed; "
+                "using positional binding.");
+    return binding;
+  }
+
+  struct DecodeInputInfo {
+    std::string lower_name;
+    LiteRtElementType element_type = kLiteRtElementTypeNone;
+    std::vector<int64_t> dims;
+    int64_t element_count = 0;
+  };
+  std::vector<DecodeInputInfo> inputs;
+
+  LiteRtParamIndex num_signatures = 0;
+  if (LiteRtGetNumModelSignatures(model, &num_signatures) == kLiteRtStatusOk) {
+    for (LiteRtParamIndex i = 0; i < num_signatures; ++i) {
+      LiteRtSignature signature = nullptr;
+      if (LiteRtGetModelSignature(model, i, &signature) != kLiteRtStatusOk) {
+        continue;
+      }
+      const char* signature_key = nullptr;
+      if (LiteRtGetSignatureKey(signature, &signature_key) != kLiteRtStatusOk ||
+          signature_key == nullptr ||
+          std::string(signature_key) != "decode") {
+        continue;
+      }
+      LiteRtParamIndex num_inputs = 0;
+      if (LiteRtGetNumSignatureInputs(signature, &num_inputs) !=
+          kLiteRtStatusOk) {
+        break;
+      }
+      for (LiteRtParamIndex input_index = 0; input_index < num_inputs;
+           ++input_index) {
+        DecodeInputInfo info;
+        const char* input_name = nullptr;
+        if (LiteRtGetSignatureInputName(signature, input_index, &input_name) ==
+                kLiteRtStatusOk &&
+            input_name != nullptr) {
+          info.lower_name = input_name;
+          std::transform(info.lower_name.begin(), info.lower_name.end(),
+                         info.lower_name.begin(),
+                         [](unsigned char c) { return std::tolower(c); });
+        }
+        LiteRtTensor tensor = nullptr;
+        if (LiteRtGetSignatureInputTensorByIndex(signature, input_index,
+                                                 &tensor) == kLiteRtStatusOk &&
+            tensor != nullptr) {
+          LiteRtTensorTypeId type_id;
+          if (LiteRtGetTensorTypeId(tensor, &type_id) == kLiteRtStatusOk &&
+              type_id == kLiteRtRankedTensorType) {
+            LiteRtRankedTensorType tensor_type;
+            if (LiteRtGetRankedTensorType(tensor, &tensor_type) ==
+                kLiteRtStatusOk) {
+              info.element_type = tensor_type.element_type;
+              info.element_count = 1;
+              for (int d = 0; d < tensor_type.layout.rank; ++d) {
+                const int64_t dim = tensor_type.layout.dimensions[d];
+                info.dims.push_back(dim);
+                if (dim > 0) {
+                  info.element_count *= dim;
+                }
+              }
+            }
+          }
+        }
+        inputs.push_back(std::move(info));
+      }
+      break;
+    }
+  }
+  LiteRtDestroyModel(model);
+
+  if (inputs.size() != 3) {
+    UnityAsrLog("Whisper ASR decode binding: expected 3 decode inputs, got " +
+                std::to_string(inputs.size()) + "; using positional binding.");
+    return binding;
+  }
+
+  auto find_by_keywords =
+      [&inputs](std::initializer_list<const char*> keywords) -> int {
+    int found = -1;
+    for (size_t i = 0; i < inputs.size(); ++i) {
+      for (const char* keyword : keywords) {
+        if (!inputs[i].lower_name.empty() &&
+            inputs[i].lower_name.find(keyword) != std::string::npos) {
+          if (found >= 0) {
+            return -1;  // Ambiguous.
+          }
+          found = static_cast<int>(i);
+          break;
+        }
+      }
+    }
+    return found;
+  };
+
+  // 1. Name-based resolution.
+  const int name_mask = find_by_keywords({"mask"});
+  const int name_tokens = find_by_keywords({"token", "ids"});
+  const int name_audio =
+      find_by_keywords({"audio", "encoder", "embed", "hidden", "encode"});
+  if (name_mask >= 0 && name_tokens >= 0 && name_audio >= 0 &&
+      name_mask != name_tokens && name_mask != name_audio &&
+      name_tokens != name_audio) {
+    binding.audio_input = name_audio;
+    binding.token_input = name_tokens;
+    binding.mask_input = name_mask;
+    binding.strategy = "name";
+  } else {
+    // 2. Shape/dtype-based resolution.
+    int shape_tokens = -1;
+    std::vector<int> float_inputs;
+    for (size_t i = 0; i < inputs.size(); ++i) {
+      if (inputs[i].element_type == kLiteRtElementTypeInt32 ||
+          inputs[i].element_type == kLiteRtElementTypeInt64) {
+        if (shape_tokens >= 0) {
+          shape_tokens = -1;  // Ambiguous.
+          break;
+        }
+        shape_tokens = static_cast<int>(i);
+      } else if (inputs[i].element_type == kLiteRtElementTypeFloat32) {
+        float_inputs.push_back(static_cast<int>(i));
+      }
+    }
+    if (shape_tokens >= 0 && float_inputs.size() == 2 &&
+        inputs[float_inputs[0]].element_count !=
+            inputs[float_inputs[1]].element_count) {
+      const bool first_is_audio = inputs[float_inputs[0]].element_count >
+                                  inputs[float_inputs[1]].element_count;
+      binding.token_input = shape_tokens;
+      binding.audio_input = first_is_audio ? float_inputs[0] : float_inputs[1];
+      binding.mask_input = first_is_audio ? float_inputs[1] : float_inputs[0];
+      binding.strategy = "shape";
+    } else {
+      UnityAsrLog("Whisper ASR decode binding: name and shape classification "
+                  "inconclusive; using positional binding.");
+    }
+  }
+
+  // Decode sequence length from the tokens tensor (e.g. [1, 128]).
+  const auto& token_dims = inputs[binding.token_input].dims;
+  if (!token_dims.empty() && token_dims.back() > 1 &&
+      token_dims.back() <= 4096) {
+    binding.target_length = static_cast<int>(token_dims.back());
+  }
+  return binding;
+}
+
+nlohmann::ordered_json RunWhisperAsrSmokeToJson(
+    const std::string& model_path, const std::string& audio_path,
+    const std::string& tokenizer_json_path, const std::string& backend,
+    const std::string& language) {
+  UnityAsrLog("Whisper ASR native start: backend=" + backend +
+              ", language=" + language);
+  nlohmann::ordered_json result;
+  result["modelPath"] = model_path;
+  result["audioPath"] = audio_path;
+  result["tokenizerJsonPath"] = tokenizer_json_path;
+  result["backendRequested"] = backend;
+  std::string normalized_language = language;
+  std::transform(normalized_language.begin(), normalized_language.end(),
+                 normalized_language.begin(),
+                 [](unsigned char c) { return std::tolower(c); });
+  if (normalized_language.empty()) {
+    normalized_language = "auto";
+  }
+  if (normalized_language != "auto" && normalized_language != "ko" &&
+      normalized_language != "en") {
+    result["error"] =
+        "Unsupported Whisper ASR language: " + normalized_language +
+        ". Supported values are auto, ko and en.";

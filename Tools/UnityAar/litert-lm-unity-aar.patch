+      AudioExecutorSettings::CreateDefault(model_assets, 10, Backend::CPU));
+  EXPECT_EQ(settings.GetNumThreads(), 4);
+  settings.SetNumThreads(8);
+  EXPECT_EQ(settings.GetNumThreads(), 8);
+}

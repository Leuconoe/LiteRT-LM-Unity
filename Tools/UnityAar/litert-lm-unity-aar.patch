+LITERTLM_JNIEXPORT void JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeResetConversation(
+    JNIEnv* env, jclass thiz, jlong bridge_pointer, jstring system_instruction) {
+  auto* context = reinterpret_cast<UnityBridgeContext*>(bridge_pointer);
+  if (context == nullptr || context->engine == nullptr) {
+    ThrowLiteRtLmJniException(env, "Unity bridge is not initialized.");
+    return;
+  }
+
+  context->system_instruction = JStringToStdString(env, system_instruction);
+  context->conversation.reset();
+  auto conversation =
+      CreateUnityBridgeConversation(context->engine.get(), context->system_instruction);
+  if (!conversation.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to reset conversation: " + conversation.status().ToString());
+    return;
+  }
+
+  context->conversation = std::move(*conversation);
+}

+#include <android/log.h>
+#include <dlfcn.h>
+#include <jni.h>
+
+#include <string>
+
+namespace {
+
+constexpr char kLogTag[] = "LiteRT-LM-Loader";
+
+std::string GetCurrentLibraryDirectory() {
+  Dl_info info;
+  if (dladdr(reinterpret_cast<void*>(&GetCurrentLibraryDirectory), &info) == 0 ||
+      info.dli_fname == nullptr) {
+    return "";
+  }
+
+  std::string path(info.dli_fname);
+  const std::size_t slash = path.find_last_of('/');
+  if (slash == std::string::npos) {
+    return "";
+  }
+
+  return path.substr(0, slash);
+}
+
+bool LoadLibraryGlobally(const std::string& library_dir,
+                         const char* library_name, bool required = true) {
+  const std::string library_path = library_dir.empty()
+                                       ? library_name
+                                       : library_dir + "/" + library_name;
+  void* handle = dlopen(library_path.c_str(), RTLD_NOW | RTLD_GLOBAL);
+  if (handle == nullptr) {
+    __android_log_print(required ? ANDROID_LOG_WARN : ANDROID_LOG_INFO, kLogTag,
+                        "Failed to preload %s globally: %s", library_name,
+                        dlerror());
+    return false;
+  }
+
+  __android_log_print(ANDROID_LOG_INFO, kLogTag, "Loaded %s globally: %s",
+                      library_name, library_path.c_str());
+  return true;
+}
+
+void LoadLiteRtLmLibrariesGlobally() {
+  const std::string library_dir = GetCurrentLibraryDirectory();
+  LoadLibraryGlobally(library_dir, "libLiteRt.so");
+  LoadLibraryGlobally(library_dir, "libLiteRtTopKOpenClSampler.so",
+                      /*required=*/false);
+  LoadLibraryGlobally(library_dir, "libLiteRtTopKWebGpuSampler.so",
+                      /*required=*/false);
+  LoadLibraryGlobally(library_dir, "liblitertlm_jni.so");
+}
+
+}  // namespace
+
+extern "C" JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM* vm, void* reserved) {
+  LoadLiteRtLmLibrariesGlobally();
+  return JNI_VERSION_1_6;
+}

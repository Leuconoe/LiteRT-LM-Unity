+absl::StatusOr<std::string> ReadTextFile(absl::string_view file_path) {
+  std::ifstream file{std::string(file_path)};
+  if (!file.is_open()) {
+    return absl::InvalidArgumentError(
+        std::string("Could not open file: ") + std::string(file_path));
+  }
+
+  std::stringstream buffer;
+  buffer << file.rdbuf();
+  return buffer.str();

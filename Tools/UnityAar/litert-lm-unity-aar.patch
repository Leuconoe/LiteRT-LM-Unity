+LITERTLM_JNIEXPORT jlong JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeCreateBridge(
+    JNIEnv* env, jclass thiz, jstring model_path, jstring backend,
+    jstring cache_dir, jstring native_library_dir, jint max_num_tokens,
+    jint max_num_images, jint cpu_threads, jboolean enable_speculative_decoding,
+    jstring system_instruction) {
+  const std::string model_path_str = JStringToStdString(env, model_path);
+  if (model_path_str.empty()) {
+    ThrowLiteRtLmJniException(env, "modelPath is required.");

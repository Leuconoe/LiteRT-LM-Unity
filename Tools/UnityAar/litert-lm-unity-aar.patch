@@ -0,0 +1,73 @@
+param(
+    [string]$ImageName = "litert-lm-android-builder",
+    [string]$ArtifactDir = "",
+    [string]$UnityPluginsDir = "",
+    [switch]$SkipImageBuild,
+    [string]$ReuseContainer = "",
+    [switch]$SyncWorktree,
+    [switch]$SyncOnly,
+    [switch]$PackageOnly,
+    [string]$ReuseAar = "",
+    [string]$BazelJobs = "",
+    [Parameter(ValueFromRemainingArguments = $true)]
+    [string[]]$ExtraArgs
+)
+
+$ErrorActionPreference = "Stop"
+
+$BashScript = Join-Path $PSScriptRoot "build_unity_aar.sh"
+if (!(Test-Path $BashScript)) {
+    throw "Missing bash build script: $BashScript"
+}
+
+$BashCandidates = @(
+    "C:\Program Files\Git\bin\bash.exe",
+    "C:\Program Files\Git\usr\bin\bash.exe"
+)
+$BashPath = $BashCandidates | Where-Object { Test-Path $_ } | Select-Object -First 1
+if ([string]::IsNullOrWhiteSpace($BashPath)) {
+    $Command = Get-Command bash -ErrorAction SilentlyContinue
+    if ($Command) {
+        $BashPath = $Command.Source
+    }
+}
+if ([string]::IsNullOrWhiteSpace($BashPath)) {
+    throw "bash was not found. Install Git for Windows or run tools/docker/build_unity_aar.sh from an existing bash shell."
+}
+
+$Arguments = @($BashScript, "--image-name", $ImageName)
+if (![string]::IsNullOrWhiteSpace($ArtifactDir)) {
+    $Arguments += @("--artifact-dir", $ArtifactDir)
+}
+if (![string]::IsNullOrWhiteSpace($UnityPluginsDir)) {
+    $Arguments += @("--unity-plugins-dir", $UnityPluginsDir)
+}
+if ($SkipImageBuild) {
+    $Arguments += "--skip-image-build"
+}
+if (![string]::IsNullOrWhiteSpace($ReuseContainer)) {
+    $Arguments += @("--reuse-container", $ReuseContainer)
+}
+if ($SyncWorktree) {
+    $Arguments += "--sync-worktree"
+}
+if ($SyncOnly) {
+    $Arguments += "--sync-only"
+}
+if ($PackageOnly) {
+    $Arguments += "--package-only"
+}
+if (![string]::IsNullOrWhiteSpace($ReuseAar)) {
+    $Arguments += @("--reuse-aar", $ReuseAar)
+}
+if (![string]::IsNullOrWhiteSpace($BazelJobs)) {
+    $Arguments += @("--bazel-jobs", $BazelJobs)
+}
+if ($ExtraArgs -and $ExtraArgs.Count -gt 0) {
+    $Arguments += $ExtraArgs
+}
+
+& $BashPath @Arguments
+if ($LASTEXITCODE -ne 0) {
+    throw "Bash Unity AAR build failed with exit code $LASTEXITCODE."
+}

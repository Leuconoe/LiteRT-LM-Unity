+std::string LiteRtStatusToString(LiteRtStatus status) {
+  const char* status_string = LiteRtGetStatusString(status);
+  if (status_string == nullptr) {
+    return "LiteRtStatus(" + std::to_string(static_cast<int>(status)) + ")";
+  }
+  return std::string(status_string) + " (" +
+         std::to_string(static_cast<int>(status)) + ")";
+}
+
+nlohmann::ordered_json TensorInfoToJson(LiteRtTensor tensor) {
+  nlohmann::ordered_json result;
+  LiteRtTensorTypeId type_id;
+  LiteRtStatus status = LiteRtGetTensorTypeId(tensor, &type_id);
+  if (status != kLiteRtStatusOk) {
+    result["error"] = LiteRtStatusToString(status);
+    return result;
+  }
+
+  if (type_id == kLiteRtUnrankedTensorType) {
+    LiteRtUnrankedTensorType tensor_type;
+    status = LiteRtGetUnrankedTensorType(tensor, &tensor_type);
+    if (status != kLiteRtStatusOk) {
+      result["error"] = LiteRtStatusToString(status);
+      return result;
+    }
+    result["ranked"] = false;
+    result["elementType"] = ElementTypeToString(tensor_type.element_type);
+    return result;
+  }
+
+  LiteRtRankedTensorType tensor_type;
+  status = LiteRtGetRankedTensorType(tensor, &tensor_type);
+  if (status != kLiteRtStatusOk) {
+    result["error"] = LiteRtStatusToString(status);
+    return result;
+  }
+  result["ranked"] = true;
+  result["elementType"] = ElementTypeToString(tensor_type.element_type);
+  result["shape"] = nlohmann::ordered_json::array();
+  for (int i = 0; i < tensor_type.layout.rank; ++i) {
+    result["shape"].push_back(tensor_type.layout.dimensions[i]);
+  }
+  return result;
+}
+
+nlohmann::ordered_json InspectLiteRtModelToJson(const std::string& model_path) {
+  nlohmann::ordered_json result;
+  result["modelPath"] = model_path;
+  result["exists"] = false;
+  result["loaded"] = false;
+
+  struct stat buffer;
+  if (stat(model_path.c_str(), &buffer) != 0) {
+    result["error"] = "Model file not found.";
+    return result;
+  }
+  result["exists"] = true;
+  result["fileSizeBytes"] = static_cast<long long>(buffer.st_size);
+
+  LiteRtModel model = nullptr;
+  LiteRtStatus status = LiteRtCreateModelFromFile(model_path.c_str(), &model);
+  if (status != kLiteRtStatusOk) {
+    result["error"] = LiteRtStatusToString(status);
+    return result;
+  }
+  result["loaded"] = true;
+
+  LiteRtParamIndex num_signatures = 0;
+  status = LiteRtGetNumModelSignatures(model, &num_signatures);
+  if (status != kLiteRtStatusOk) {
+    result["error"] = LiteRtStatusToString(status);
+    LiteRtDestroyModel(model);
+    return result;
+  }
+  result["numSignatures"] = num_signatures;
+  result["signatures"] = nlohmann::ordered_json::array();
+
+  for (LiteRtParamIndex i = 0; i < num_signatures; ++i) {
+    LiteRtSignature signature = nullptr;
+    status = LiteRtGetModelSignature(model, i, &signature);
+    if (status != kLiteRtStatusOk) {
+      nlohmann::ordered_json signature_error;
+      signature_error["index"] = i;
+      signature_error["error"] = LiteRtStatusToString(status);
+      result["signatures"].push_back(signature_error);
+      continue;
+    }
+
+    nlohmann::ordered_json signature_json;
+    signature_json["index"] = i;
+    const char* signature_key = nullptr;
+    status = LiteRtGetSignatureKey(signature, &signature_key);
+    signature_json["key"] =
+        status == kLiteRtStatusOk && signature_key != nullptr
+            ? std::string(signature_key)
+            : "";
+    signature_json["inputs"] = nlohmann::ordered_json::array();
+
+    LiteRtParamIndex num_inputs = 0;
+    status = LiteRtGetNumSignatureInputs(signature, &num_inputs);
+    if (status == kLiteRtStatusOk) {
+      for (LiteRtParamIndex input_index = 0; input_index < num_inputs;
+           ++input_index) {
+        const char* input_name = nullptr;
+        LiteRtTensor tensor = nullptr;
+        nlohmann::ordered_json input_json;
+        status = LiteRtGetSignatureInputName(signature, input_index,
+                                             &input_name);
+        input_json["name"] =
+            status == kLiteRtStatusOk && input_name != nullptr
+                ? std::string(input_name)
+                : "";
+        status =
+            LiteRtGetSignatureInputTensorByIndex(signature, input_index,
+                                                 &tensor);
+        if (status == kLiteRtStatusOk && tensor != nullptr) {
+          input_json["tensor"] = TensorInfoToJson(tensor);
+        } else {
+          input_json["error"] = LiteRtStatusToString(status);
+        }
+        signature_json["inputs"].push_back(input_json);
+      }
+    } else {
+      nlohmann::ordered_json input_json;
+      input_json["error"] = LiteRtStatusToString(status);
+      signature_json["inputs"].push_back(input_json);
+    }
+
+    signature_json["outputs"] = nlohmann::ordered_json::array();
+
+    LiteRtParamIndex num_outputs = 0;
+    status = LiteRtGetNumSignatureOutputs(signature, &num_outputs);
+    if (status == kLiteRtStatusOk) {
+      for (LiteRtParamIndex output_index = 0; output_index < num_outputs;
+           ++output_index) {
+        const char* output_name = nullptr;
+        LiteRtTensor tensor = nullptr;
+        nlohmann::ordered_json output_json;
+        status = LiteRtGetSignatureOutputName(signature, output_index,
+                                              &output_name);
+        output_json["name"] =
+            status == kLiteRtStatusOk && output_name != nullptr
+                ? std::string(output_name)
+                : "";
+        status =
+            LiteRtGetSignatureOutputTensorByIndex(signature, output_index,
+                                                  &tensor);
+        if (status == kLiteRtStatusOk && tensor != nullptr) {
+          output_json["tensor"] = TensorInfoToJson(tensor);
+        } else {
+          output_json["error"] = LiteRtStatusToString(status);
+        }
+        signature_json["outputs"].push_back(output_json);
+      }
+    } else {
+      nlohmann::ordered_json output_json;
+      output_json["error"] = LiteRtStatusToString(status);
+      signature_json["outputs"].push_back(output_json);
+    }
+
+    result["signatures"].push_back(signature_json);
+  }
+
+  LiteRtDestroyModel(model);
+  return result;
+}
+
+absl::StatusOr<std::string> ReadBinaryFile(const std::string& path) {
+  std::ifstream stream(path, std::ios::binary);
+  if (!stream) {
+    return absl::NotFoundError(absl::StrCat("Failed to open file: ", path));
+  }
+  stream.seekg(0, std::ios::end);
+  const std::streamoff size = stream.tellg();
+  if (size < 0) {
+    return absl::InternalError(absl::StrCat("Failed to read size: ", path));
+  }
+  std::string data(static_cast<size_t>(size), '\0');
+  stream.seekg(0, std::ios::beg);
+  if (!data.empty()) {
+    stream.read(data.data(), size);
+  }
+  if (!stream) {
+    return absl::InternalError(absl::StrCat("Failed to read file: ", path));
+  }
+  return data;
+}
+
+std::vector<float> HannWindow(int length) {
+  std::vector<float> window(length);
+  for (int i = 0; i < length; ++i) {
+    window[i] =
+        0.5f - 0.5f * std::cos(2.0f * static_cast<float>(M_PI) * i /
+                               static_cast<float>(length - 1));
+  }
+  return window;
+}
+
+double HzToSlaneyMel(double hz) {
+  constexpr double kMinLogHz = 1000.0;
+  constexpr double kMinLogMel = 15.0;
+  constexpr double kLogStep = 0.06875177742094912;  // log(6.4) / 27
+  if (hz < kMinLogHz) {
+    return hz / (200.0 / 3.0);
+  }
+  return kMinLogMel + std::log(hz / kMinLogHz) / kLogStep;
+}
+
+double SlaneyMelToHz(double mel) {
+  constexpr double kMinLogHz = 1000.0;
+  constexpr double kMinLogMel = 15.0;
+  constexpr double kLogStep = 0.06875177742094912;  // log(6.4) / 27
+  if (mel < kMinLogMel) {
+    return mel * (200.0 / 3.0);
+  }
+  return kMinLogHz * std::exp(kLogStep * (mel - kMinLogMel));
+}
+
+std::vector<float> CreateSlaneyMelFilterbank(int sample_rate, int n_fft,
+                                             int n_mels) {
+  const int fft_bins = n_fft / 2 + 1;
+  std::vector<double> mel_points(n_mels + 2);
+  const double mel_min = HzToSlaneyMel(0.0);
+  const double mel_max = HzToSlaneyMel(sample_rate / 2.0);
+  for (int i = 0; i < n_mels + 2; ++i) {
+    const double mel =
+        mel_min + (mel_max - mel_min) * i / static_cast<double>(n_mels + 1);
+    mel_points[i] = SlaneyMelToHz(mel);
+  }
+
+  std::vector<float> weights(n_mels * fft_bins, 0.0f);
+  for (int mel = 0; mel < n_mels; ++mel) {
+    const double lower = mel_points[mel];
+    const double center = mel_points[mel + 1];
+    const double upper = mel_points[mel + 2];
+    const double enorm = 2.0 / (upper - lower);
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      const double freq =
+          (sample_rate / 2.0) * bin / static_cast<double>(fft_bins - 1);
+      const double left = (freq - lower) / (center - lower);
+      const double right = (upper - freq) / (upper - center);
+      const double value = std::max(0.0, std::min(left, right)) * enorm;
+      weights[mel * fft_bins + bin] = static_cast<float>(value);
+    }
+  }
+  return weights;
+}
+
+absl::StatusOr<std::vector<float>> CreateParakeetInputFeatures(
+    const std::string& audio_path, int* pcm_sample_count, int* valid_frames) {
+  ASSIGN_OR_RETURN(const std::string audio_bytes, ReadBinaryFile(audio_path));
+  std::vector<float> pcm;
+  RETURN_IF_ERROR(litert::lm::AudioPreprocessorMiniAudio::DecodeAudio(
+      audio_bytes, /*num_channels=*/1, /*sample_rate_hz=*/16000, pcm));
+  *pcm_sample_count = static_cast<int>(pcm.size());
+
+  constexpr int kSampleRate = 16000;
+  constexpr int kNumMels = 128;
+  constexpr int kMaxFrames = 500;
+  constexpr int kNfft = 512;
+  constexpr int kWinLength = 400;
+  constexpr int kHopLength = 160;
+  constexpr float kPreemphasis = 0.97f;
+  constexpr float kLogZeroGuard = 5.960464477539063e-8f;  // 2^-24
+  const int fft_bins = kNfft / 2 + 1;
+
+  if (pcm.empty()) {
+    return absl::InvalidArgumentError("Decoded audio is empty.");
+  }
+  for (int i = static_cast<int>(pcm.size()) - 1; i >= 1; --i) {
+    pcm[i] = pcm[i] - kPreemphasis * pcm[i - 1];
+  }
+
+  std::vector<float> padded(pcm.size() + kNfft, 0.0f);
+  std::copy(pcm.begin(), pcm.end(), padded.begin() + kNfft / 2);
+  const int frame_count =
+      std::min(kMaxFrames, 1 + static_cast<int>(pcm.size()) / kHopLength);
+  *valid_frames = frame_count;
+
+  std::vector<float> mel_features(frame_count * kNumMels, 0.0f);
+  const std::vector<float> window = HannWindow(kWinLength);
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+
+  for (int t = 0; t < frame_count; ++t) {
+    std::fill(frame.begin(), frame.end(), 0.0f);
+    const int source_start = t * kHopLength;
+    const int window_offset = (kNfft - kWinLength) / 2;
+    for (int i = 0; i < kWinLength; ++i) {
+      frame[window_offset + i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      mel_features[t * kNumMels + mel] =
+          std::log(static_cast<float>(value) + kLogZeroGuard);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  for (int mel = 0; mel < kNumMels; ++mel) {
+    double sum = 0.0;
+    for (int t = 0; t < frame_count; ++t) {
+      sum += mel_features[t * kNumMels + mel];
+    }
+    const double mean = sum / frame_count;
+    double variance = 0.0;
+    for (int t = 0; t < frame_count; ++t) {
+      const double diff = mel_features[t * kNumMels + mel] - mean;
+      variance += diff * diff;
+    }
+    const double stddev =
+        std::sqrt(variance / std::max(1, frame_count - 1)) + 1e-5;
+    for (int t = 0; t < frame_count; ++t) {
+      mel_features[t * kNumMels + mel] =
+          static_cast<float>((mel_features[t * kNumMels + mel] - mean) /
+                             stddev);
+    }
+  }
+
+  std::vector<float> model_input(kNumMels * kMaxFrames, 0.0f);
+  for (int t = 0; t < frame_count; ++t) {
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      model_input[mel * kMaxFrames + t] = mel_features[t * kNumMels + mel];
+    }
+  }
+  return model_input;
+}
+
+absl::StatusOr<std::vector<float>> CreateWhisperInputFeatures(
+    const std::string& audio_path, int* pcm_sample_count, int* valid_frames) {
+  ASSIGN_OR_RETURN(const std::string audio_bytes, ReadBinaryFile(audio_path));
+  std::vector<float> pcm;
+  RETURN_IF_ERROR(litert::lm::AudioPreprocessorMiniAudio::DecodeAudio(
+      audio_bytes, /*num_channels=*/1, /*sample_rate_hz=*/16000, pcm));
+  *pcm_sample_count = static_cast<int>(pcm.size());
+
+  constexpr int kSampleRate = 16000;
+  constexpr int kNumMels = 80;
+  constexpr int kMaxSamples = 16000 * 30;
+  constexpr int kMaxFrames = 3000;
+  constexpr int kNfft = 400;
+  constexpr int kHopLength = 160;
+  constexpr float kLogZeroGuard = 1.0e-10f;
+  const int fft_bins = kNfft / 2 + 1;
+
+  if (pcm.empty()) {
+    return absl::InvalidArgumentError("Decoded audio is empty.");
+  }
+
+  if (static_cast<int>(pcm.size()) > kMaxSamples) {
+    pcm.resize(kMaxSamples);
+  }
+  *valid_frames =
+      std::min(kMaxFrames, 1 + static_cast<int>(pcm.size()) / kHopLength);
+
+  std::vector<float> padded(kMaxSamples + kNfft, 0.0f);
+  std::copy(pcm.begin(), pcm.end(), padded.begin() + kNfft / 2);
+  const std::vector<float> window = HannWindow(kNfft);
+  const std::vector<float> mel_filters =
+      CreateSlaneyMelFilterbank(kSampleRate, kNfft, kNumMels);
+
+  kiss_fftr_cfg fft =
+      kiss_fftr_alloc(kNfft, /*inverse_fft=*/0, /*mem=*/nullptr,
+                      /*lenmem=*/nullptr);
+  std::vector<float> frame(kNfft, 0.0f);
+  std::vector<float> power(fft_bins, 0.0f);
+  std::vector<kiss_fft_cpx> fft_out(fft_bins);
+  std::vector<float> log_mels(kNumMels * kMaxFrames, 0.0f);
+  float max_log_mel = -std::numeric_limits<float>::infinity();
+
+  for (int t = 0; t < kMaxFrames; ++t) {
+    const int source_start = t * kHopLength;
+    for (int i = 0; i < kNfft; ++i) {
+      frame[i] = padded[source_start + i] * window[i];
+    }
+    kiss_fftr(fft, frame.data(), fft_out.data());
+    for (int bin = 0; bin < fft_bins; ++bin) {
+      power[bin] =
+          fft_out[bin].r * fft_out[bin].r + fft_out[bin].i * fft_out[bin].i;
+    }
+    for (int mel = 0; mel < kNumMels; ++mel) {
+      double value = 0.0;
+      for (int bin = 0; bin < fft_bins; ++bin) {
+        value += mel_filters[mel * fft_bins + bin] * power[bin];
+      }
+      const float log_value =
+          std::log10(std::max(static_cast<float>(value), kLogZeroGuard));
+      log_mels[mel * kMaxFrames + t] = log_value;
+      max_log_mel = std::max(max_log_mel, log_value);
+    }
+  }
+  kiss_fftr_free(fft);
+
+  const float log_floor = max_log_mel - 8.0f;
+  for (float& value : log_mels) {
+    value = (std::max(value, log_floor) + 4.0f) / 4.0f;
+  }
+  return log_mels;
+}
+
+template <typename T>
+absl::StatusOr<std::vector<T>> ReadTensorBufferVector(
+    ::litert::TensorBuffer& buffer) {
+  LITERT_ASSIGN_OR_RETURN(auto tensor_type, buffer.TensorType());
+  LITERT_ASSIGN_OR_RETURN(auto elements, tensor_type.Layout().NumElements());
+  std::vector<T> data(elements);
+  LITERT_RETURN_IF_ERROR(buffer.Read<T>(absl::MakeSpan(data)));
+  return data;
+}
+
+std::string DecodeParakeetTokens(const std::string& tokenizer_json_path,
+                                 const std::vector<int>& token_ids) {
+  auto tokenizer_data = ReadBinaryFile(tokenizer_json_path);
+  if (!tokenizer_data.ok()) {
+    return "";
+  }
+  auto tokenizer_json = nlohmann::json::parse(*tokenizer_data, nullptr, false);
+  if (tokenizer_json.is_discarded() || !tokenizer_json.contains("model") ||
+      !tokenizer_json["model"].contains("vocab")) {
+    return "";
+  }
+
+  std::vector<std::string> vocab(8193);
+  for (const auto& item : tokenizer_json["model"]["vocab"].items()) {
+    if (item.value().is_number_integer()) {
+      const int id = item.value().get<int>();
+      if (id >= 0 && id < static_cast<int>(vocab.size())) {
+        vocab[id] = item.key();
+      }
+    }
+  }
+
+  std::string text;
+  for (int token_id : token_ids) {
+    if (token_id < 0 || token_id >= static_cast<int>(vocab.size())) {
+      continue;
+    }
+    const std::string& token = vocab[token_id];
+    if (token.empty() || token[0] == '<') {
+      continue;
+    }
+    if (token == "▁") {
+      text += " ";
+    } else if (token.rfind("▁", 0) == 0) {
+      text += " ";
+      text += token.substr(std::string("▁").size());
+    } else {
+      text += token;
+    }
+  }
+  while (!text.empty() && text.front() == ' ') {
+    text.erase(text.begin());
+  }
+  return text;
+}
+
+std::vector<int> Gpt2ByteValues() {
+  std::vector<int> values;
+  for (int i = static_cast<int>('!'); i <= static_cast<int>('~'); ++i) {
+    values.push_back(i);
+  }
+  for (int i = 0xA1; i <= 0xAC; ++i) {
+    values.push_back(i);
+  }
+  for (int i = 0xAE; i <= 0xFF; ++i) {
+    values.push_back(i);
+  }
+  for (int i = 0; i < 256; ++i) {
+    if (std::find(values.begin(), values.end(), i) == values.end()) {
+      values.push_back(i);
+    }
+  }
+  return values;
+}
+
+std::unordered_map<uint32_t, uint8_t> CreateGpt2ByteDecoder() {
+  std::unordered_map<uint32_t, uint8_t> decoder;
+  const std::vector<int> bytes = Gpt2ByteValues();
+  int extra = 0;
+  for (int byte_value : bytes) {
+    uint32_t codepoint = 0;
+    if ((byte_value >= static_cast<int>('!') &&
+         byte_value <= static_cast<int>('~')) ||
+        (byte_value >= 0xA1 && byte_value <= 0xAC) ||
+        (byte_value >= 0xAE && byte_value <= 0xFF)) {
+      codepoint = static_cast<uint32_t>(byte_value);
+    } else {
+      codepoint = static_cast<uint32_t>(256 + extra);
+      ++extra;
+    }
+    decoder[codepoint] = static_cast<uint8_t>(byte_value);
+  }
+  return decoder;
+}
+
+bool ReadUtf8Codepoint(const std::string& text, size_t* index,
+                       uint32_t* codepoint, std::string* original_bytes) {
+  if (*index >= text.size()) {
+    return false;
+  }
+  const unsigned char first = static_cast<unsigned char>(text[*index]);
+  size_t length = 1;
+  uint32_t value = first;
+  if ((first & 0x80) == 0) {
+    length = 1;
+    value = first;
+  } else if ((first & 0xE0) == 0xC0) {
+    length = 2;
+    value = first & 0x1F;
+  } else if ((first & 0xF0) == 0xE0) {
+    length = 3;
+    value = first & 0x0F;
+  } else if ((first & 0xF8) == 0xF0) {
+    length = 4;
+    value = first & 0x07;
+  } else {
+    return false;
+  }
+  if (*index + length > text.size()) {
+    return false;
+  }
+  for (size_t i = 1; i < length; ++i) {
+    const unsigned char current =
+        static_cast<unsigned char>(text[*index + i]);
+    if ((current & 0xC0) != 0x80) {
+      return false;
+    }
+    value = (value << 6) | (current & 0x3F);
+  }
+  *codepoint = value;
+  *original_bytes = text.substr(*index, length);
+  *index += length;
+  return true;
+}
+
+std::string DecodeWhisperTokens(const std::string& tokenizer_json_path,
+                                const std::vector<int>& token_ids) {
+  auto tokenizer_data = ReadBinaryFile(tokenizer_json_path);
+  if (!tokenizer_data.ok()) {
+    return "";
+  }
+  auto tokenizer_json = nlohmann::json::parse(*tokenizer_data, nullptr, false);
+  if (tokenizer_json.is_discarded() || !tokenizer_json.contains("model") ||
+      !tokenizer_json["model"].contains("vocab")) {
+    return "";
+  }
+
+  std::vector<std::string> vocab(51865);
+  for (const auto& item : tokenizer_json["model"]["vocab"].items()) {
+    if (item.value().is_number_integer()) {
+      const int id = item.value().get<int>();
+      if (id >= 0 && id < static_cast<int>(vocab.size())) {
+        vocab[id] = item.key();
+      }
+    }
+  }
+
+  if (tokenizer_json.contains("added_tokens") &&
+      tokenizer_json["added_tokens"].is_array()) {
+    for (const auto& item : tokenizer_json["added_tokens"]) {
+      if (item.contains("id") && item["id"].is_number_integer() &&
+          item.contains("content") && item["content"].is_string()) {
+        const int id = item["id"].get<int>();
+        if (id >= 0 && id < static_cast<int>(vocab.size())) {
+          vocab[id] = item["content"].get<std::string>();
+        }
+      }
+    }
+  }
+
+  const auto byte_decoder = CreateGpt2ByteDecoder();
+  std::string decoded_bytes;
+  for (int token_id : token_ids) {
+    if (token_id < 0 || token_id >= static_cast<int>(vocab.size())) {
+      continue;
+    }
+    const std::string& token = vocab[token_id];
+    if (token.empty() || token[0] == '<') {
+      continue;
+    }
+    size_t index = 0;
+    while (index < token.size()) {
+      uint32_t codepoint = 0;
+      std::string original;
+      if (!ReadUtf8Codepoint(token, &index, &codepoint, &original)) {
+        break;
+      }
+      const auto byte = byte_decoder.find(codepoint);
+      if (byte != byte_decoder.end()) {
+        decoded_bytes.push_back(static_cast<char>(byte->second));
+      } else {
+        decoded_bytes += original;
+      }
+    }
+  }
+  return decoded_bytes;
+}
+
+bool IsSuppressedWhisperToken(int token_id) {
+  if (token_id == 50257) {
+    return false;
+  }
+  return token_id >= 50258;
+}
+
+nlohmann::ordered_json RunParakeetAsrSmokeToJson(
+    const std::string& model_path, const std::string& audio_path,
+    const std::string& tokenizer_json_path, const std::string& backend) {
+  nlohmann::ordered_json result;
+  result["modelPath"] = model_path;
+  result["audioPath"] = audio_path;
+  result["tokenizerJsonPath"] = tokenizer_json_path;
+  result["backendRequested"] = backend;
+  result["success"] = false;
+
+  int pcm_sample_count = 0;
+  int valid_feature_frames = 0;
+  auto feature_result = CreateParakeetInputFeatures(
+      audio_path, &pcm_sample_count, &valid_feature_frames);
+  if (!feature_result.ok()) {
+    result["error"] = std::string(feature_result.status().message());
+    return result;
+  }
+  result["pcmSamples"] = pcm_sample_count;
+  result["audioSeconds"] = pcm_sample_count / 16000.0;
+  result["validFeatureFrames"] = valid_feature_frames;
+
+  auto started = absl::Now();
+  auto env_or = ::litert::Environment::Create({});
+  if (!env_or.HasValue()) {
+    result["error"] = env_or.Error().Message();
+    return result;
+  }
+  auto env = std::move(env_or.Value());
+  auto options_or = ::litert::Options::Create();
+  if (!options_or.HasValue()) {
+    result["error"] = options_or.Error().Message();
+    return result;
+  }
+  auto options = std::move(options_or.Value());
+  auto cpu_options = options.GetCpuOptions();
+  if (cpu_options.HasValue()) {
+    cpu_options->SetNumThreads(4);
+  }
+  std::string normalized_backend = backend;
+  std::transform(normalized_backend.begin(), normalized_backend.end(),
+                 normalized_backend.begin(),
+                 [](unsigned char c) { return std::toupper(c); });
+  const bool use_gpu = normalized_backend.rfind("GPU", 0) == 0;
+  if (use_gpu) {
+    auto gpu_options = options.GetGpuOptions();
+    if (!gpu_options.HasValue()) {
+      result["error"] = gpu_options.Error().Message();
+      return result;
+    }
+    const bool use_fp16 = normalized_backend.find("FP16") != std::string::npos;
+    const bool use_texture_weights =
+        normalized_backend.find("NO_TEXTURE") == std::string::npos;
+    const bool convert_weights_on_gpu =
+        normalized_backend.find("NO_CONVERT") == std::string::npos;
+    const bool relaxed_delegation =
+        normalized_backend.find("RELAXED") != std::string::npos;
+
+    gpu_options->SetPrecision(use_fp16 ? ::litert::GpuOptions::Precision::kFp16
+                                       : ::litert::GpuOptions::Precision::kFp32);
+    gpu_options->EnableConstantTensorSharing(true);
+#if !defined(__APPLE__)
+    gpu_options->SetPreferTextureWeights(use_texture_weights);
+#endif
+    gpu_options->SetMadviseOriginalSharedTensors(true);
+    gpu_options->SetConvertWeightsOnGpu(convert_weights_on_gpu);
+    if (!relaxed_delegation) {
+      gpu_options->SetHintFullyDelegatedToSingleDelegate(true);
+    }
+    gpu_options->EnableInfiniteFloatCapping(true);
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kGpu);
+    result["backendUsed"] = normalized_backend;
+    result["gpuPrecision"] = use_fp16 ? "fp16" : "fp32";
+    result["gpuPreferTextureWeights"] = use_texture_weights;
+    result["gpuConvertWeightsOnGpu"] = convert_weights_on_gpu;
+    result["gpuRelaxedDelegation"] = relaxed_delegation;
+  } else {
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kCpu);
+    result["backendUsed"] = "CPU";
+  }
+
+  auto compiled_model_or =
+      ::litert::CompiledModel::Create(env, model_path, options);
+  if (!compiled_model_or.HasValue()) {
+    result["error"] = compiled_model_or.Error().Message();
+    return result;
+  }
+  auto compiled_model = std::move(compiled_model_or.Value());
+  result["compileSeconds"] = absl::ToDoubleSeconds(absl::Now() - started);
+
+  auto& encode_model = compiled_model;
+  auto& decode_model = compiled_model;
+
+  auto encode_index_or = encode_model.GetSignatureIndex("encode");
+  if (!encode_index_or.HasValue()) {
+    result["error"] = encode_index_or.Error().Message();
+    return result;
+  }
+  auto decode_index_or = decode_model.GetSignatureIndex("decode");
+  if (!decode_index_or.HasValue()) {
+    result["error"] = decode_index_or.Error().Message();
+    return result;
+  }
+  const int encode_index = encode_index_or.Value();
+  const int decode_index = decode_index_or.Value();
+
+  auto encode_started = absl::Now();
+  auto encode_inputs_or = compiled_model.CreateInputBuffers(encode_index);
+  if (!encode_inputs_or.HasValue()) {
+    result["error"] = encode_inputs_or.Error().Message();
+    return result;
+  }
+  auto encode_inputs = std::move(encode_inputs_or.Value());
+  auto encode_outputs_or = compiled_model.CreateOutputBuffers(encode_index);
+  if (!encode_outputs_or.HasValue()) {
+    result["error"] = encode_outputs_or.Error().Message();
+    return result;
+  }
+  auto encode_outputs = std::move(encode_outputs_or.Value());
+  auto encode_write_status =
+      encode_inputs[0].Write<float>(absl::MakeSpan(*feature_result));
+  if (!encode_write_status.HasValue()) {
+    result["error"] = encode_write_status.Error().Message();
+    return result;
+  }
+  auto encode_status =
+      compiled_model.Run(encode_index, encode_inputs, encode_outputs);
+  if (!encode_status.HasValue()) {
+    result["error"] = encode_status.Error().Message();
+    return result;
+  }
+  auto encoder_output_or = ReadTensorBufferVector<float>(encode_outputs[0]);
+  if (!encoder_output_or.ok()) {
+    result["error"] = std::string(encoder_output_or.status().message());
+    return result;
+  }
+  auto encoder_output = std::move(*encoder_output_or);
+  result["encodeSeconds"] = absl::ToDoubleSeconds(absl::Now() - encode_started);
+  result["encoderOutputValues"] = encoder_output.size();
+
+  constexpr int kEncodedFrames = 63;
+  constexpr int kTargetLength = 64;
+  constexpr int kVocabSize = 8193;
+  constexpr int kBlankToken = 8192;
+  constexpr int kOutputClasses = 8198;
+  constexpr int kStateValues = 2 * 1 * 640;
+  const int durations[5] = {0, 1, 2, 3, 4};
+
+  std::vector<int32_t> target(kTargetLength, kBlankToken);
+  std::vector<float> state_1(kStateValues, 0.0f);
+  std::vector<float> state_2(kStateValues, 0.0f);
+  std::vector<int> token_ids;
+  int time_index = 0;
+  int decode_steps = 0;
+  auto decode_started = absl::Now();
+
+  while (time_index < kEncodedFrames &&
+         token_ids.size() < static_cast<size_t>(kTargetLength)) {
+    int symbols_added = 0;
+    int last_skip = 1;
+    bool need_loop = true;
+    while (need_loop && symbols_added < 10 &&
+           token_ids.size() < static_cast<size_t>(kTargetLength)) {
+      auto decode_inputs_or = compiled_model.CreateInputBuffers(decode_index);
+      if (!decode_inputs_or.HasValue()) {
+        result["error"] = decode_inputs_or.Error().Message();
+        return result;
+      }
+      auto decode_inputs = std::move(decode_inputs_or.Value());
+      auto decode_outputs_or = compiled_model.CreateOutputBuffers(decode_index);
+      if (!decode_outputs_or.HasValue()) {
+        result["error"] = decode_outputs_or.Error().Message();
+        return result;
+      }
+      auto decode_outputs = std::move(decode_outputs_or.Value());
+      target[0] = token_ids.empty() ? kBlankToken : token_ids.back();
+      auto write_status =
+          decode_inputs[0].Write<float>(absl::MakeSpan(encoder_output));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status = decode_inputs[1].Write<int32_t>(absl::MakeSpan(target));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status = decode_inputs[2].Write<float>(absl::MakeSpan(state_1));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      write_status = decode_inputs[3].Write<float>(absl::MakeSpan(state_2));
+      if (!write_status.HasValue()) {
+        result["error"] = write_status.Error().Message();
+        return result;
+      }
+      auto decode_status =
+          compiled_model.Run(decode_index, decode_inputs, decode_outputs);
+      if (!decode_status.HasValue()) {
+        result["error"] = decode_status.Error().Message();
+        return result;
+      }
+      auto logits_or = ReadTensorBufferVector<float>(decode_outputs[0]);
+      if (!logits_or.ok()) {
+        result["error"] = std::string(logits_or.status().message());
+        return result;
+      }
+      auto logits = std::move(*logits_or);
+      auto state_1_or = ReadTensorBufferVector<float>(decode_outputs[1]);
+      if (!state_1_or.ok()) {
+        result["error"] = std::string(state_1_or.status().message());
+        return result;
+      }
+      state_1 = std::move(*state_1_or);
+      auto state_2_or = ReadTensorBufferVector<float>(decode_outputs[2]);
+      if (!state_2_or.ok()) {
+        result["error"] = std::string(state_2_or.status().message());
+        return result;
+      }
+      state_2 = std::move(*state_2_or);
+
+      const size_t offset =
+          (static_cast<size_t>(time_index) * kTargetLength) * kOutputClasses;
+      int best_token = 0;
+      float best_token_score = logits[offset];
+      for (int i = 1; i < kVocabSize; ++i) {
+        if (logits[offset + i] > best_token_score) {
+          best_token_score = logits[offset + i];
+          best_token = i;
+        }
+      }
+      int best_duration = 0;
+      float best_duration_score = logits[offset + kVocabSize];
+      for (int i = 1; i < 5; ++i) {
+        if (logits[offset + kVocabSize + i] > best_duration_score) {
+          best_duration_score = logits[offset + kVocabSize + i];
+          best_duration = i;
+        }
+      }
+      const int skip = durations[best_duration];
+      last_skip = skip;
+      if (best_token != kBlankToken) {
+        token_ids.push_back(best_token);
+      }
+      ++symbols_added;
+      ++decode_steps;
+      time_index += skip;
+      need_loop = skip == 0;
+    }
+    if (last_skip == 0) {
+      ++time_index;
+    }
+    if (symbols_added == 10) {
+      ++time_index;
+    }
+  }
+
+  result["decodeSeconds"] = absl::ToDoubleSeconds(absl::Now() - decode_started);
+  result["decodeSteps"] = decode_steps;
+  result["tokenCount"] = token_ids.size();
+  result["tokenIds"] = token_ids;
+  result["transcriptCandidate"] =
+      DecodeParakeetTokens(tokenizer_json_path, token_ids);
+  if (token_ids.empty()) {
+    result["error"] = "No ASR tokens were decoded.";
+    return result;
+  }
+  result["success"] = true;
+  return result;
+}
+
+nlohmann::ordered_json RunWhisperAsrSmokeToJson(
+    const std::string& model_path, const std::string& audio_path,
+    const std::string& tokenizer_json_path, const std::string& backend,
+    const std::string& language) {
+  UnityAsrLog("Whisper ASR native start: backend=" + backend +
+              ", language=" + language);
+  nlohmann::ordered_json result;
+  result["modelPath"] = model_path;
+  result["audioPath"] = audio_path;
+  result["tokenizerJsonPath"] = tokenizer_json_path;
+  result["backendRequested"] = backend;
+  std::string normalized_language = language;
+  std::transform(normalized_language.begin(), normalized_language.end(),
+                 normalized_language.begin(),
+                 [](unsigned char c) { return std::tolower(c); });
+  if (normalized_language.empty()) {
+    normalized_language = "auto";
+  }
+  if (normalized_language != "auto" && normalized_language != "ko" &&
+      normalized_language != "en") {
+    result["error"] =
+        "Unsupported Whisper ASR language: " + normalized_language +
+        ". Supported values are auto, ko and en.";
+    return result;
+  }
+  result["language"] = normalized_language;
+  result["success"] = false;
+
+  int pcm_sample_count = 0;
+  int valid_feature_frames = 0;
+  UnityAsrLog("Whisper ASR creating log-mel input features.");
+  auto feature_result = CreateWhisperInputFeatures(
+      audio_path, &pcm_sample_count, &valid_feature_frames);
+  if (!feature_result.ok()) {
+    result["error"] = std::string(feature_result.status().message());
+    return result;
+  }
+  result["pcmSamples"] = pcm_sample_count;
+  result["audioSeconds"] = pcm_sample_count / 16000.0;
+  result["validFeatureFrames"] = valid_feature_frames;
+  UnityAsrLog("Whisper ASR features ready: pcmSamples=" +
+              std::to_string(pcm_sample_count) +
+              ", validFeatureFrames=" + std::to_string(valid_feature_frames));
+
+  auto started = absl::Now();
+  UnityAsrLog("Whisper ASR preparing LiteRT environment/options.");
+  std::string normalized_backend = backend;
+  std::transform(normalized_backend.begin(), normalized_backend.end(),
+                 normalized_backend.begin(),
+                 [](unsigned char c) { return std::toupper(c); });
+  const bool use_gpu_requested = normalized_backend.rfind("GPU", 0) == 0;
+
+  auto make_cpu_options = [&result]() -> std::optional<::litert::Options> {
+    auto options_or = ::litert::Options::Create();
+    if (!options_or.HasValue()) {
+      result["error"] = options_or.Error().Message();
+      return std::nullopt;
+    }
+    auto options = std::move(options_or.Value());
+    auto cpu_options = options.GetCpuOptions();
+    if (cpu_options.HasValue()) {
+      cpu_options->SetNumThreads(4);
+    }
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kCpu);
+    return options;
+  };
+
+  auto make_gpu_options = [&result, &normalized_backend]()
+      -> std::optional<::litert::Options> {
+    auto options_or = ::litert::Options::Create();
+    if (!options_or.HasValue()) {
+      result["error"] = options_or.Error().Message();
+      return std::nullopt;
+    }
+    auto options = std::move(options_or.Value());
+    auto cpu_options = options.GetCpuOptions();
+    if (cpu_options.HasValue()) {
+      cpu_options->SetNumThreads(4);
+    }
+    auto gpu_options = options.GetGpuOptions();
+    if (!gpu_options.HasValue()) {
+      result["error"] = gpu_options.Error().Message();
+      return std::nullopt;
+    }
+    const bool use_fp16 = normalized_backend.find("FP16") != std::string::npos;
+    const bool use_texture_weights =
+        normalized_backend.find("NO_TEXTURE") == std::string::npos;
+    const bool convert_weights_on_gpu =
+        normalized_backend.find("NO_CONVERT") == std::string::npos;
+    const bool relaxed_delegation =
+        normalized_backend.find("RELAXED") != std::string::npos;
+
+    gpu_options->SetPrecision(use_fp16 ? ::litert::GpuOptions::Precision::kFp16
+                                       : ::litert::GpuOptions::Precision::kFp32);
+    gpu_options->EnableConstantTensorSharing(true);
+#if !defined(__APPLE__)
+    gpu_options->SetPreferTextureWeights(use_texture_weights);
+#endif
+    gpu_options->SetMadviseOriginalSharedTensors(true);
+    gpu_options->SetConvertWeightsOnGpu(convert_weights_on_gpu);
+    if (!relaxed_delegation) {
+      gpu_options->SetHintFullyDelegatedToSingleDelegate(true);
+    }
+    gpu_options->EnableInfiniteFloatCapping(true);
+    options.SetHardwareAccelerators(::litert::HwAccelerators::kGpu);
+    result["gpuPrecision"] = use_fp16 ? "fp16" : "fp32";
+    result["gpuPreferTextureWeights"] = use_texture_weights;
+    result["gpuConvertWeightsOnGpu"] = convert_weights_on_gpu;
+    result["gpuRelaxedDelegation"] = relaxed_delegation;
+    return options;
+  };
+
+  std::string encoder_model_path;
+  const std::string f32_suffix = "_f32.tflite";
+  if (model_path.size() >= f32_suffix.size() &&
+      model_path.compare(model_path.size() - f32_suffix.size(),
+                         f32_suffix.size(), f32_suffix) == 0) {
+    encoder_model_path =
+        model_path.substr(0, model_path.size() - f32_suffix.size()) +
+        "_encoder_f32.tflite";
+  } else {
+    const std::string tflite_suffix = ".tflite";
+    if (model_path.size() >= tflite_suffix.size() &&
+        model_path.compare(model_path.size() - tflite_suffix.size(),
+                           tflite_suffix.size(), tflite_suffix) == 0) {
+      encoder_model_path =
+          model_path.substr(0, model_path.size() - tflite_suffix.size()) +
+          "_encoder.tflite";
+    }
+  }
+
+  const bool split_encoder_available =
+      !encoder_model_path.empty() && std::ifstream(encoder_model_path).good();
+  const bool use_split_encoder_gpu = use_gpu_requested && split_encoder_available;
+
+  struct WhisperAsrCompiledModelCacheEntry {
+    std::string key;
+    std::unique_ptr<::litert::Environment> env;
+    std::unique_ptr<::litert::CompiledModel> encoder_model;
+    std::unique_ptr<::litert::CompiledModel> decoder_model;
+    int encode_index = -1;
+    int decode_index = -1;
+    bool use_split_encoder_gpu = false;
+    std::string backend_used;
+    std::string encoder_model_path;
+    double initial_compile_seconds = 0.0;
+    double initial_encoder_compile_seconds = 0.0;
+  };
+  static std::mutex whisper_asr_cache_mutex;
+  static std::unique_ptr<WhisperAsrCompiledModelCacheEntry> whisper_asr_cache;
+
+  if (use_gpu_requested && !split_encoder_available) {
+    result["gpuFallbackReason"] =
+        "Whisper GPU was requested, but an encoder-only companion model was "
+        "not found next to the full ASR model.";
+    UnityAsrLog("Whisper ASR GPU requested, but encoder companion model was "
+                "not found. Falling back to CPU.");
+  }
+
+  const std::string cache_key =
+      model_path + "\n" + encoder_model_path + "\n" + normalized_backend;
+  std::unique_lock<std::mutex> cache_lock(whisper_asr_cache_mutex);
+  const bool cache_hit =
+      whisper_asr_cache != nullptr && whisper_asr_cache->key == cache_key;
+  if (cache_hit) {
+    UnityAsrLog("Whisper ASR compiled model cache hit.");
+  } else {
+    UnityAsrLog("Whisper ASR compiled model cache miss; compiling models.");
+    whisper_asr_cache.reset();
+    auto cache_entry = std::make_unique<WhisperAsrCompiledModelCacheEntry>();
+    cache_entry->key = cache_key;
+    cache_entry->use_split_encoder_gpu = use_split_encoder_gpu;
+
+    auto env_or = ::litert::Environment::Create({});
+    if (!env_or.HasValue()) {
+      result["error"] = env_or.Error().Message();
+      return result;
+    }
+    cache_entry->env =
+        std::make_unique<::litert::Environment>(std::move(env_or.Value()));
+
+    if (use_split_encoder_gpu) {
+      UnityAsrLog("Whisper ASR configuring split backend: GPU encoder, CPU decoder.");
+      auto encoder_options = make_gpu_options();
+      if (!encoder_options.has_value()) {
+        return result;
+      }
+      auto encoder_compile_started = absl::Now();
+      UnityAsrLog("Whisper ASR compiling encoder model: " + encoder_model_path);
+      auto encoder_model_or = ::litert::CompiledModel::Create(
+          *cache_entry->env, encoder_model_path, *encoder_options);
+      if (!encoder_model_or.HasValue()) {
+        result["error"] = encoder_model_or.Error().Message();
+        return result;
+      }
+      cache_entry->encoder_model = std::make_unique<::litert::CompiledModel>(
+          std::move(encoder_model_or.Value()));
+      cache_entry->initial_encoder_compile_seconds =
+          absl::ToDoubleSeconds(absl::Now() - encoder_compile_started);
+      cache_entry->encoder_model_path = encoder_model_path;
+      cache_entry->backend_used = "GPU_ENCODER_CPU_DECODER";
+    } else {
+      UnityAsrLog("Whisper ASR configuring CPU backend.");
+      cache_entry->backend_used = "CPU";
+    }
+
+    auto decoder_options = make_cpu_options();
+    if (!decoder_options.has_value()) {
+      return result;
+    }
+    UnityAsrLog("Whisper ASR compiling decoder/full model.");
+    auto compiled_model_or = ::litert::CompiledModel::Create(
+        *cache_entry->env, model_path, *decoder_options);
+    if (!compiled_model_or.HasValue()) {
+      result["error"] = compiled_model_or.Error().Message();
+      return result;
+    }
+    cache_entry->decoder_model = std::make_unique<::litert::CompiledModel>(
+        std::move(compiled_model_or.Value()));
+
+    auto& encode_model_for_index = cache_entry->encoder_model
+                                       ? *cache_entry->encoder_model
+                                       : *cache_entry->decoder_model;
+    auto encode_index_or = encode_model_for_index.GetSignatureIndex("encode");
+    if (!encode_index_or.HasValue()) {
+      result["error"] = encode_index_or.Error().Message();
+      return result;
+    }
+    auto decode_index_or =
+        cache_entry->decoder_model->GetSignatureIndex("decode");
+    if (!decode_index_or.HasValue()) {
+      result["error"] = decode_index_or.Error().Message();
+      return result;
+    }
+    cache_entry->encode_index = encode_index_or.Value();
+    cache_entry->decode_index = decode_index_or.Value();
+    cache_entry->initial_compile_seconds =
+        absl::ToDoubleSeconds(absl::Now() - started);
+    UnityAsrLog("Whisper ASR compile done: seconds=" +
+                std::to_string(cache_entry->initial_compile_seconds));
+    whisper_asr_cache = std::move(cache_entry);
+  }
+
+  auto& cached_models = *whisper_asr_cache;
+  result["compiledModelCache"] = cache_hit ? "hit" : "miss";
+  result["backendUsed"] = cached_models.backend_used;
+  result["compileSeconds"] = cache_hit ? 0.0 : cached_models.initial_compile_seconds;
+  if (cached_models.use_split_encoder_gpu) {
+    result["encoderModelPath"] = cached_models.encoder_model_path;
+    result["encoderCompileSeconds"] =
+        cache_hit ? 0.0 : cached_models.initial_encoder_compile_seconds;
+    const bool use_fp16 = normalized_backend.find("FP16") != std::string::npos;
+    const bool use_texture_weights =
+        normalized_backend.find("NO_TEXTURE") == std::string::npos;
+    const bool convert_weights_on_gpu =
+        normalized_backend.find("NO_CONVERT") == std::string::npos;
+    const bool relaxed_delegation =
+        normalized_backend.find("RELAXED") != std::string::npos;
+    result["gpuPrecision"] = use_fp16 ? "fp16" : "fp32";
+    result["gpuPreferTextureWeights"] = use_texture_weights;
+    result["gpuConvertWeightsOnGpu"] = convert_weights_on_gpu;
+    result["gpuRelaxedDelegation"] = relaxed_delegation;
+  }
+
+  auto& encode_model = cached_models.encoder_model
+                           ? *cached_models.encoder_model
+                           : *cached_models.decoder_model;
+  auto& decode_model = *cached_models.decoder_model;
+  const int encode_index = cached_models.encode_index;
+  const int decode_index = cached_models.decode_index;
+
+  if (use_split_encoder_gpu) {
+    UnityAsrLog("Whisper ASR using split backend: GPU encoder, CPU decoder.");
+  } else {
+    UnityAsrLog("Whisper ASR using CPU backend.");
+  }
+
+  auto encode_started = absl::Now();
+  UnityAsrLog("Whisper ASR creating encode buffers.");
+  auto encode_inputs_or = encode_model.CreateInputBuffers(encode_index);
+  if (!encode_inputs_or.HasValue()) {
+    result["error"] = encode_inputs_or.Error().Message();
+    return result;
+  }
+  auto encode_inputs = std::move(encode_inputs_or.Value());
+  auto encode_outputs_or = encode_model.CreateOutputBuffers(encode_index);
+  if (!encode_outputs_or.HasValue()) {
+    result["error"] = encode_outputs_or.Error().Message();
+    return result;
+  }
+  auto encode_outputs = std::move(encode_outputs_or.Value());
+  auto encode_write_status =
+      encode_inputs[0].Write<float>(absl::MakeSpan(*feature_result));
+  if (!encode_write_status.HasValue()) {
+    result["error"] = encode_write_status.Error().Message();
+    return result;
+  }
+  UnityAsrLog("Whisper ASR running encode signature.");
+  auto encode_status =
+      encode_model.Run(encode_index, encode_inputs, encode_outputs);
+  if (!encode_status.HasValue()) {
+    result["error"] = encode_status.Error().Message();
+    return result;
+  }
+  auto encoder_output_or = ReadTensorBufferVector<float>(encode_outputs[0]);
+  if (!encoder_output_or.ok()) {
+    result["error"] = std::string(encoder_output_or.status().message());
+    return result;
+  }
+  auto encoder_output = std::move(*encoder_output_or);
+  result["encodeSeconds"] = absl::ToDoubleSeconds(absl::Now() - encode_started);
+  result["encoderOutputValues"] = encoder_output.size();
+  UnityAsrLog("Whisper ASR encode done: seconds=" +
+              std::to_string(result["encodeSeconds"].get<double>()) +
+              ", values=" + std::to_string(encoder_output.size()));
+
+  constexpr int kTargetLength = 128;
+  constexpr int kVocabSize = 51865;
+  constexpr int kEosToken = 50257;
+  constexpr int kStartOfTranscriptToken = 50258;
+  constexpr int kEnglishToken = 50259;
+  constexpr int kKoreanToken = 50264;
+  constexpr int kFirstLanguageToken = 50259;
+  constexpr int kLastLanguageToken = 50358;
+  constexpr int kTranscribeToken = 50359;
+  constexpr int kNoTimestampsToken = 50363;
+  std::vector<int32_t> decoder_tokens(kTargetLength, kEosToken);
+  std::vector<float> causal_mask(kTargetLength * kTargetLength, 0.0f);
+  for (int row = 0; row < kTargetLength; ++row) {
+    for (int col = row + 1; col < kTargetLength; ++col) {
+      causal_mask[row * kTargetLength + col] = -1.0e9f;
+    }
+  }
+
+  std::vector<int> token_ids = {kStartOfTranscriptToken};
+  const bool detect_language = normalized_language == "auto";
+  if (normalized_language == "ko") {
+    token_ids.push_back(kKoreanToken);
+    token_ids.push_back(kTranscribeToken);
+    token_ids.push_back(kNoTimestampsToken);
+  } else if (normalized_language == "en") {
+    token_ids.push_back(kEnglishToken);
+    token_ids.push_back(kTranscribeToken);
+    token_ids.push_back(kNoTimestampsToken);
+  }
+  int decode_steps = 0;
+  auto decode_started = absl::Now();
+  UnityAsrLog("Whisper ASR starting autoregressive decode.");
+  while (token_ids.size() < static_cast<size_t>(kTargetLength)) {
+    UnityAsrLog("Whisper ASR decode step " + std::to_string(decode_steps + 1) +
+                ", prefixTokens=" + std::to_string(token_ids.size()));
+    std::fill(decoder_tokens.begin(), decoder_tokens.end(), kEosToken);
+    for (size_t i = 0; i < token_ids.size(); ++i) {
+      decoder_tokens[i] = token_ids[i];
+    }
+
+    auto decode_inputs_or = decode_model.CreateInputBuffers(decode_index);
+    if (!decode_inputs_or.HasValue()) {
+      result["error"] = decode_inputs_or.Error().Message();
+      return result;
+    }
+    auto decode_inputs = std::move(decode_inputs_or.Value());
+    auto decode_outputs_or = decode_model.CreateOutputBuffers(decode_index);
+    if (!decode_outputs_or.HasValue()) {
+      result["error"] = decode_outputs_or.Error().Message();
+      return result;
+    }
+    auto decode_outputs = std::move(decode_outputs_or.Value());
+
+    auto write_status =
+        decode_inputs[0].Write<float>(absl::MakeSpan(encoder_output));
+    if (!write_status.HasValue()) {
+      result["error"] = write_status.Error().Message();
+      return result;
+    }
+    write_status = decode_inputs[1].Write<int32_t>(absl::MakeSpan(decoder_tokens));
+    if (!write_status.HasValue()) {
+      result["error"] = write_status.Error().Message();
+      return result;
+    }
+    write_status = decode_inputs[2].Write<float>(absl::MakeSpan(causal_mask));
+    if (!write_status.HasValue()) {
+      result["error"] = write_status.Error().Message();
+      return result;
+    }
+    auto decode_status =
+        decode_model.Run(decode_index, decode_inputs, decode_outputs);
+    if (!decode_status.HasValue()) {
+      result["error"] = decode_status.Error().Message();
+      return result;
+    }
+    auto logits_or = ReadTensorBufferVector<float>(decode_outputs[0]);
+    if (!logits_or.ok()) {
+      result["error"] = std::string(logits_or.status().message());
+      return result;
+    }
+    auto logits = std::move(*logits_or);
+    const int logits_position = static_cast<int>(token_ids.size()) - 1;
+    const size_t offset =
+        static_cast<size_t>(logits_position) * kVocabSize;
+    int best_token = kEosToken;
+    float best_score = -std::numeric_limits<float>::infinity();
+    if (detect_language && token_ids.size() == 1) {
+      for (int i = kFirstLanguageToken; i <= kLastLanguageToken; ++i) {
+        const float score = logits[offset + i];
+        if (score > best_score) {
+          best_score = score;
+          best_token = i;
+        }
+      }
+    } else {
+      for (int i = 0; i < kVocabSize; ++i) {
+        if (IsSuppressedWhisperToken(i)) {
+          continue;
+        }
+        const float score = logits[offset + i];
+        if (score > best_score) {
+          best_score = score;
+          best_token = i;
+        }
+      }
+    }
+
+    ++decode_steps;
+    if (detect_language && token_ids.size() == 1) {
+      result["detectedLanguageToken"] = best_token;
+      token_ids.push_back(best_token);
+      token_ids.push_back(kTranscribeToken);
+      token_ids.push_back(kNoTimestampsToken);
+      UnityAsrLog("Whisper ASR auto language token=" +
+                  std::to_string(best_token));
+      continue;
+    }
+    if (best_token == kEosToken) {
+      UnityAsrLog("Whisper ASR decode reached EOS at step " +
+                  std::to_string(decode_steps));
+      break;
+    }
+    token_ids.push_back(best_token);
+  }
+
+  result["decodeSeconds"] = absl::ToDoubleSeconds(absl::Now() - decode_started);
+  result["decodeSteps"] = decode_steps;
+  result["tokenCount"] = token_ids.size();
+  result["tokenIds"] = token_ids;
+  result["transcriptCandidate"] =
+      DecodeWhisperTokens(tokenizer_json_path, token_ids);
+  UnityAsrLog("Whisper ASR decode done: seconds=" +
+              std::to_string(result["decodeSeconds"].get<double>()) +
+              ", steps=" + std::to_string(decode_steps));
+  if (token_ids.size() <= 4 || result["transcriptCandidate"].get<std::string>().empty()) {
+    result["error"] = "No Whisper ASR text was decoded.";
+    return result;
+  }
+  result["success"] = true;
+  return result;
+}
+
+nlohmann::ordered_json MakeTextMessageJson(const std::string& role,
+                                          const std::string& text) {
+  return nlohmann::ordered_json{
+      {"role", role},
+      {"content",
+       nlohmann::ordered_json::array(
+           {nlohmann::ordered_json{{"type", "text"}, {"text", text}}})}};
+}
+
+std::string ExtractTextFromMessageJson(const Message& message) {
+  if (!message.contains("content") || !message["content"].is_array()) {
+    return message.dump();
+  }
+
+  std::string result;
+  for (const auto& item : message["content"]) {
+    if (item.contains("type") && item["type"] == "text" &&
+        item.contains("text") && item["text"].is_string()) {
+      result += item["text"].get<std::string>();
+    }
+  }
+  return result.empty() ? message.dump() : result;
+}
+
+void PromoteUnityJniLibrarySymbols(const std::string& native_library_dir) {
+#if defined(__ANDROID__)
+  if (native_library_dir.empty()) {
+    return;
+  }
+
+  const std::string litert_library_path = native_library_dir + "/libLiteRt.so";
+  void* litert_handle =
+      dlopen(litert_library_path.c_str(), RTLD_NOW | RTLD_GLOBAL);
+  if (litert_handle == nullptr) {
+    ABSL_LOG(WARNING) << "Failed to promote libLiteRt.so symbols: "
+                      << dlerror();
+  } else {
+    ABSL_LOG(INFO) << "Promoted libLiteRt.so symbols for LiteRT sampler "
+                      "shared libraries: "
+                   << litert_library_path;
+  }
+
+  const std::string jni_library_path =
+      native_library_dir + "/liblitertlm_jni.so";
+  void* handle = dlopen(jni_library_path.c_str(), RTLD_NOW | RTLD_GLOBAL);
+  if (handle == nullptr) {
+    ABSL_LOG(WARNING) << "Failed to promote liblitertlm_jni.so symbols: "
+                      << dlerror();
+    return;
+  }
+
+  ABSL_LOG(INFO) << "Promoted liblitertlm_jni.so symbols for LiteRT sampler "
+                    "shared libraries: "
+                 << jni_library_path;
+#else
+  (void)native_library_dir;
+#endif
+}
+
+absl::StatusOr<std::unique_ptr<Engine>> CreateUnityBridgeEngine(
+    const std::string& model_path, const std::string& backend_name,
+    const std::string& cache_dir, const std::string& native_library_dir,
+    int max_num_tokens, int max_num_images, int cpu_threads,
+    bool enable_speculative_decoding) {
+  auto model_assets = ModelAssets::Create(model_path);
+  if (!model_assets.ok()) {
+    return model_assets.status();
+  }
+
+  auto backend_enum = litert::lm::GetBackendFromString(backend_name);
+  if (!backend_enum.ok()) {
+    return backend_enum.status();
+  }
+
+  auto settings = EngineSettings::CreateDefault(
+      *model_assets, *backend_enum,
+      /*vision_backend=*/std::nullopt,
+      /*audio_backend=*/std::nullopt);
+  if (!settings.ok()) {
+    return settings.status();
+  }
+
+  if (!cache_dir.empty()) {
+    settings->GetMutableMainExecutorSettings().SetCacheDir(cache_dir);
+  }
+  if (!native_library_dir.empty()) {
+    PromoteUnityJniLibrarySymbols(native_library_dir);
+    settings->GetMutableMainExecutorSettings().SetLitertDispatchLibDir(
+        native_library_dir);
+  }
+  if (max_num_tokens > 0) {
+    settings->GetMutableMainExecutorSettings().SetMaxNumTokens(max_num_tokens);
+  }
+  if (max_num_images > 0) {
+    settings->GetMutableMainExecutorSettings().SetMaxNumImages(max_num_images);
+  }
+  if (cpu_threads > 0) {
+    auto cpu_config = settings->GetMutableMainExecutorSettings()
+                          .MutableBackendConfig<litert::lm::CpuConfig>();
+    if (cpu_config.ok()) {
+      auto config = *cpu_config;
+      config.number_of_threads = cpu_threads;
+      settings->GetMutableMainExecutorSettings().SetBackendConfig(config);
+    }
+  }
+  if (*backend_enum == litert::lm::Backend::GPU ||
+      enable_speculative_decoding) {
+    auto advanced_settings =
+        settings->GetMainExecutorSettings().GetAdvancedSettings().value_or(
+            litert::lm::AdvancedSettings());
+    if (*backend_enum == litert::lm::Backend::GPU) {
+      advanced_settings.allow_partial_gpu_delegation = true;
+    }
+    if (enable_speculative_decoding) {
+      advanced_settings.enable_speculative_decoding = true;
+    }
+    settings->GetMutableMainExecutorSettings().SetAdvancedSettings(
+        advanced_settings);
+  }
+
+  return EngineFactory::CreateAny(*settings);
+}
+
+absl::StatusOr<std::unique_ptr<Conversation>> CreateUnityBridgeConversation(
+    Engine* engine, const std::string& system_instruction) {
+  auto session_config = SessionConfig::CreateDefault();
+  if (engine->GetEngineSettings().GetAudioExecutorSettings().has_value()) {
+    session_config.SetAudioModalityEnabled(true);
+  }
+  if (engine->GetEngineSettings().GetVisionExecutorSettings().has_value()) {
+    session_config.SetVisionModalityEnabled(true);
+  }
+
+  JsonPreface json_preface;
+  json_preface.messages = nlohmann::ordered_json::array();
+  if (!system_instruction.empty()) {
+    json_preface.messages.push_back(
+        MakeTextMessageJson("system", system_instruction));
+  }
+
+  auto conversation_config = ConversationConfig::Builder()
+                                 .SetSessionConfig(session_config)
+                                 .SetPreface(json_preface)
+                                 .Build(*engine);
+  if (!conversation_config.ok()) {
+    return conversation_config.status();
+  }
+
+  return Conversation::Create(*engine, *conversation_config);
+}

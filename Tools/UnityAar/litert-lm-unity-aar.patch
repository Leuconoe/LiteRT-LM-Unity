+package com.google.ai.edge.litertlm.unity;
+
+public final class UnityLiteRtLmBridge implements AutoCloseable {
+  private long handle;
+
+  static {
+    System.loadLibrary("LiteRt");
+    System.loadLibrary("litertlm_jni");
+  }
+
+  public boolean isInitialized() {
+    return handle != 0;
+  }
+
+  public void initialize(
+      String modelPath,
+      String backend,
+      String cacheDir,
+      String nativeLibraryDir,
+      int maxNumTokens,
+      int maxNumImages,
+      int cpuThreads,
+      boolean enableSpeculativeDecoding,
+      String systemInstruction) {
+    initialize(
+        modelPath,
+        backend,
+        cacheDir,
+        nativeLibraryDir,
+        maxNumTokens,
+        maxNumImages,
+        cpuThreads,
+        enableSpeculativeDecoding,
+        systemInstruction,
+        "",
+        "");
+  }
+
+  public void initialize(
+      String modelPath,
+      String backend,
+      String cacheDir,
+      String nativeLibraryDir,
+      int maxNumTokens,
+      int maxNumImages,
+      int cpuThreads,
+      boolean enableSpeculativeDecoding,
+      String systemInstruction,
+      String visionBackend,
+      String audioBackend) {
+    close();
+    handle =
+        nativeCreateBridge(
+            modelPath,
+            backend,
+            cacheDir,
+            nativeLibraryDir,
+            maxNumTokens,
+            maxNumImages,
+            cpuThreads,
+            enableSpeculativeDecoding,
+            systemInstruction,
+            visionBackend,
+            audioBackend);
+  }
+
+  public String sendMessage(String text, String extraContextJson) {
+    return nativeSendMessage(handle, text);
+  }
+
+  public String sendMessageWithMedia(
+      String text,
+      byte[] imageBytes,
+      String imagePath,
+      String audioPath,
+      String extraContextJson) {
+    return nativeSendMessageWithMedia(
+        handle, text, imageBytes, imagePath, audioPath, extraContextJson);
+  }
+
+  public void resetConversation(String systemInstruction) {
+    nativeResetConversation(handle, systemInstruction);
+  }
+
+  public void setNativeMinLogSeverity(String severity) {
+    nativeSetMinLogSeverity(parseSeverity(severity));
+  }
+
+  public String runBenchmark(
+      String modelPath,
+      String backend,
+      String cacheDir,
+      String nativeLibraryDir,
+      int prefillTokens,
+      int decodeTokens,
+      boolean enableSpeculativeDecoding) {
+    return nativeRunBenchmark(
+        modelPath,
+        backend,
+        cacheDir,
+        nativeLibraryDir,
+        prefillTokens,
+        decodeTokens,
+        enableSpeculativeDecoding);
+  }
+
+  public String inspectLiteRtModel(String modelPath) {
+    return nativeInspectLiteRtModel(modelPath);
+  }
+
+  public String runParakeetAsrSmoke(
+      String modelPath, String audioPath, String tokenizerJsonPath, String backend) {
+    return nativeRunParakeetAsrSmoke(modelPath, audioPath, tokenizerJsonPath, backend);
+  }
+
+  public String runWhisperAsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language) {
+    return nativeRunWhisperAsrSmoke(modelPath, audioPath, tokenizerJsonPath, backend, language);
+  }
+
+  public String runQwen3AsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language) {
+    return nativeRunQwen3AsrSmoke(modelPath, audioPath, tokenizerJsonPath, backend, language);
+  }
+
+  @Override
+  public void close() {
+    if (handle != 0) {
+      nativeClose(handle);
+      handle = 0;
+    }
+  }
+
+  private static int parseSeverity(String severity) {
+    if (severity == null) {
+      return 0;
+    }
+    String normalized = severity.trim().toUpperCase();
+    if (normalized.equals("INFO")) {
+      return 0;
+    }
+    if (normalized.equals("WARNING") || normalized.equals("WARN")) {
+      return 1;
+    }
+    if (normalized.equals("ERROR")) {
+      return 2;
+    }
+    if (normalized.equals("FATAL")) {
+      return 3;
+    }
+    return 0;
+  }
+
+  private static native long nativeCreateBridge(
+      String modelPath,
+      String backend,
+      String cacheDir,
+      String nativeLibraryDir,
+      int maxNumTokens,
+      int maxNumImages,
+      int cpuThreads,
+      boolean enableSpeculativeDecoding,
+      String systemInstruction,
+      String visionBackend,
+      String audioBackend);
+
+  private static native String nativeSendMessage(long handle, String text);
+
+  private static native String nativeSendMessageWithMedia(
+      long handle,
+      String text,
+      byte[] imageBytes,
+      String imagePath,
+      String audioPath,
+      String extraContextJson);
+
+  private static native void nativeResetConversation(long handle, String systemInstruction);
+
+  private static native void nativeClose(long handle);
+
+  private static native void nativeSetMinLogSeverity(int severity);
+
+  private static native String nativeRunBenchmark(
+      String modelPath,
+      String backend,
+      String cacheDir,
+      String nativeLibraryDir,
+      int prefillTokens,
+      int decodeTokens,
+      boolean enableSpeculativeDecoding);
+
+  private static native String nativeInspectLiteRtModel(String modelPath);
+
+  private static native String nativeRunParakeetAsrSmoke(
+      String modelPath, String audioPath, String tokenizerJsonPath, String backend);
+
+  private static native String nativeRunWhisperAsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language);
+
+  private static native String nativeRunQwen3AsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language);
+}

+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeRunBenchmark(
+    JNIEnv* env, jclass thiz, jstring model_path, jstring backend,
+    jstring cache_dir, jstring native_library_dir, jint prefill_tokens,
+    jint decode_tokens, jboolean enable_speculative_decoding) {
+  const std::string model_path_str = JStringToStdString(env, model_path);
+  if (model_path_str.empty()) {
+    ThrowLiteRtLmJniException(env, "modelPath is required.");

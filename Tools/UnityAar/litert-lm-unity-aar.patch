+    return nativeRunParakeetAsrSmoke(modelPath, audioPath, tokenizerJsonPath, backend);
+  }
+
+  public String runWhisperAsrSmoke(
+      String modelPath,
+      String audioPath,
+      String tokenizerJsonPath,
+      String backend,
+      String language) {

    {"id": "m033", "suite": "ops", "text": "적 증원 확인, 전술 추천 한번 돌려 봐", "function": "RequestTacticsRecommendation", "arguments": {}},
    {"id": "m034", "suite": "ops", "text": "그냥 직접 짤게, 전술 추천 취소해", "function": "CancelTacticsRecommendation", "arguments": {}},
    {"id": "m035", "suite": "ops", "text": "뭔가 떴다, 알림 상세 호출해 봐", "function": "OpenWindow", "arguments": {"windowName": "알림 상세"}},

+LITERTLM_JNIEXPORT jlong JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeCreateBridge(
+    JNIEnv* env, jclass thiz, jstring model_path, jstring backend,
+    jstring cache_dir, jstring native_library_dir, jint max_num_tokens,
+    jint max_num_images, jint cpu_threads, jboolean enable_speculative_decoding,
+    jstring system_instruction) {
+  const std::string model_path_str = JStringToStdString(env, model_path);
+  if (model_path_str.empty()) {
+    ThrowLiteRtLmJniException(env, "modelPath is required.");
+    return 0;
+  }
+
+  struct stat buffer;
+  if (stat(model_path_str.c_str(), &buffer) != 0) {
+    ThrowLiteRtLmJniException(env, "Model file not found: " + model_path_str);
+    return 0;
+  }
+
+  auto engine = CreateUnityBridgeEngine(
+      model_path_str, JStringToStdString(env, backend),
+      JStringToStdString(env, cache_dir),
+      JStringToStdString(env, native_library_dir), max_num_tokens,
+      max_num_images, cpu_threads,
+      enable_speculative_decoding == JNI_TRUE);
+  if (!engine.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to create engine: " + engine.status().ToString());
+    return 0;
+  }
+
+  const std::string system_instruction_str =
+      JStringToStdString(env, system_instruction);
+  auto conversation =
+      CreateUnityBridgeConversation(engine->get(), system_instruction_str);
+  if (!conversation.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to create conversation: " + conversation.status().ToString());
+    return 0;
+  }
+
+  auto context = std::make_unique<UnityBridgeContext>();
+  context->engine = std::move(*engine);
+  context->conversation = std::move(*conversation);
+  context->system_instruction = system_instruction_str;
+  return reinterpret_cast<jlong>(context.release());
+}
+
+LITERTLM_JNIEXPORT jstring JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeSendMessage(
+    JNIEnv* env, jclass thiz, jlong bridge_pointer, jstring text) {
+  auto* context = reinterpret_cast<UnityBridgeContext*>(bridge_pointer);
+  if (context == nullptr || context->conversation == nullptr) {
+    ThrowLiteRtLmJniException(env, "Unity bridge is not initialized.");
+    return nullptr;
+  }
+
+  auto response = context->conversation->SendMessage(
+      MakeTextMessageJson("user", JStringToStdString(env, text)));
+  if (!response.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to send message: " + response.status().ToString());
+    return nullptr;
+  }
+
+  return NewStringStandardUTF(env, ExtractTextFromMessageJson(*response));
+}
+
+LITERTLM_JNIEXPORT void JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeResetConversation(
+    JNIEnv* env, jclass thiz, jlong bridge_pointer, jstring system_instruction) {
+  auto* context = reinterpret_cast<UnityBridgeContext*>(bridge_pointer);
+  if (context == nullptr || context->engine == nullptr) {
+    ThrowLiteRtLmJniException(env, "Unity bridge is not initialized.");
+    return;
+  }
+
+  context->system_instruction = JStringToStdString(env, system_instruction);
+  context->conversation.reset();
+  auto conversation =
+      CreateUnityBridgeConversation(context->engine.get(), context->system_instruction);
+  if (!conversation.ok()) {
+    ThrowLiteRtLmJniException(
+        env, "Failed to reset conversation: " + conversation.status().ToString());
+    return;
+  }
+
+  context->conversation = std::move(*conversation);
+}
+
+LITERTLM_JNIEXPORT void JNICALL
+Java_com_google_ai_edge_litertlm_unity_UnityLiteRtLmBridge_nativeClose(

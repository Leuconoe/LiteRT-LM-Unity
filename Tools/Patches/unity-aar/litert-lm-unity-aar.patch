+std::string FormatBenchmarkInfo(
+    const litert::lm::BenchmarkInfo& benchmark_info) {
+  int last_prefill_token_count = 0;
+  double last_prefill_tokens_per_second = 0.0;
+  if (benchmark_info.GetTotalPrefillTurns() > 0) {
+    auto turn = benchmark_info.GetPrefillTurn(
+        benchmark_info.GetTotalPrefillTurns() - 1);
+    if (turn.ok()) {
+      last_prefill_token_count = turn->num_tokens;
+    }
+    last_prefill_tokens_per_second = benchmark_info.GetPrefillTokensPerSec(
+        benchmark_info.GetTotalPrefillTurns() - 1);
+  }
+
+  int last_decode_token_count = 0;
+  double last_decode_tokens_per_second = 0.0;
+  if (benchmark_info.GetTotalDecodeTurns() > 0) {
+    auto turn =
+        benchmark_info.GetDecodeTurn(benchmark_info.GetTotalDecodeTurns() - 1);
+    if (turn.ok()) {
+      last_decode_token_count = turn->num_tokens;
+    }
+    last_decode_tokens_per_second = benchmark_info.GetDecodeTokensPerSec(
+        benchmark_info.GetTotalDecodeTurns() - 1);
+  }
+
+  double total_init_time_ms = 0.0;
+  for (const auto& phase : benchmark_info.GetInitPhases()) {
+    total_init_time_ms += absl::ToDoubleMilliseconds(phase.second);
+  }
+
+  std::ostringstream stream;
+  stream << "BenchmarkInfo:\n";
+  stream << "  Init Total: " << total_init_time_ms << " ms\n";
+  stream << "  Time to first token: "
+         << benchmark_info.GetTimeToFirstToken() << " s\n";
+  stream << "  Last Prefill: " << last_prefill_token_count
+         << " tokens, " << last_prefill_tokens_per_second
+         << " tokens/sec\n";
+  stream << "  Last Decode: " << last_decode_token_count
+         << " tokens, " << last_decode_tokens_per_second
+         << " tokens/sec";
+  return stream.str();
+}
